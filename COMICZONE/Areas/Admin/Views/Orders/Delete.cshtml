@using COMICZONE.Extensions;
@model COMICZONE.Models.Order

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa đơn hàng";

    var statusText = new Dictionary<string, string>
    {
        { "Pending", "Chờ xử lý" },
        { "Completed", "Hoàn thành" },
        { "Cancelled", "Đã hủy" }
    };
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="text-danger mb-1">
                <i class="ti ti-trash"></i>
                Xóa đơn hàng #@Model.OrderId
            </h4>

            <span class="badge
                @(Model.Status == "Pending" ? "bg-warning text-dark" :
                    Model.Status == "Completed" ? "bg-success" :
                    Model.Status == "Cancelled" ? "bg-danger" :
                    "bg-secondary")">

                @(statusText.ContainsKey(Model.Status ?? "")
                    ? statusText[Model.Status ?? ""]
                    : Model.Status)
            </span>
        </div>

        <a asp-action="Index" class="btn btn-light">
            <i class="ti ti-arrow-left"></i>
            Quay lại
        </a>
    </div>


    <div class="row">
        <!-- LEFT -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="ti ti-info-circle"></i>
                        Thông tin đơn hàng
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">
                            Ngày đặt
                        </div>
                        <div class="col-md-8">
                            @Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">
                            Địa chỉ giao hàng
                        </div>
                        <div class="col-md-8">
                            @Model.ShippingAddress
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">
                            Số điện thoại
                        </div>
                        <div class="col-md-8">
                            @Model.PhoneNumber
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 text-muted">
                            Ghi chú
                        </div>
                        <div class="col-md-8">
                            @(Model.Note ?? "Không có")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT -->
        <div class="col-lg-4">
            <!-- CUSTOMER -->
            <!-- ẩn dates + note -->
            <partial name="_CustomerInfo"
                model="Model"
                view-data='new ViewDataDictionary(ViewData)
                    {
                        { "ShowNote", false },
                        { "ShowDates", false }
                    }' />

            <!-- DELETE CONFIRM -->
            <div class="card shadow-sm border-0 border-danger">
                <div class="card-body text-center">
                    <p class="text-danger fw-semibold mb-3">
                        Bạn có chắc muốn xóa đơn hàng này?
                    </p>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="OrderId" />

                        <button type="submit"
                                class="btn btn-danger w-100 mb-2">
                            <i class="ti ti-trash"></i>
                            Xóa đơn hàng
                        </button>
                    </form>

                    <a asp-action="Index"
                       class="btn btn-light w-100">
                        Hủy
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>