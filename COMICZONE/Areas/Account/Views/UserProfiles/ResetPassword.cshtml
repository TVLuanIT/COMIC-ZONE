@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="auth-section">
    <div class="auth-glass-card" data-aos="zoom-in">
        <div class="text-center mb-4">
            <h2 class="auth-title">ĐẶT LẠI MẬT KHẨU</h2>
            <p class="auth-subtitle">Nhập mật khẩu mới để tiếp tục truy cập ComicZone</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert border-0 rounded-4 mb-4 py-3 animate__animated animate__shakeX" 
                 style="background: rgba(239, 68, 68, 0.15); color: #ef4444; backdrop-filter: blur(10px);">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-circle-fill fs-5 me-3"></i>
                    <span class="fw-bold">@TempData["Error"]</span>
                </div>
            </div>
        }

        <form asp-action="ResetPassword" asp-controller="UserProfiles" method="post">
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <div class="auth-input-group">
                <i class="bi bi-lock-fill"></i>
                <input type="password" 
                       name="newPassword" 
                       class="auth-input" 
                       placeholder="Mật khẩu mới" 
                       required />
            </div>

            <div class="auth-input-group mb-4">
                <i class="bi bi-shield-lock-fill"></i>
                <input type="password" 
                       name="confirmPassword" 
                       class="auth-input" 
                       placeholder="Xác nhận mật khẩu" 
                       required />
            </div>

            <button type="submit" class="btn-auth-premium">
                XÁC NHẬN THAY ĐỔI <i class="bi bi-check-circle ms-2"></i>
            </button>
        </form>

        <div class="auth-footer-text mt-4 pt-2">
            Quay lại <a asp-controller="Home" asp-action="Index" class="auth-link">Trang chủ ComicZone</a>
        </div>
    </div>
</section>