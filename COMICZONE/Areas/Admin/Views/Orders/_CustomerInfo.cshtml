@model COMICZONE.Models.Order

@{
    var showNote = ViewData["ShowNote"] as bool? ?? true;
    var showDates = ViewData["ShowDates"] as bool? ?? true;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">
            <i class="ti ti-user"></i>
            Khách hàng
        </h5>
    </div>

    <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
            <strong>Họ và tên</strong>
            <span>
                @(Model.User?.Username ?? "Không có")
            </span>
        </div>

        <div class="d-flex justify-content-between mb-2">
            <strong>Số điện thoại</strong>
            <span>
                @(Model.PhoneNumber ?? "Không có")
            </span>
        </div>

        <div class="mb-3">
            <strong>Địa chỉ</strong>
            <div class="mt-1">
                @(Model.ShippingAddress ?? "Không có")
            </div>
        </div>

        @if (showNote)
        {
            <div>
                <strong>Ghi chú</strong>
                <div class="mt-1">
                    @(Model.Note ?? "Không có")
                </div>
            </div>
        }

        @if (showDates)
        {
            <hr />

            <div class="d-flex justify-content-between small mb-2">
                <span class="fw-bold">Ngày đặt</span>
                <span>@Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")</span>
            </div>

            <div class="d-flex justify-content-between small">
                <span class="fw-bold">Ngày tạo</span>
                <span>@Model.CreatedAt?.ToString("dd/MM/yyyy")</span>
            </div>
        }
    </div>
</div>