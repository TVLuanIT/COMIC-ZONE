@model IEnumerable<COMICZONE.Models.ProductReview>
@{
    var productId = ViewBag.ProductId;
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;

    // Lấy user hiện tại
    var UserIdStr = Context.Session.GetString("UserId");
    var UserRoleStr = Context.Session.GetString("UserRole");
    int UserId = string.IsNullOrEmpty(UserIdStr) ? 0 : int.Parse(UserIdStr);
    string UserRole = string.IsNullOrEmpty(UserRoleStr) ? "User" : UserRoleStr;
}

<div class="review-list-section">
    <h4 class="review-list-title">Đánh giá từ khách hàng</h4>

    @if (!Model.Any())
    {
        <div class="no-review">Chưa có đánh giá nào cho sản phẩm này.</div>
    }
    else
    {
        @foreach (var review in Model)
        {
            // Kiểm tra user đã like chưa
            bool liked = UserId != 0 && review.ProductReviewLikes.Any(l => l.Userid == UserId);
            int likeCount = review.ProductReviewLikes.Count;

            <div class="review-card mb-3">
                <div class="review-header d-flex justify-content-between">
                    <div class="d-flex">
                        <div class="review-avatar me-2">
                            @if (!string.IsNullOrEmpty(review.User?.Avatar))
                            {
                                <img src="@review.User.Avatar" alt="Avatar" class="avatar-img rounded-circle" />
                            }
                            else
                            {
                                @(review.User?.Username?.Substring(0, 1).ToUpper() ?? "U")
                            }
                    </div>
                    <div>
                        <div class="review-username">
                            @(
                                                    string.IsNullOrWhiteSpace(review.User?.Username)
                                                    ? "Người dùng ẩn danh"
                                                    : char.ToUpper(review.User.Username[0]) + review.User.Username.Substring(1)
                                                    )
                        </div>
                        <div class="review-date">
                        @{
                                    string timeAgo = "-";
                                    if (review.Createdat.HasValue)
                                    {
                                        var diff = DateTime.Now - review.Createdat.Value;
                                        if (diff.TotalMinutes < 1)
                                            timeAgo = "Vừa xong";
                                        else if (diff.TotalHours < 1)
                                            timeAgo = $"{(int)diff.TotalMinutes} phút trước";
                                        else if (diff.TotalDays < 1)
                                            timeAgo = $"{(int)diff.TotalHours} giờ trước";
                                        else
                                            timeAgo = review.Createdat.Value.ToString("dd/MM/yyyy");
                                    }
                                }
                                @timeAgo
                            </div>
                        </div>
                    </div>

                    <!-- Menu 3 chấm -->
                    <div class="dropdown">
                        <button class="btn btn-sm" type="button" id="menu-@review.Reviewid"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            &hellip;
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menu-@review.Reviewid">
                            @if (review.Userid == UserId)
                            {
                                <li><a class="dropdown-item edit-review" href="#" data-id="@review.Reviewid">Sửa</a></li>
                                <li><a class="dropdown-item delete-review" href="#" data-id="@review.Reviewid">Xóa</a></li>
                            }
                            else if (UserRole == "Admin")
                            {
                                <li><a class="dropdown-item delete-review" href="#" data-id="@review.Reviewid">Xóa</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item report-review" href="#" data-id="@review.Reviewid">Báo cáo vi phạm</a></li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="review-stars mt-1 mb-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="star @(i <= review.Rating ? "filled" : "")">&#9733;</span>
                    }
            </div>

            <div class="review-content mb-2">
                @(string.IsNullOrWhiteSpace(review.Reviewcontent)
                            ? "<em class='text-muted'>Người dùng chưa viết nội dung</em>"
                            : review.Reviewcontent)
        </div>

                <div class="review-like d-flex gap-2">
                    <!-- Nút Like -->
                    <button class="btn btn-sm btn-outline-primary review-like-btn @(liked ? "liked" : "")"
                            data-id="@review.Reviewid"
                            data-userid="@UserId">
                        👍 Like (<span class="like-count">@likeCount</span>)
                    </button>

                    <!-- Nút Dislike (chỉ hiển thị, không có chức năng server) -->
                    <button class="btn btn-sm btn-outline-secondary review-dislike-btn">
                        👎 Dislike
                    </button>
                </div>
            </div>
        }
    }

    @* PHÂN TRANG *@
    @if (totalPages > 1)
    {
        <nav aria-label="Review pagination">
            <ul class="pagination justify-content-center mt-3">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link review-page-link" href="#" data-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>