@model COMICZONE.Models.ViolationReport
@using COMICZONE.Models.Enums

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa báo cáo";

    var review = ViewBag.ReportedItem as COMICZONE.Models.ProductReview;
    var reply = ViewBag.ReportedItem as COMICZONE.Models.ProductReviewReply;
    var blogComment = ViewBag.ReportedItem as COMICZONE.Models.BlogComment;
    var blogReply = ViewBag.ReportedItem as COMICZONE.Models.BlogCommentReply;
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <!-- Header -->
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">⚠️ Xác nhận xóa báo cáo #@Model.Id</h5>
            <a asp-action="Index" class="btn btn-light btn-sm">⬅ Quay lại</a>
        </div>

        <!-- Body -->
        <div class="card-body">
            <!-- Warning -->
            <div class="alert alert-danger">
                Bạn có chắc chắn muốn xóa báo cáo này không? Hành động này có thể không hoàn tác được.
            </div>

            <div class="row g-4">
                <!-- Loại -->
                <div class="col-md-6">
                    <label class="text-muted small">Loại báo cáo</label><br />

                    <span class="badge rounded-pill px-3 py-2 fw-semibold
                        @(Model.ReportTypeEnum == ReportType.Review ? "bg-primary-subtle text-primary border border-primary-subtle" :
                          Model.ReportTypeEnum == ReportType.Reply ? "bg-success-subtle text-success border border-success-subtle" :
                          Model.ReportTypeEnum == ReportType.BlogComment ? "bg-warning-subtle text-warning border border-warning-subtle" :
                          "bg-info-subtle text-info border border-info-subtle")">

                        @Model.ReportTypeEnum.GetDisplayName()
                    </span>
                </div>

                <!-- Trạng thái -->
                <div class="col-md-6">
                    <label class="text-muted small">Trạng thái</label><br />

                    <span class="badge rounded-pill px-3 py-2 fw-semibold
                        @(Model.StatusEnum == ReportStatus.Pending ? "bg-warning-subtle text-warning" :
                            Model.StatusEnum == ReportStatus.Approved ? "bg-success-subtle text-success" :
                            "bg-danger-subtle text-danger")">

                        @Model.StatusEnum.GetDisplayName()
                    </span>
                </div>

                <!-- Đã xóa -->
                <div class="col-md-6">
                    <label class="text-muted small">Trạng thái dữ liệu</label><br />

                    @if (Model.Isdeleted)
                    {
                        <span class="badge bg-danger-subtle text-danger px-3 py-2">Đã xóa</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success px-3 py-2">Còn</span>
                    }
                </div>

                <!-- Ngày -->
                <div class="col-md-6">
                    <label class="text-muted small">Ngày gửi</label><br />
                    <span>@Model.Createdat.ToString("dd/MM/yyyy HH:mm")</span>
                </div>

                <!-- Nội dung bị báo cáo -->
                <div class="col-12">
                    <div class="p-4 border rounded-4 bg-light shadow-sm">
                        <label class="text-muted small d-block mb-3 fw-bold text-uppercase">
                                                @if (Model.ReportTypeEnum == ReportType.Review)
                        {
                            if (review != null)
                            {
                                <div class="row">
                                    <div class="col-md-4 border-end">
                                        <p class="mb-1 text-muted small">Sản phẩm:</p>
                                        <h6 class="fw-bold">@Html.Raw(review.Product?.GetProductCell())</h6>
                                        <p class="mb-1 text-muted small mt-3">Tác giả đánh giá:</p>
                                        <h6 class="fw-bold">@review.User?.Username</h6>
                                        <p class="mb-1 text-muted small mt-3">Đánh giá:</p>
                                        <div>
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="ti ti-star@(i <= review.Rating ? "-filled text-warning" : " text-muted")"></i>
                                            }
                                            <span class="ms-1 fw-bold">(@review.Rating/5)</span>
                                        </div>
                                    </div>
                                    <div class="col-md-8 ps-md-4">
                                        <p class="mb-1 text-muted small">Nội dung đánh giá:</p>
                                        <div class="fst-italic text-dark bg-white p-3 rounded-3 border">"@review.Reviewcontent"</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0"><i class="ti ti-alert-triangle"></i> Nội dung đánh giá này đã bị xóa khỏi hệ thống.</div>
                            }
                        }
                        else if (Model.ReportTypeEnum == ReportType.Reply)
                        {
                            if (reply != null)
                            {
                                <div class="row">
                                    <div class="col-md-4 border-end">
                                        <p class="mb-1 text-muted small">Sản phẩm:</p>
                                        <h6 class="fw-bold">@Html.Raw(reply.Review?.Product?.GetProductCell())</h6>
                                        <p class="mb-1 text-muted small mt-3">Tác giả phản hồi:</p>
                                        <h6 class="fw-bold">@reply.User?.Username</h6>
                                        <p class="mb-1 text-muted small mt-3">Phản hồi cho:</p>
                                        <h6 class="text-primary">@reply.Review?.User?.Username</h6>
                                    </div>
                                    <div class="col-md-8 ps-md-4">
                                        <p class="mb-1 text-muted small">Nội dung phản hồi:</p>
                                        <div class="fst-italic text-dark bg-white p-3 rounded-3 border">"@reply.Replycontent"</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0"><i class="ti ti-alert-triangle"></i> Nội dung phản hồi này đã bị xóa khỏi hệ thống.</div>
                            }
                        }
                        else if (Model.ReportTypeEnum == ReportType.BlogComment)
                        {
                            if (blogComment != null)
                            {
                                <div class="row">
                                    <div class="col-md-4 border-end">
                                        <p class="mb-1 text-muted small">Bài viết Blog:</p>
                                        <h6 class="fw-bold text-primary">@blogComment.Blog?.Title</h6>
                                        <p class="mb-1 text-muted small mt-3">Tác giả bình luận:</p>
                                        <h6 class="fw-bold">@blogComment.User?.Username</h6>
                                    </div>
                                    <div class="col-md-8 ps-md-4">
                                        <p class="mb-1 text-muted small">Nội dung bình luận:</p>
                                        <div class="fst-italic text-dark bg-white p-3 rounded-3 border">"@blogComment.Content"</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0"><i class="ti ti-alert-triangle"></i> Nội dung bình luận đã bị xóa.</div>
                            }
                        }
                        else if (Model.ReportTypeEnum == ReportType.BlogCommentReply)
                        {
                            if (blogReply != null)
                            {
                                <div class="row">
                                    <div class="col-md-4 border-end">
                                        <p class="mb-1 text-muted small">Bài viết Blog:</p>
                                        <h6 class="fw-bold text-primary">@blogReply.Comment?.Blog?.Title</h6>
                                        <p class="mb-1 text-muted small mt-3">Tác giả phản hồi:</p>
                                        <h6 class="fw-bold">@blogReply.User?.Username</h6>
                                        <p class="mb-1 text-muted small mt-3">Phản hồi cho:</p>
                                        <h6 class="text-info">@blogReply.Replytouser?.Username</h6>
                                    </div>
                                    <div class="col-md-8 ps-md-4">
                                        <p class="mb-1 text-muted small">Nội dung phản hồi:</p>
                                        <div class="fst-italic text-dark bg-white p-3 rounded-3 border">"@blogReply.Content"</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0"><i class="ti ti-alert-triangle"></i> Nội dung phản hồi đã bị xóa.</div>
                            }
                        }
                    </div>
                </div>

                <!-- Lý do -->
                <div class="col-12">
                    <label class="text-muted small">Lý do</label>

                    <div class="p-3 border rounded-3 bg-light mt-1">
                        @Model.Reason
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="card-footer text-end bg-white">
            <form asp-action="Delete" class="d-inline">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                <button type="submit" class="btn btn-danger">
                    🗑 Xóa
                </button>
            </form>
        </div>
    </div>
</div>