@{
    ViewData["Title"] = "Trang chủ";

    // Lấy dữ liệu sản phẩm từ ViewBag
    var ModelLatest = ViewBag.ModelLatest as IEnumerable<COMICZONE.Models.Product>;
	var ModelRecommended = ViewBag.ModelRecommended as IEnumerable<COMICZONE.Models.Product>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<!-- HERO SECTION -->
<div class="modern-hero">
    <div id="homeBannerCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="images/banner1.jpeg" alt="banner">
            </div>
            <div class="carousel-item">
                <img src="images/banner2.jpeg" alt="banner">
            </div>
            <div class="carousel-item">
                <img src="images/banner3.jpeg" alt="banner">
            </div>
            <div class="carousel-item">
                <img src="images/banner4.png" alt="banner">
            </div>
        </div>
    </div>

    <div class="hero-overlay">
        <div class="container">
            <div class="hero-content text-white" data-aos="fade-right">
                <span class="hero-badge">Chào mừng đến với ComicZone</span>
                <h1 class="hero-title">Thế Giới Truyện Tranh <br><span class="text-danger">Trong Tầm Tay</span></h1>
                <p class="hero-subtitle">Khám phá hàng ngàn tựa truyện hấp dẫn từ những mangaka hàng đầu thế giới. Cập nhật liên tục, bản in sắc nét.</p>
                <div class="d-flex gap-3">
                    <a asp-controller="Products" asp-action="Index" class="btn-premium-pill">
                        Khám Phá Ngay <i class="bi bi-arrow-right"></i>
                    </a>
                    <a asp-controller="Home" asp-action="About" class="btn-premium-pill-outline">
                        Về Chúng Tôi <i class="bi bi-info-circle"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FEATURES BAR -->
<div class="container">
    <div class="features-bar d-flex flex-wrap justify-content-around" data-aos="fade-up" data-aos-delay="200">
        <div class="feature-item">
            <div class="feature-icon"><i class="bi bi-truck"></i></div>
            <div class="feature-text">
                <h6>Giao Hàng Siêu Tốc</h6>
                <p>Nội thành trong 2h</p>
            </div>
        </div>
        <div class="feature-item">
            <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
            <div class="feature-text">
                <h6>100% Bản Quyền</h6>
                <p>Nói không với truyện lậu</p>
            </div>
        </div>
        <div class="feature-item">
            <div class="feature-icon"><i class="bi bi-wallet2"></i></div>
            <div class="feature-text">
                <h6>Thanh Toán Tiện Lợi</h6>
                <p>Palpal, VNPay, COD</p>
            </div>
        </div>
        <div class="feature-item">
            <div class="feature-icon"><i class="bi bi-headset"></i></div>
            <div class="feature-text">
                <h6>Hỗ Trợ 24/7</h6>
                <p>Luôn lắng nghe bạn</p>
            </div>
        </div>
    </div>
</div>

<!-- GỢI Ý CHO BẠN -->
@if (ViewBag.ModelRecommended != null)
{
    ViewBag.SectionTitle = "Gợi Ý Cho Bạn";
    ViewBag.SectionIcon = "bi-heart";
    ViewBag.CarouselId = "recommendSwiper";
    ViewBag.ViewMoreLink = Url.Action("Index", "Products");
    ViewBag.SectionDescription = "Những tựa truyện phù hợp với sở thích của bạn.";
    ViewBag.BackgroundClass = "bg-light";

    <div data-aos="fade-up">
        @await Html.PartialAsync("_HomeProduct.cshtml", (IEnumerable<COMICZONE.Models.Product>)ViewBag.ModelRecommended)
    </div>
}

<!-- KHÁM PHÁ THEO THỂ LOẠI -->
@if (ViewBag.PopularTags != null)
{
    <section class="py-5 overflow-hidden">
        <div class="container">
            <div class="section-title-modern text-center mb-5">
                <h2 data-aos="fade-up">
                    <i class="bi bi-grid me-2"></i>Khám Phá Theo Thể Loại
                </h2>
                <p data-aos="fade-up" data-aos-delay="100">Tìm kiếm những câu chuyện tuyệt vời theo phong cách bạn yêu thích.</p>
            </div>
            
            <div class="row g-4 justify-content-center">
                @foreach (var tag in (IEnumerable<COMICZONE.Models.Tag>)ViewBag.PopularTags)
                {
                    <div class="col-6 col-md-4 col-lg-3" data-aos="zoom-in" data-aos-delay="100">
                        <a asp-controller="Products" asp-action="Index" asp-route-tagId="@tag.Id" class="genre-item">
                            <div class="genre-icon">
                                @{
                                    var icon = "bi-bookmark-star";
                                    var tagLower = tag.Name?.ToLower();
                                    if (tagLower != null) {
                                        if (tagLower.Contains("hành động") || tagLower.Contains("action")) icon = "bi-lightning-charge";
                                        else if (tagLower.Contains("lãng mạn") || tagLower.Contains("romance")) icon = "bi-heart-fill";
                                        else if (tagLower.Contains("kinh dị") || tagLower.Contains("horror")) icon = "bi-ghost";
                                        else if (tagLower.Contains("hài hước") || tagLower.Contains("comedy")) icon = "bi-emoji-laughing";
                                        else if (tagLower.Contains("phiêu lưu") || tagLower.Contains("adventure")) icon = "bi-compass";
                                    }
                                }
                                <i class="bi @icon"></i>
                            </div>
                            <span class="genre-name">@tag.Name</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- MỚI NHẤT TRONG TUẦN -->
@{
    ViewBag.SectionTitle = "Mới Nhất Trong Tuần";
    ViewBag.SectionIcon = "bi-fire";
    ViewBag.CarouselId = "latestSwiper";
    ViewBag.ViewMoreLink = Url.Action("Index", "Products");
    ViewBag.SectionDescription = "Cập nhật mới mỗi ngày, không bỏ lỡ bất kỳ chương nào.";
    ViewBag.BackgroundClass = "bg-light"; 
}
<div data-aos="fade-up">
    @await Html.PartialAsync("_HomeProduct.cshtml", ModelLatest)
</div>

<!-- THÔNG SỐ ẤN TƯỢNG (STATS) -->
<section class="container" data-aos="fade-up">
    <div class="stats-section">
        <div class="row g-4">
            <div class="col-md-4 stat-item">
                <div class="stat-icon-premium"><i class="bi bi-journal-bookmark-fill"></i></div>
                <h3>@ViewBag.TotalProducts+</h3>
                <p>Tựa Truyện</p>
            </div>
            <div class="col-md-4 stat-item">
                <div class="stat-icon-premium"><i class="bi bi-palette-fill"></i></div>
                <h3>@ViewBag.TotalArtists+</h3>
                <p>Nghệ Sĩ</p>
            </div>
            <div class="col-md-4 stat-item">
                <div class="stat-icon-premium"><i class="bi bi-people-fill"></i></div>
                <h3>@ViewBag.TotalUsers+</h3>
                <p>Độc Giả</p>
            </div>
        </div>
    </div>
</section>


<!-- BLOG -->
<div data-aos="fade-up">
    @await Html.PartialAsync("_HomeBlog.cshtml", (IEnumerable<COMICZONE.Models.Blog>)ViewBag.Blogs)
</div>