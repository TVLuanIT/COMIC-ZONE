@model COMICZONE.Areas.Admin.ViewModels.MarketplacePostPromotionSearchModel
@using System.Linq

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Lịch sử mua quảng cáo";
    var promotions = ViewBag.Promotions as List<COMICZONE.Models.MarketplacePostPromotion> ?? new();
}

<div class="container-fluid">
    <!-- Breadcrumb & Title -->
    <div class="row page-titles mb-4">
        <div class="col-md-7 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-5 align-self-center text-end">
            <ol class="breadcrumb justify-content-end mb-0 px-0 bg-transparent">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item">Marketplace</li>
                <li class="breadcrumb-item active">Lịch sử quảng cáo</li>
            </ol>
        </div>
    </div>

    <!-- Search Form -->
    <partial name="_PromotionSearchForm" model="Model" />

    <!-- Table -->
    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase small fw-bold">
                        <tr class="align-middle">
                            <th class="ps-4">@Html.SortHeader("ID", "id", Model.SortColumn, Model.IsAscending)</th>
                            <th>@Html.SortHeader("Bài đăng", "post", Model.SortColumn, Model.IsAscending)</th>
                            <th>@Html.SortHeader("Của User", "user", Model.SortColumn, Model.IsAscending)</th>
                            <th class="text-end">@Html.SortHeader("Giá", "price", Model.SortColumn, Model.IsAscending)</th>
                            <th class="text-center">@Html.SortHeader("Phương thức", "type", Model.SortColumn, Model.IsAscending)</th>
                            <th class="text-center">@Html.SortHeader("Từ ngày", "startdate", Model.SortColumn, Model.IsAscending)</th>
                            <th class="text-center">@Html.SortHeader("Đến ngày", "enddate", Model.SortColumn, Model.IsAscending)</th>
                            <th class="text-center">@Html.SortHeader("Ngày mua", "createdat", Model.SortColumn, Model.IsAscending)</th>
                            <th class="text-center">@Html.SortHeader("Trạng thái", "status", Model.SortColumn, Model.IsAscending)</th>
                            <th class="text-center">Hiển thị</th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (promotions.Any())
                        {
                            @foreach (var item in promotions)
                            {
                                <tr class="@(item.Isdeleted ? "bg-light text-muted opacity-75" : "")">
                                    <td class="ps-4 fw-bold">#@item.Id</td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <a asp-controller="MarketplacePosts" asp-action="Details" asp-route-id="@item.Postid" class="text-primary text-decoration-none fw-semibold d-inline-block text-truncate" style="max-width:200px;" title="@item.Post?.Title">@item.Post?.Title</a>
                                            <small class="text-muted">ID Bài: #@item.Postid</small>
                                        </div>
                                    </td>
                                    <td>@item.User?.Username</td>
                                    <td class="fw-semibold text-end text-success">@((item.Price ?? 0).ToString("N0"))đ</td>
                                    <td class="text-center">
                                        @{
                                            var typeBadge = item.PromotionType switch {
                                                "ADMIN_GIFT" => "bg-primary-subtle text-primary border border-primary-subtle",
                                                "VNPay" => "bg-info-subtle text-info border border-info-subtle",
                                                "PayPal" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
                                                _ => "bg-light text-dark"
                                            };
                                        }
                                        <span class="badge @typeBadge">@item.PromotionType</span>
                                    </td>
                                    <td class="text-center small">@(item.StartDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                    <td class="text-center small">@(item.EndDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                    <td class="text-center small text-muted">@(item.CreatedAt?.ToString("dd/MM/yy HH:mm"))</td>
                                    <td class="text-center">
                                        @{
                                            var statusBadge = item.Status switch {
                                                "Active" => "bg-success-subtle text-success border border-success-subtle",
                                                "Pending" => "bg-warning-subtle text-warning border border-warning-subtle",
                                                "Completed" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
                                                "Cancelled" => "bg-danger-subtle text-danger border border-danger-subtle",
                                                _ => "bg-light text-dark"
                                            };
                                            var activeText = item.Status;
                                            // Handle dynamically changing text to Completed if past EndDate but status still Active (for visual appeal)
                                            if (item.Status == "Active" && item.EndDate.HasValue && item.EndDate.Value < DateTime.Now)
                                            {
                                                statusBadge = "bg-secondary-subtle text-secondary border border-secondary-subtle";
                                                activeText = "Completed";
                                            }
                                        }
                                        <span class="badge @statusBadge rounded-pill">@activeText</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Isdeleted)
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Đã ẩn</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success">Công khai</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="d-flex gap-1 justify-content-center">
                                            @if (item.Status == "Active" && (!item.EndDate.HasValue || item.EndDate.Value > DateTime.Now))
                                            {
                                                <button class="btn btn-sm btn-outline-warning btn-cancel-promotion" data-id="@item.Id" title="Hủy gói quảng cáo này"><i class="ti ti-x"></i></button>
                                            }
                                            @if (item.Status == "Cancelled")
                                            {
                                                <button class="btn btn-sm btn-outline-success btn-restore-promotion" data-id="@item.Id" title="Khôi phục gói quảng cáo"><i class="ti ti-refresh"></i></button>
                                            }
                                            <button class="btn btn-sm btn-outline-secondary btn-toggle-delete" data-id="@item.Id"
                                                    title="@(item.Isdeleted ? "Hiển thị lại" : "Tạm ẩn")">
                                                <i class="ti ti-@(item.Isdeleted ? "eye" : "eye-off")"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger btn-delete-promotion" data-id="@item.Id" title="Xóa vĩnh viễn"><i class="ti ti-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="10" class="text-center py-5 text-muted"><i class="ti ti-mood-empty fs-1 d-block mb-2"></i>Không có giao dịch quảng cáo nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top-0 py-3">
                <partial name="~/Areas/Admin/Views/Shared/_AdminPagination.cshtml" model="Model" />
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Cancel Promotion
            $('.btn-cancel-promotion').click(function () {
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Hủy quảng cáo của user?',
                    text: "Quảng cáo hiện tại sẽ ngay lập tức bị vô hiệu hóa.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ffc107',
                    cancelButtonColor: '#secondary',
                    confirmButtonText: 'Đồng ý hủy',
                    cancelButtonText: 'Bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("Cancel")', { id: id }, function (res) {
                            if (res.success) {
                                Swal.fire('Thành công!', res.message, 'success').then(() => location.reload());
                            } else {
                                Swal.fire('Lỗi!', res.message, 'error');
                            }
                        });
                    }
                });
            });

            // Restore Promotion
            $('.btn-restore-promotion').click(function () {
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Khôi phục quảng cáo?',
                    text: "Gói quảng cáo này sẽ được kích hoạt trở lại trạng thái Active.",
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#secondary',
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("Restore")', { id: id }, function (res) {
                            if (res.success) {
                                Swal.fire('Thành công!', res.message, 'success').then(() => location.reload());
                            } else {
                                Swal.fire('Lỗi!', res.message, 'error');
                            }
                        });
                    }
                });
            });

            // Toggle Soft Delete
            $('.btn-toggle-delete').click(function () {
                var id = $(this).data('id');
                $.post('@Url.Action("ToggleDelete")', { id: id }, function (res) {
                    if (res.success) {
                        location.reload();
                    }
                });
            });

            // Delete History Log
            $('.btn-delete-promotion').click(function () {
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Xóa giao dịch này?',
                    text: "Xóa bản ghi này khỏi cơ sở dữ liệu? Bạn không thể khôi phục lại.",
                    icon: 'error',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Xóa vĩnh viễn',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("Delete")', { id: id }, function (res) {
                            if (res.success) {
                                Swal.fire('Đã xóa!', res.message, 'success').then(() => location.reload());
                            } else {
                                Swal.fire('Lỗi!', res.message, 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}
