@model COMICZONE.Models.MarketplacePost

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa bài đăng";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">⚠️ Xác nhận xóa bài đăng #@Model.Id</h5>
            <a asp-action="Index" class="btn btn-light btn-sm">⬅ Quay lại</a>
        </div>

        <div class="card-body">
            <div class="alert alert-danger">
                Bạn có chắc chắn muốn xóa <strong>vĩnh viễn</strong> bài đăng này không? Hành động này <strong>không thể hoàn tác</strong>.
            </div>

            <div class="row g-4">
                <!-- Ảnh sản phẩm -->
                <div class="col-md-5">
                    <div class="border rounded-4 overflow-hidden bg-light">
                        @if (Model.MarketplacePostImages?.Any() == true)
                        {
                            <div id="postImageCarousel" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner">
                                    @for (int i = 0; i < Model.MarketplacePostImages.Count; i++)
                                    {
                                        var img = Model.MarketplacePostImages.ElementAt(i);
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <img src="/uploads/marketplace/@img.Filename" class="d-block w-100" style="height: 300px; object-fit: contain; background: #f8f9fa;" />
                                        </div>
                                    }
                                </div>
                                @if (Model.MarketplacePostImages.Count > 1)
                                {
                                    <button class="carousel-control-prev" type="button" data-bs-target="#postImageCarousel" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" style="filter: invert(1);"></span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#postImageCarousel" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" style="filter: invert(1);"></span>
                                    </button>
                                }
                            </div>
                            <div class="text-center text-muted small py-2">@Model.MarketplacePostImages.Count ảnh</div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <img src="/uploads/marketplace/default.png" class="img-fluid rounded-4" style="max-height: 300px;" alt="Default Image" />
                                <div class="text-muted small mt-2">Chưa có ảnh sản phẩm</div>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-md-7">
                    <h4 class="fw-bold mb-3">@Model.Title</h4>
                    <div class="row g-3 mt-2">
                        <div class="col-6">
                            <label class="text-muted small">Người bán</label>
                            <p class="fw-semibold mb-0">@Model.Seller?.Username</p>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">Giá</label>
                            <p class="fw-bold text-success mb-0">@Model.Price.ToString("N0")đ</p>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">Danh mục</label>
                            <p class="mb-0">@Model.Category</p>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">Tình trạng</label>
                            @{
                                var condText = Model.Condition switch {
                                    "NewLike" => "Như mới", "VeryGood" => "Rất tốt", "Good" => "Tốt",
                                    "Acceptable" => "Chấp nhận được", _ => Model.Condition
                                };
                            }
                            <p class="fw-semibold mb-0">@condText</p>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">Trạng thái</label><br />
                            @{
                                var statusBadge = Model.Status switch {
                                    "Pending" => "bg-warning-subtle text-warning",
                                    "Approved" => "bg-success-subtle text-success",
                                    "Rejected" => "bg-danger-subtle text-danger",
                                    "Sold" => "bg-info-subtle text-info",
                                    _ => "bg-secondary-subtle text-secondary"
                                };
                                var statusText = Model.Status switch {
                                    "Pending" => "Chờ duyệt", "Approved" => "Đã duyệt",
                                    "Rejected" => "Từ chối", "Sold" => "Đã bán", _ => Model.Status
                                };
                            }
                            <span class="badge rounded-pill px-3 py-2 @statusBadge">@statusText</span>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">Ngày đăng</label>
                            <p class="mb-0">@Model.Createdat?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer text-end bg-white">
            <form asp-action="Delete" class="d-inline">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                <button type="submit" class="btn btn-danger">🗑 Xóa vĩnh viễn</button>
            </form>
        </div>
    </div>
</div>
