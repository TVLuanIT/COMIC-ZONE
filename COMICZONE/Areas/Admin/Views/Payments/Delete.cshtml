@model COMICZONE.Models.Payment

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa thanh toán";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Thanh toán</a></li>
                    <li class="breadcrumb-item active">Xóa</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger-subtle py-3 text-center">
                    <h5 class="card-title mb-0 fw-bold text-danger">
                        <i class="ti ti-alert-triangle me-2 fs-4"></i>Xác nhận xóa thanh toán
                    </h5>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="ti ti-trash-x text-danger opacity-25" style="font-size: 5rem;"></i>
                        <h4 class="mt-3">Bạn có chắc chắn muốn xóa?</h4>
                        <p class="text-muted">Hành động này không thể hoàn tác. Dữ liệu thanh toán này sẽ bị xóa khỏi hệ thống.</p>
                    </div>

                    <div class="bg-light p-3 rounded border mb-4 text-start">
                        <div class="row mb-2">
                            <div class="col-5 text-muted small fw-bold text-uppercase">Mã thanh toán:</div>
                            <div class="col-7 fw-bold">#@Model.Paymentid</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 text-muted small fw-bold text-uppercase">Đơn hàng:</div>
                            <div class="col-7 fw-bold">#@Model.Orderid</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 text-muted small fw-bold text-uppercase">Số tiền:</div>
                            <div class="col-7 fw-bold text-danger">@string.Format("{0:N0} VNĐ", Model.Amount)</div>
                        </div>
                        <div class="row">
                            <div class="col-5 text-muted small fw-bold text-uppercase">Phương thức:</div>
                            <div class="col-7">@Model.Paymentmethod</div>
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Paymentid" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger rounded-pill py-2 fw-bold shadow-sm">
                                <i class="ti ti-trash me-1"></i> Xác nhận xóa ngay
                            </button>
                            <a asp-action="Index" class="btn btn-light rounded-pill py-2">
                                Hủy bỏ và quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
