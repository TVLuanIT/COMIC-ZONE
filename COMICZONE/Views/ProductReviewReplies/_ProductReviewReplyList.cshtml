@model IEnumerable<COMICZONE.Models.ProductReviewReply>

@{
    var userIdStr = Context.Session.GetString("UserId");
    var userRoleStr = Context.Session.GetString("UserRole");
    int currentUserId = string.IsNullOrEmpty(userIdStr) ? 0 : int.Parse(userIdStr);
    string currentUserRole = string.IsNullOrEmpty(userRoleStr) ? "User" : userRoleStr;

    int batchSize = 5;
    int totalReplies = Model.Count();

    bool isLoggedIn = currentUserId > 0;

	// Lấy productId từ RouteData (nếu có)
    int productId = ViewBag.ProductId is int id ? id : 0;
}

<div class="reply-list-container" data-review-id="@Model.FirstOrDefault()?.Reviewid">
    @if (totalReplies > 0)
    {
        <button class="show-replies-btn btn btn-link p-0 mb-2" data-batch-size="@batchSize">
            @totalReplies phản hồi
        </button>
    }

    <div class="reply-list">
        @foreach (var reply in Model)
        {
            <div class="reply-item mb-2 ps-3" data-reply-id="@reply.Replyid" style="display:none;">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <!-- LEFT: Avatar + content -->
                    <div class="d-flex flex-grow-1">
                        <div class="reply-avatar me-2">
                            @if (!string.IsNullOrEmpty(reply.User?.Avatar))
                            {
                                @await Component.InvokeAsync("UserAvatar", new { avatarUrl = reply.User.Avatar, size = 24 })
                            }
                            else
                            {
                                @(reply.User?.Username?.Substring(0, 1).ToUpper() ?? "U")
                            }
                        </div>

                        <div class="flex-grow-1">
                            <!-- Tên người gửi + người được reply -->
                            <div class="d-flex align-items-center gap-1 mb-1">
                                <strong>@(reply.User?.Username ?? "Người dùng ẩn danh")</strong>
                                @if (reply.Replytouser != null)
                                {
                                    <span class="text-primary ms-1">@reply.Replytouser.Username</span>
                                }
                            </div>

                            <!-- Nội dung reply -->
                            <div class="reply-content mb-1">@reply.Replycontent</div>

                            <!-- Thời gian -->
                            <div class="reply-date text-muted" style="font-size:0.8rem;">
                                @(reply.Createdat.HasValue? reply.Createdat.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                            </div>

                            <!-- Like/Dislike -->
                            <div class="reply-actions mt-1">
                                <button class="reaction-btn reply-toggle-like @(reply.IsLikedByUser ? "liked" : "")"
                                        data-reply-id="@reply.Replyid">
                                    <svg class="icon like-icon" viewBox="0 0 24 24">
                                        <path d="M1 21h4V9H1v12zM23 10c0-1.1-.9-2-2-2h-6.3l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h8c.82 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-1z" />
                                    </svg>
                                    <span class="like-count">@reply.LikeCount</span>
                                </button>

                                <button class="reaction-btn reply-toggle-dislike @(reply.IsDislikedByUser ? "disliked" : "")"
                                        data-reply-id="@reply.Replyid">
                                    <svg class="icon dislike-icon" viewBox="0 0 24 24">
                                        <path d="M15 3H7c-.83 0-1.54.5-1.84 1.22L2.14 11.27c-.09.23-.14.47-.14.73v1c0 1.1.9 2 2 2h6.3l-.95 4.57-.03.32c0 .41.17.79.44 1.06L9.83 23l6.59-6.59c.36-.36.58-.86.58-1.41V5c0-1.1-.9-2-2-2zm4 0v12h4V3h-4z" />
                                    </svg>
                                </button>

                                <!-- PHẢN HỒI-->
                                <button class="reaction-btn reply-to-reply"
                                        data-review-id="@reply.Reviewid"
                                        data-reply-to-user-id="@reply.Userid"
                                        data-reply-to-username="@reply.User?.Username"
                                        data-reply-id="@reply.Replyid">
                                    <span class="reply-text">💬 Phản hồi</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <!-- RIGHT: 3 dots menu -->
                    <div class="dropdown reply-menu">
                        <button class="action-menu-btn"
                                type="button"
                                id="reply-menu-@reply.Replyid"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            &hellip;
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="reply-menu-@reply.Replyid">
                            @if (reply.Userid == currentUserId)
                            {
                                <!-- Reply của chính họ -->
                                <li>
                                    <a class="dropdown-item edit-reply" href="#" data-id="@reply.Replyid">
                                        Chỉnh sửa
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item delete-reply" href="#" data-id="@reply.Replyid">
                                        Xóa
                                    </a>
                                </li>
                            }
                            else if (currentUserRole == "Admin")
                            {
                                <!-- Admin có quyền xóa tất cả -->
                                <li>
                                    <a class="dropdown-item delete-reply" href="#" data-id="@reply.Replyid">
                                        Xóa
                                    </a>
                                </li>
                            }
                            else
                            {
                                <!-- Người dùng khác hoặc chưa login -->
                                <li>
                                    @if (!isLoggedIn)
                                    {
                                        <a class="dropdown-item" href="/Authentication/Login?returnUrl=/Products/Detail/@productId">
                                            Báo cáo vi phạm
                                        </a>
                                    }
                                    else if (reply.Userid != currentUserId) // đã login và không phải owner
                                    {
                                        if (!reply.IsReportedByUser)
                                        {
                                            <a class="dropdown-item report-review"
                                               href="#"
                                               data-review-id=""
                                               data-reply-id="@reply.Replyid"
                                               data-reported="false"
                                               data-status="">
                                                Báo cáo vi phạm
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="dropdown-item text-muted small">
                                                @if (reply.ReportStatus == "Pending")
                                                {
                                                    <text>Bạn đã gửi báo cáo (đang chờ xử lý)</text>
                                                }
                                                else if (reply.ReportStatus == "Approved")
                                                {
                                                    <text>Báo cáo đã được duyệt</text>
                                                }
                                                else if (reply.ReportStatus == "Rejected")
                                                {
                                                    <text>Báo cáo đã bị từ chối</text>
                                                }
                                                else
                                                {
                                                    <text>Bạn đã gửi báo cáo cho đánh giá này</text>
                                                }
                                            </span>
                                        }
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("~/Views/ProductReviews/_ReportReviewForm.cshtml")