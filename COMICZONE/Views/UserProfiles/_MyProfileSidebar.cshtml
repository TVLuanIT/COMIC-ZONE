@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<ul class="profile-menu">

    <li class="@(action == "MyProfile" ? "active" : "")">
        <a asp-action="MyProfile">Thông tin cá nhân</a>
    </li>

    <li class="@(action == "MyOrders" ? "active" : "")">
        <a asp-action="MyOrders">Đơn hàng của tôi</a>
    </li>

    <li class="@(action == "MyReviews" ? "active" : "")">
        <a asp-action="MyReviews">Đánh giá của tôi</a>
    </li>

    <li class="@(action == "Notifications" ? "active" : "")">
        <a asp-action="Notifications">Thông báo</a>
    </li>

</ul>