@{
    ViewData["Title"] = "Marketplace của tôi";
}

<div class="marketplace-header pt-5 pb-5">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3" data-aos="fade-down">
                    <div>
                        <h1 class="fw-800 mb-1" style="font-family: 'Outfit', sans-serif;">Giao dịch <span class="text-gradient">Của tôi</span></h1>
                        <p class="text-muted mb-0">Quản lý các sản phẩm đăng bán và lịch sử mua hàng của bạn</p>
                    </div>
                </div>
                
                <ul class="nav nav-pills justify-content-center mb-5 gap-3" id="myTab" role="tablist" data-aos="fade-up">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill px-4 py-2 border fw-bold shadow-sm" id="post-tab" data-bs-toggle="tab" data-bs-target="#posts" type="button" role="tab">
                            <i class="bi bi-grid-fill me-2"></i>Bài đăng của tôi
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-4 py-2 border fw-bold shadow-sm" id="selling-tab" data-bs-toggle="tab" data-bs-target="#selling" type="button" role="tab">
                            <i class="bi bi-tag-fill me-2"></i>Đơn hàng đang bán
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-4 py-2 border fw-bold shadow-sm" id="buying-tab" data-bs-toggle="tab" data-bs-target="#buying" type="button" role="tab">
                            <i class="bi bi-bag-check-fill me-2"></i>Đơn hàng đã mua
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="myTabContent" data-aos="fade-up" data-aos-delay="100">
                    <!-- MY POSTS TAB -->
                    <div class="tab-pane fade show active" id="posts" role="tabpanel">
                        <div class="glass-card p-4 p-md-5">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="fw-800 mb-0">Quản lý bài đăng của bạn</h5>
                                <a href="javascript:void(0)" onclick="handleCreatePostClick()" class="btn btn-primary rounded-pill px-3 fw-bold">
                                    <i class="bi bi-plus-lg me-1"></i> Đăng bán mới
                                </a>
                            </div>
                            
                            @if (ViewBag.MyPosts != null && ((IEnumerable<dynamic>)ViewBag.MyPosts).Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle border-separate" style="border-spacing: 0 10px;">
                                        <thead class="bg-light">
                                            <tr>
                                                <th class="border-0 ps-4 rounded-start-4 py-3">Sản phẩm</th>
                                                <th class="border-0 py-3">Danh mục</th>
                                                <th class="border-0 py-3 text-center">Giá sản phẩm</th>
                                                <th class="border-0 py-3">Trạng thái</th>
                                                <th class="border-0 pe-4 rounded-end-4 py-3 text-end">Hành động</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var post in ViewBag.MyPosts)
                                            {
                                                <tr class="bg-white border rounded-4 shadow-sm">
                                                    <td class="ps-4 py-3">
                                                        <div class="d-flex align-items-center">
                                                            @if (post.MarketplacePostImages != null && post.MarketplacePostImages.Count > 0)
                                                            {
                                                                <img src="/uploads/marketplace/@(((IEnumerable<dynamic>)post.MarketplacePostImages).First().Filename)" class="rounded-3 me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                                            }
                                                            else
                                                            {
                                                                <img src="/uploads/marketplace/default.png" class="rounded-3 me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                                            }
                                                            <span class="text-dark fw-800">@post.Title</span>
                                                        </div>
                                                    </td>
                                                    <td class="py-3">@post.Category</td>
                                                    <td class="py-3 text-center"><span class="text-primary fw-800">@string.Format("{0:N0}₫", post.Price)</span></td>
                                                    <td class="py-3">
                                                        @{
                                                            var (statusBadge, statusText) = post.Status switch
                                                            {
                                                                "Approved" => ("bg-success", "Đã duyệt"),
                                                                "Pending" => ("bg-warning", "Chờ duyệt"),
                                                                "Rejected" => ("bg-danger", "Bị từ chối"),
                                                                "Sold" => ("bg-dark", "Đã bán"),
                                                                _ => ("bg-secondary", post.Status)
                                                            };
                                                        }
                                                        <span class="badge @statusBadge bg-opacity-10 text-@statusBadge.Replace("bg-", "") border border-@statusBadge.Replace("bg-", "") border-opacity-25 px-3 py-2 rounded-pill fw-bold">
                                                            @statusText
                                                        </span>
                                                    </td>
                                                    <td class="pe-4 py-3 text-end text-muted small">
                                                        <a asp-controller="MarketplacePosts" asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-white border rounded-pill px-3 fw-700">Chi tiết</a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @await Html.PartialAsync("_Pagination", (PaginationModel)ViewBag.PaginationPost)
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-file-earmark-plus text-muted display-4 mb-3"></i>
                                    <p class="text-muted">Bạn chưa đăng bán sản phẩm nào. Hãy bắt đầu ngay!</p>
                                    <a href="javascript:void(0)" onclick="handleCreatePostClick()" class="btn btn-primary rounded-pill px-4 mt-2 fw-bold">Đăng sản phẩm đầu tiên</a>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- SELLING TAB -->
                    <div class="tab-pane fade" id="selling" role="tabpanel">
                        <div class="glass-card p-4 p-md-5">
                            <h5 class="fw-800 mb-4">Đơn hàng liên quan đến bạn (Người bán)</h5>
                            
                            @if (ViewBag.SellingOrders != null && ((IEnumerable<dynamic>)ViewBag.SellingOrders).Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle border-separate" style="border-spacing: 0 10px;">
                                        <thead class="bg-light">
                                            <tr>
                                                <th class="border-0 ps-4 rounded-start-4 py-3">Sản phẩm</th>
                                                <th class="border-0 py-3">Người mua</th>
                                                <th class="border-0 py-3 text-center">Giá bán</th>
                                                <th class="border-0 py-3">Trạng thái</th>
                                                <th class="border-0 pe-4 rounded-end-4 py-3 text-end">Ngày tạo</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var order in ViewBag.SellingOrders)
                                            {
                                                <tr class="bg-white border rounded-4 shadow-sm">
                                                    <td class="ps-4 py-3"><span class="text-dark fw-800">@order.Post?.Title</span></td>
                                                    <td class="py-3">@order.Buyer?.Username</td>
                                                    <td class="py-3 text-center"><span class="text-danger fw-800">@string.Format("{0:N0}₫", order.Price)</span></td>
                                                    <td class="py-3">
                                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2 rounded-pill fw-bold">
                                                            @order.Status
                                                        </span>
                                                    </td>
                                                    <td class="pe-4 py-3 text-end text-muted small">@order.Createdat?.ToString("dd/MM/yyyy HH:mm")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @await Html.PartialAsync("_Pagination", (PaginationModel)ViewBag.PaginationSell)
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-inbox text-muted display-4 mb-3"></i>
                                    <p class="text-muted">Bạn chưa nhận được đơn hàng nào từ người mua khác.</p>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <!-- BUYING TAB -->
                    <div class="tab-pane fade" id="buying" role="tabpanel">
                        <div class="glass-card p-4 p-md-5">
                            <h5 class="fw-800 mb-4">Lịch sử đơn hàng bạn đã mua</h5>
                            @if (ViewBag.BuyingOrders != null && ((IEnumerable<dynamic>)ViewBag.BuyingOrders).Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle border-separate" style="border-spacing: 0 10px;">
                                        <thead class="bg-light">
                                            <tr>
                                                <th class="border-0 ps-4 rounded-start-4 py-3">Sản phẩm</th>
                                                <th class="border-0 py-3">Người bán</th>
                                                <th class="border-0 py-3 text-center">Giá mua</th>
                                                <th class="border-0 py-3">Trạng thái</th>
                                                <th class="border-0 pe-4 rounded-end-4 py-3 text-end">Ngày tạo</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var order in ViewBag.BuyingOrders)
                                            {
                                                <tr class="bg-white border rounded-4 shadow-sm">
                                                    <td class="ps-4 py-3"><span class="text-dark fw-800">@order.Post?.Title</span></td>
                                                    <td class="py-3">@order.Seller?.Username</td>
                                                    <td class="py-3 text-center"><span class="text-danger fw-800">@string.Format("{0:N0}₫", order.Price)</span></td>
                                                    <td class="py-3">
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 rounded-pill fw-bold">
                                                            @order.Status
                                                        </span>
                                                    </td>
                                                    <td class="pe-4 py-3 text-end text-muted small">@order.Createdat?.ToString("dd/MM/yyyy HH:mm")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @await Html.PartialAsync("_Pagination", (PaginationModel)ViewBag.PaginationBuy)
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-bag-x text-muted display-4 mb-3"></i>
                                    <p class="text-muted">Bạn chưa từng đặt mua sản phẩm nào trên Marketplace.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/marketplace/js/marketplace.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Restore active tab from URL if present
            const urlParams = new URLSearchParams(window.location.search);
            const activeTab = urlParams.get('tab');
            
            if (activeTab === 'sell') {
                const sellTab = document.querySelector('#selling-tab');
                if (sellTab) bootstrap.Tab.getOrCreateInstance(sellTab).show();
            } else if (activeTab === 'buy') {
                const buyTab = document.querySelector('#buying-tab');
                if (buyTab) bootstrap.Tab.getOrCreateInstance(buyTab).show();
            } else if (activeTab === 'posts') {
                const postTab = document.querySelector('#post-tab');
                if (postTab) bootstrap.Tab.getOrCreateInstance(postTab).show();
            }

            // Initialize Marketplace config for profile checks
            Marketplace.initIndex({
                incompleteProfile: '@Html.Raw(TempData["IncompleteProfile"] ?? "")',
                editProfileUrl: '@Url.Action("EditProfile", "UserProfiles", new { area = "Account" })',
                loginUrl: '@Url.Action("Login", "Authentication", new { area = "Account" })',
                checkProfileUrl: '@Url.Action("CheckProfileStatus", "MarketplacePosts", new { area = "Marketplace" })',
                createPostUrl: '@Url.Action("Create", "MarketplacePosts", new { area = "Marketplace" })'
            });
        });

        function handleCreatePostClick() {
            Marketplace.handleCreatePostClick();
        }
    </script>
}
