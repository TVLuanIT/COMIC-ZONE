@if (Model.TotalPages > 1 && Model != null)
{
    <nav class="premium-pagination" aria-label="Page navigation" data-aos="fade-up">
        @{
            var routeValues = new Dictionary<string, string>();

            if (Model.ExtraParams != null)
            {
                foreach (var p in Model.ExtraParams)
                {
                    routeValues[p.Key] = p.Value;
                }
            }
        }

        @* PREVIOUS *@
        @{
            routeValues[Model.PageParam] = (Model.CurrentPage - 1).ToString();
            <a asp-area="@Model.Area"
               asp-controller="@Model.Controller"
               asp-action="@Model.Action"
               asp-all-route-data="routeValues"
               class="page-link-premium @(Model.CurrentPage <= 1 ? "disabled" : "")"
               title="Trang trước">
                <i class="bi bi-chevron-left"></i>
            </a>
        }

        @* PAGE NUMBERS *@
        @{
            int startPage = 1;
            int endPage = Model.TotalPages;
            bool showStartEllipsis = false;
            bool showEndEllipsis = false;

            if (Model.TotalPages > 7)
            {
                if (Model.CurrentPage <= 4)
                {
                    endPage = 5;
                    showEndEllipsis = true;
                }
                else if (Model.CurrentPage >= Model.TotalPages - 3)
                {
                    startPage = Model.TotalPages - 4;
                    showStartEllipsis = true;
                }
                else
                {
                    startPage = Model.CurrentPage - 2;
                    endPage = Model.CurrentPage + 2;
                    showStartEllipsis = true;
                    showEndEllipsis = true;
                }
            }
        }

        @if (showStartEllipsis)
        {
            routeValues[Model.PageParam] = "1";
            <a asp-area="@Model.Area" asp-controller="@Model.Controller" asp-action="@Model.Action" asp-all-route-data="routeValues" class="page-link-premium">1</a>
            <span class="page-link-premium ellipsis">...</span>
        }

        @for (int i = startPage; i <= endPage; i++)
        {
            routeValues[Model.PageParam] = i.ToString();

            <a asp-area="@Model.Area"
               asp-controller="@Model.Controller"
               asp-action="@Model.Action"
               asp-all-route-data="routeValues"
               class="page-link-premium @(i == Model.CurrentPage ? "active" : "")">
                @i
            </a>
        }

        @if (showEndEllipsis)
        {
            <span class="page-link-premium ellipsis">...</span>
            routeValues[Model.PageParam] = Model.TotalPages.ToString();
            <a asp-area="@Model.Area" asp-controller="@Model.Controller" asp-action="@Model.Action" asp-all-route-data="routeValues" class="page-link-premium">@Model.TotalPages</a>
        }

        @* NEXT *@
        @{
            routeValues[Model.PageParam] = (Model.CurrentPage + 1).ToString();
            <a asp-area="@Model.Area"
               asp-controller="@Model.Controller"
               asp-action="@Model.Action"
               asp-all-route-data="routeValues"
               class="page-link-premium @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
               title="Trang tiếp">
                <i class="bi bi-chevron-right"></i>
            </a>
        }
    </nav>
}