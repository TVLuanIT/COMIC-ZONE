@using COMICZONE.Helpers;

@model COMICZONE.Models.ProductReview

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa đánh giá";
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-danger mb-0">
            <i class="ti ti-trash me-2"></i> Xóa đánh giá
        </h4>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg" style="border-radius:16px;">
                <div class="card-body p-4">
                    <!-- WARNING -->
                    <div class="alert alert-danger d-flex align-items-center">
                        <i class="ti ti-alert-triangle me-2"></i>
                        Bạn có chắc chắn muốn xóa đánh giá này không?
                    </div>

                    <!-- USER -->
                    <div class="mb-3">
                        <div class="fw-semibold text-muted mb-1">Người đánh giá</div>
                        <div>
                            @Model.User?.Username
                        </div>
                    </div>

                    <!-- PRODUCT -->
                    <div class="mb-3">
                        <div class="fw-semibold text-muted mb-1">Sản phẩm</div>
                        <div>
                            @Html.Raw(Model.Product?.GetProductCell())
                        </div>
                    </div>

                    <!-- RATING -->
                    <div class="mb-3">
                        <div class="fw-semibold text-muted mb-1">Đánh giá</div>
                        <div class="text-warning fs-5">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Model.Rating)
                                {
                                    <i class="ti ti-star-filled"></i>
                                }
                                else
                                {
                                    <i class="ti ti-star"></i>
                                }
                            }
                        </div>
                    </div>

                    <!-- CONTENT -->
                    <div class="mb-3">
                        <div class="fw-semibold text-muted mb-1">Nội dung</div>
                        <div class="p-3 bg-light rounded-3 border">
                            @Model.Reviewcontent
                        </div>
                    </div>

                    <!-- TIME -->
                    <div class="mb-4 text-muted small">
                        Tạo lúc: @Model.Createdat?.ToString("dd/MM/yyyy HH:mm") <br />
                        @if (Model.Updatedat != null)
                        {
                            <span>Đã chỉnh sửa: @Model.Updatedat?.ToString("dd/MM/yyyy HH:mm")</span>
                        }
                    </div>

                    <!-- ACTION -->
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Reviewid" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light px-4">
                                Hủy
                            </a>

                            <button type="submit" class="btn btn-danger px-4 shadow-sm">
                                <i class="ti ti-trash me-1"></i> Xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>