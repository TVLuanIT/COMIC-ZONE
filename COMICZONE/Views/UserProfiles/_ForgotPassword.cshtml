<div class="profile-content">

    <h3>Quên mật khẩu</h3>

    <p class="text-muted">
        Nhập email của bạn để nhận link đặt lại mật khẩu
    </p>

    <div class="alert alert-info">
        Link đặt lại mật khẩu sẽ có hiệu lực trong 30 phút.
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="text-danger">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="text-success">@TempData["Success"]</div>
    }

    <form asp-action="ForgotPassword"
          asp-controller="UserProfiles"
          method="post">

        <div class="profile-row">
            <label><i class="fa fa-envelope"></i> Email</label>

            <input type="email"
                   name="email"
                   class="form-control"
                   placeholder="Nhập email của bạn"
                   required />
        </div>

        <div class="profile-actions">

            <button type="submit" class="btn-edit">
                Gửi link đặt lại mật khẩu
            </button>

            <a asp-action="MyProfile" class="btn-change-password">
                Hủy
            </a>

        </div>

    </form>

</div>