@model COMICZONE.Models.Notification

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa thông báo";
}

<div class="container-fluid">
    <!-- Breadcrumb & Title -->
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Thông báo</a></li>
                    <li class="breadcrumb-item active">Xóa</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="ti ti-alert-triangle text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-2">Bạn có chắc chắn muốn xóa?</h3>
                    <p class="text-muted mb-4">Hành động này không thể hoàn tác. Thông báo này sẽ bị xóa vĩnh viễn khỏi hệ thống.</p>
                    
                    <div class="p-3 border rounded-3 bg-light-subtle text-start mb-4">
                        <div class="mb-2">
                            <span class="small text-muted fw-bold text-uppercase">Tiêu đề:</span>
                            <div class="fw-bold text-dark">@Model.Title</div>
                        </div>
                        <div class="mb-2">
                            <span class="small text-muted fw-bold text-uppercase">Người nhận:</span>
                            <div class="text-dark">@Model.User?.Username</div>
                        </div>
                        <div>
                            <span class="small text-muted fw-bold text-uppercase">Ngày tạo:</span>
                            <div class="text-dark">@(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))</div>
                        </div>
                    </div>

                    <form asp-action="Delete" class="d-flex justify-content-center gap-3">
                        <input type="hidden" asp-for="NotificationId" />
                        <a asp-action="Index" class="btn btn-light px-4">
                            <i class="ti ti-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-danger px-4 shadow-sm">
                            <i class="ti ti-trash me-1"></i> Xóa vĩnh viễn
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
