@model COMICZONE.Models.Product

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fs-3 text-danger">
            <i class="ti ti-trash"></i> Xóa sản phẩm
        </h1>

        <a asp-action="Index" class="btn btn-light">
            <i class="ti ti-arrow-left"></i>
            Quay lại
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="alert alert-warning mb-4">
                <i class="ti ti-alert-triangle"></i>
                Bạn có chắc chắn muốn xóa sản phẩm này? Hành động này không thể hoàn tác.
            </div>

            <!-- ẢNH -->
            @if (Model.Pictures != null && Model.Pictures.Any())
            {
                <div class="mb-4">
                    <label class="form-label fw-semibold">Hình ảnh</label>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var pic in Model.Pictures)
                        {
                            <img src="~/images/products/@pic.FileName"
                                 style="width:120px;height:120px;object-fit:cover;border-radius:6px;border:1px solid #eee;" />
                        }
                    </div>
                </div>
            }

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên sản phẩm</label>
                        <div>@Model.Name</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tác giả</label>
                        <div>@Model.Author</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nhà phát hành</label>
                        <div>@Model.Distributor</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nhà xuất bản</label>
                        <div>@Model.Publisher</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Giá</label>
                        <div>@string.Format("{0:N0}", Model.Price) đ</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tồn kho</label>
                        <div>@Model.StockQuantity</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Định dạng</label>
                        <div>@Model.Format</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ngày phát hành</label>
                        <div>@Model.ReleaseDate?.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="btn btn-danger">
                        <i class="ti ti-trash"></i>
                        Xóa sản phẩm
                    </button>

                    <a asp-action="Index" class="btn btn-light">
                        Hủy
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
