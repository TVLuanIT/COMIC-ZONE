@{
    ViewBag.Title = "Đăng ký";
    string returnUrl = ViewBag.ReturnUrl as string
                       ?? Context.Request.Query["returnUrl"].FirstOrDefault()
                       ?? "/";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="auth-section">
    <div class="auth-glass-card" data-aos="zoom-in">
        <div class="text-center mb-4">
            <h1 class="auth-title">Tham gia cộng đồng</h1>
            <p class="auth-subtitle">Bắt đầu hành trình đọc truyện của bạn ngay hôm nay</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 rounded-4 text-center mb-4 py-3" 
                 style="background: rgba(239, 68, 68, 0.1); color: #ef4444; font-weight: 600;" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
            </div>
        }

        <form asp-action="Register" method="post" asp-antiforgery="true">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            
            <div class="auth-input-group">
                <i class="bi bi-person-fill"></i>
                <input type="text" name="username" id="username"
                       class="auth-input" placeholder="Tên người dùng"
                       required autocomplete="username" />
            </div>

            <div class="auth-input-group">
                <i class="bi bi-envelope-fill"></i>
                <input type="email" name="email" id="email"
                       class="auth-input" placeholder="Địa chỉ email"
                       required autocomplete="email" />
            </div>

            <div class="auth-input-group">
                <i class="bi bi-lock-fill"></i>
                <input type="password" name="password" id="password"
                       class="auth-input" placeholder="Mật khẩu"
                       required autocomplete="new-password" />
            </div>

            <div class="auth-input-group">
                <i class="bi bi-shield-lock-fill"></i>
                <input type="password" name="confirmPassword" id="confirmPassword"
                       class="auth-input" placeholder="Xác nhận mật khẩu"
                       required autocomplete="new-password" />
            </div>

            <div class="form-check mb-4 px-2">
                <input type="checkbox" id="terms" class="form-check-input" required
                       style="cursor: pointer; background-color: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);">
                <label for="terms" class="form-check-label text-white-50 small" style="cursor: pointer;">
                    Tôi đồng ý với <a href="#" class="auth-link">Điều khoản sử dụng</a>
                </label>
            </div>

            <button type="submit" class="btn-auth-premium">Đăng ký ngay</button>
        </form>

        <div class="auth-footer-text">
            Đã có tài khoản? 
            <a asp-controller="Authentication"
               asp-action="Login"
               asp-route-returnUrl="@ViewBag.ReturnUrl"
               class="auth-link">Đăng nhập</a>
        </div>
    </div>
</section>