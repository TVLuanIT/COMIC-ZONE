@model COMICZONE.Models.Artist

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa họa sĩ";
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                Họa sĩ #@Model.Id
            </h4>
            <span class="text-muted">
                Chỉnh sửa thông tin họa sĩ
            </span>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-light">
                <i class="ti ti-eye"></i> Xem chi tiết
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <input type="hidden" asp-for="Id" />

        <div class="row g-4">

            <!-- LEFT -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="ti ti-user"></i>
                            Thông tin họa sĩ
                        </h5>
                    </div>

                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Tên họa sĩ
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Nhập tên họa sĩ..." />

                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- ACTION -->
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">
                        <button type="submit"
                                class="btn btn-primary me-2">
                            <i class="ti ti-device-floppy"></i>
                            Lưu
                        </button>

                        <a asp-action="Index"
                           class="btn btn-light">
                            <i class="ti ti-x"></i>
                            Hủy
                        </a>
                    </div>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-lg-4">
                <!-- INFO -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body text-center">
                        <h6 class="text-muted">Họa sĩ hiện tại</h6>

                        <div class="fs-5 fw-semibold">
                            @Model.Name
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}