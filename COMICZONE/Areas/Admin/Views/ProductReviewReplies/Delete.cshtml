@model COMICZONE.Models.ProductReviewReply

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa phản hồi";
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-danger mb-0">
            <i class="ti ti-trash me-2"></i> Xóa phản hồi
        </h4>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg" style="border-radius:16px;">
                <div class="card-body p-4">
                    <!-- WARNING -->
                    <div class="alert alert-danger d-flex align-items-center">
                        <i class="ti ti-alert-triangle me-2"></i>
                        Bạn có chắc chắn muốn xóa phản hồi này không?
                    </div>

                    <!-- ORIGINAL REVIEW CONTEXT -->
                    <div class="mb-4 p-3 bg-light rounded-3 border-start border-primary border-4">
                        <div class="d-flex align-items-center mb-2">
                             <i class="ti ti-package me-2 text-primary"></i>
                             <span class="fw-bold">Thông tin sản phẩm:</span>
                             <span class="ms-2">@Html.Raw(Model.Review?.Product?.GetProductCell())</span>
                        </div>

                        <div class="small text-muted mb-2">
                            <i class="ti ti-user me-1"></i> Bài đánh giá của <strong> @Model.Review?.User?.Username </strong>
                        
                            <span class="ms-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="ti ti-star@(i <= Model.Review?.Rating ? "-filled text-warning" : " text-muted")"></i>
                                }
                            </span>
                        </div>

                        <div class="p-2 bg-white rounded border italic">
                            "@Model.Review?.Reviewcontent"
                        </div>
                    </div>

                    @if (Model.Parentreply != null)
                    {
                        <!-- PARENT REPLY CONTEXT -->
                        <div class="mb-4 ps-4 border-start border-info border-3">
                            <div class="fw-semibold text-muted small mb-1">Đang trả lời cho: <strong>@Model.Parentreply.User?.Username</strong></div>
                            <div class="p-2 bg-light rounded border small">
                                "@Model.Parentreply.Replycontent"
                            </div>
                        </div>
                    }

                    <hr class="my-4" />

                    <!-- CURRENT REPLY INFO -->
                    <div class="mb-3">
                        <div class="fw-semibold text-muted mb-1">Người viết phản hồi</div>
                        <div class="fw-bold">
                            @Model.User?.Username 
                            @if(Model.ProductReviewReplyLikes.Any())
                            {
                                <span class="ms-2 badge bg-light text-dark border fw-normal">
                                    <i class="ti ti-thumb-up text-primary me-1"></i> @Model.ProductReviewReplyLikes.Count() Lượt thích
                                </span>
                            }
                        </div>
                    </div>

                    <!-- REPLY CONTENT -->
                    <div class="mb-3">
                        <div class="fw-semibold text-muted mb-1">Nội dung phản hồi muốn xóa</div>
                        <div class="p-3 bg-light rounded-3 border">
                            @Model.Replycontent
                        </div>
                    </div>

                    <!-- TIME -->
                    <div class="mb-4 text-muted small">
                        Tạo lúc: @Model.Createdat?.ToString("dd/MM/yyyy HH:mm") <br />
                        @if (Model.Updatedat != null)
                        {
                            <span>Đã chỉnh sửa: @Model.Updatedat?.ToString("dd/MM/yyyy HH:mm")</span>
                        }
                    </div>

                    <!-- ACTIONS -->
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Replyid" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="ProductReviews" asp-action="Details" asp-route-id="@Model.Review.Reviewid" class="btn btn-light px-4">
                                Hủy
                            </a>

                            <button type="submit" class="btn btn-danger px-4 shadow-sm">
                                <i class="ti ti-trash me-1"></i> Xóa vĩnh viễn
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>