@model List<COMICZONE.Models.MarketplacePost>

<div class="p-4">
    <div class="mb-4 text-center">
        <h2 class="fw-bold text-dark mb-1">Sản phẩm đã lưu</h2>
        <p class="text-muted small mb-0">Danh sách các sản phẩm bạn đã lưu từ Marketplace.</p>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            for (int i = 0; i < Model.Count; i++)
            {
                var post = Model[i];
                <div class="col-md-6" id="fav-@post.Id" data-aos="fade-up" data-aos-delay="@(i * 50)">
                    <div class="card marketplace-fav-card border-0 rounded-4 overflow-hidden h-100 shadow-sm transition-all">
                        <div class="row g-0 h-100">
                            <div class="col-4">
                                <div class="manage-thumb-wrapper h-100">
                                    @if (post.MarketplacePostImages != null && post.MarketplacePostImages.Any())
                                    {
                                        <img src="/uploads/marketplace/@post.MarketplacePostImages.First().Filename" class="manage-thumb" alt="@post.Title">
                                    }
                                    else
                                    {
                                        <img src="/uploads/marketplace/default.png" class="manage-thumb" alt="Default Image">
                                    }
                                </div>
                            </div>
                            <div class="col-8">
                                <div class="card-body p-3 d-flex flex-column justify-content-between h-100">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill x-small">
                                                @post.Category
                                            </span>
                                            <span class="text-danger fw-bold small">@post.Price.ToString("N0")đ</span>
                                        </div>
                                        <h6 class="text-dark fw-bold line-clamp-2 mb-2">@post.Title</h6>
                                        <div class="d-flex align-items-center text-muted x-small">
                                            <i class="bi bi-person me-1"></i> @(post.Seller?.Username ?? "Ẩn danh")
                                            <span class="mx-2">|</span>
                                            <i class="bi bi-tag me-1"></i> @post.Condition
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <a asp-area="Marketplace" asp-controller="MarketplacePosts" asp-action="Details" asp-route-id="@post.Id" class="btn btn-link text-primary p-0 x-small fw-bold text-decoration-none">
                                            Chi tiết <i class="bi bi-arrow-right"></i>
                                        </a>
                                        <button class="btn btn-link text-danger p-0 x-small fw-bold text-decoration-none" onclick="removeFavorite(@post.Id)">
                                            <i class="bi bi-heart-fill"></i> Bỏ lưu
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12" data-aos="fade-up">
                <div class="empty-state-premium text-center py-5">
                    <div class="empty-state-icon mb-4">
                        <div class="icon-circle shadow-premium mx-auto">
                            <i class="bi bi-heartbreak text-primary"></i>
                        </div>
                        <div class="icon-dots mt-2">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                    <h4 class="text-dark fw-bold mb-2">Chưa lưu sản phẩm nào</h4>
                    <p class="text-muted mx-auto" style="max-width: 400px;">
                        Bạn chưa lưu sản phẩm nào từ Marketplace. Hãy khám phá ngay để tìm những món đồ ưng ý!
                    </p>
                    <div class="mt-4">
                        <a asp-area="Marketplace" asp-controller="MarketplacePosts" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm transition-all transform hover:scale-105">
                            <i class="bi bi-shop"></i> Khám phá Marketplace
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (ViewBag.Pagination != null)
    {
        <div class="mt-4 d-flex justify-content-center">
             @await Html.PartialAsync("_Pagination", (PaginationModel)ViewBag.Pagination)
        </div>
    }
</div>

<script>
    async function removeFavorite(postId) {
        Swal.fire({
            title: 'Bỏ lưu sản phẩm?',
            text: "Bạn có chắc chắn muốn bỏ lưu sản phẩm này không?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#6366f1',
            cancelButtonColor: '#aaa',
            confirmButtonText: 'Đồng ý',
            cancelButtonText: 'Hủy'
        }).then(async (result) => {
            if (result.isConfirmed) {
                try {
                    const res = await fetch(`/Marketplace/MarketplacePosts/ToggleFavorite?postId=${postId}`, {
                        method: 'POST'
                    });
                    const data = await res.json();
                    if (data.success && !data.isFavorited) {
                        const item = document.getElementById(`fav-${postId}`);
                        item.style.opacity = '0';
                        item.style.transform = 'scale(0.9)';
                        setTimeout(() => {
                            item.remove();
                            if (document.querySelectorAll('.marketplace-fav-card').length === 0) {
                                location.reload();
                            }
                        }, 300);
                        
                        const Toast = Swal.mixin({
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 2000,
                            timerProgressBar: true,
                        });
                        Toast.fire({
                            icon: 'success',
                            title: 'Đã bỏ lưu sản phẩm'
                        });
                    }
                } catch (err) {
                    console.error(err);
                }
            }
        });
    }
</script>

<style>
    .marketplace-fav-card {
        background: rgba(255, 255, 255, 0.6) !important;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.05) !important;
        height: 150px !important;
    }
    
    .marketplace-fav-card:hover {
        background: rgba(255, 255, 255, 0.9) !important;
        transform: translateY(-5px);
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.08) !important;
    }

    .manage-thumb-wrapper {
        position: relative;
        height: 150px !important;
        overflow: hidden;
    }

    .manage-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .marketplace-fav-card:hover .manage-thumb {
        transform: scale(1.1);
    }
    
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.8em !important;
        line-height: 1.4em !important;
    }
    .x-small { font-size: 0.75rem; }
</style>
