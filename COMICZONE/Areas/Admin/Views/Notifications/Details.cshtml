@model COMICZONE.Models.Notification

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết thông báo";
}

<div class="container-fluid">
    <!-- Breadcrumb & Title -->
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Thông báo</a></li>
                    <li class="breadcrumb-item active">Chi tiết</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="ti ti-info-circle me-2 text-info"></i>Thông tin chi tiết
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="d-flex align-items-start mb-3">
                                <div class="bg-light-primary text-primary rounded-circle p-3 me-3">
                                    <i class="ti ti-bell-ringing fs-4"></i>
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-1">@Model.Title</h4>
                                    <p class="text-muted">@Model.Message</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-sm-6">
                            <div class="p-3 border rounded-3 bg-light-subtle">
                                <label class="small text-uppercase text-muted fw-bold mb-2 d-block">Người nhận</label>

                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-circle symbol-35px me-2">
                                        <div class="symbol symbol-circle symbol-35px me-3">
                                            <img src="@Model.User.GetDisplayAvatar()"
                                                 alt="@Model.User.Username" class="rounded-circle" style="width:40px; height:40px; object-fit:cover;">
                                        </div>
                                    </div>
                                
                                    <div>
                                        <div class="text-dark fw-bold">@Model.User?.Username</div>
                                        <div class="text-muted small">@Model.User?.Email</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 border rounded-3 bg-light-subtle">
                                <label class="small text-uppercase text-muted fw-bold mb-2 d-block">Người gửi</label>
                                
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-circle symbol-35px me-3">
                                        @if (Model.CreatedByNavigation != null)
                                        {
                                            <img src="@Model.CreatedByNavigation.GetDisplayAvatar()"
                                                 alt="@Model.CreatedByNavigation.Username" class="rounded-circle" style="width:40px; height:40px; object-fit:cover;">
                                        }
                                        else
                                        {
                                            <div class="symbol-label bg-light-primary text-primary rounded-circle" style="width:40px; height:40px; display:flex; align-items:center; justify-content:center;">
                                                <i class="ti ti-settings fs-4"></i>
                                            </div>
                                        }
                                    </div>

                                    <div>
                                        <div class="text-dark fw-bold">@(Model.CreatedByNavigation?.Username ?? "Hệ thống")</div>
                                        <div class="text-muted small">Role: @(Model.CreatedByNavigation != null ? "Admin" : "System")</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 border rounded-3 bg-light-subtle">
                                <label class="small text-uppercase text-muted fw-bold mb-2 d-block">Trạng thái</label>
                                
                                @if (Model.IsRead == true)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                        <i class="ti ti-check-double me-1"></i> Đã xem
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
                                        <i class="ti ti-mail-opened me-1"></i> Chưa xem
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 border rounded-3 bg-light-subtle">
                                <label class="small text-uppercase text-muted fw-bold mb-2 d-block">Thời gian tạo</label>

                                <div class="text-dark fw-bold">
                                    <i class="ti ti-calendar-event me-1 text-muted"></i>
                                    @(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Link))
                        {
                            <div class="col-12">
                                <div class="p-3 border rounded-3 bg-light-subtle">
                                    <label class="small text-uppercase text-muted fw-bold mb-2 d-block">Liên kết</label>
                                    <a href="@Model.Link" target="_blank" class="text-primary text-decoration-none">
                                        <i class="ti ti-link me-1"></i> @Model.Link
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card-footer bg-white py-3 border-top-0 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-light px-4">
                        <i class="ti ti-arrow-left me-1"></i> Quay lại
                    </a>
                
                    <a asp-action="Edit" asp-route-id="@Model.NotificationId" class="btn btn-primary px-4">
                        <i class="ti ti-edit me-1"></i> Chỉnh sửa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
