@model COMICZONE.Models.Product
@using System.Globalization;
@using COMICZONE.Extensions;

@{
    ViewBag.Title = Model.Name;
    var priceText = Model.Price.HasValue
        ? string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0}", Model.Price)
        : "Liên hệ";
    var RelatedByAuthor = ViewBag.RelatedByAuthor as IEnumerable<COMICZONE.Models.Product>;
}

@if (TempData["Success"] != null)
{
    <script>
        window.successMessage = "@Html.Raw(TempData["Success"])";
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        window.errorMessage = "@Html.Raw(TempData["Error"])";
    </script>
}

<div class="product-detail-container">
    <div class="container mt-5 pt-5">
        
        <!-- BREADCRUMBS -->
        <nav class="breadcrumb-premium" data-aos="fade-right">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Products" asp-action="Index">Cửa hàng</a>
            <i class="bi bi-chevron-right"></i>
            <span class="text-primary truncate-1">@Model.Name</span>
        </nav>

        <div class="row g-5">
            <!-- LEFT: GALLERY -->
            <div class="col-lg-5" data-aos="fade-up" data-aos-delay="100">
                <div class="detail-gallery-wrapper">
                    <div class="main-img-container">
                        <img src="@Model.GetImagePath()" alt="@Model.Name" id="mainProductImg" />
                    </div>
                    
                    @if (Model.Pictures != null && Model.Pictures.Count > 1)
                    {
                        <div class="thumb-gallery">
                            @{
                                var pictures = Model.Pictures.ToList();
                                for (int i = 0; i < pictures.Count; i++)
                                {
                                    var pic = pictures[i];
                                    <img src="@pic.GetImagePath()" class="thumb-item @(i == 0 ? "active" : "")" alt="thumb" onclick="changeImage(this.src, this)" />
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- RIGHT: PRODUCT INFO -->
            <div class="col-lg-7" data-aos="fade-up" data-aos-delay="200">
                <div class="product-info-header">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (Model.StockQuantity > 0)
                        {
                            <span class="stock-badge-premium stock-in"><i class="bi bi-check-circle-fill"></i> Còn hàng</span>
                        }
                        else
                        {
                            <span class="stock-badge-premium stock-out"><i class="bi bi-x-circle-fill"></i> Hết hàng</span>
                        }
                        <span class="text-secondary small fw-bold">Mã sản phẩm: #@Model.Id</span>
                    </div>

                    <h1 class="product-title-premium">@Model.Name</h1>

                    <div class="price-box-premium">
                        @priceText <span class="fs-4 ms-1">₫</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="product-summary mb-4">
                            <p class="summary-text text-secondary lh-lg" id="desc-@Model.Id" data-full="@Model.Description">
                                @(Model.Description.Length > 200 ? Model.Description.Substring(0, 200) + "..." : Model.Description)
                            </p>
                            @if (Model.Description.Length > 200)
                            {
                                <button class="btn btn-link p-0 text-primary fw-bold text-decoration-none" onclick="ProductSummary.toggle(@Model.Id)">Xem thêm</button>
                            }
                        </div>
                    }
                </div>

                <!-- META INFO GRID -->
                <div class="meta-info-grid">
                    @if (!string.IsNullOrWhiteSpace(Model.Author))
                    {
                        <div class="meta-item">
                            <span class="meta-label">Tác giả</span>
                            <a asp-action="Index" asp-controller="Products" asp-route-author="@Model.Author" class="meta-value text-decoration-none">@Model.Author</a>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Series))
                    {
                        <div class="meta-item">
                            <span class="meta-label">Series</span>
                            <a asp-action="Index" asp-controller="Products" asp-route-series="@Model.Series" class="meta-value text-decoration-none">@Model.Series</a>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Translator))
                    {
                        <div class="meta-item">
                            <span class="meta-label">Dịch giả</span>
                            <a asp-action="Index" asp-controller="Products" asp-route-translator="@Model.Translator" class="meta-value text-decoration-none">@Model.Translator</a>
                        </div>
                    }
                </div>

                <!-- ACTION BUTTONS -->
                <div class="mt-5 d-flex align-items-center gap-3">
                    @if (Model.StockQuantity > 0)
                    {
                        <form asp-controller="Carts" asp-action="AddToCart" method="post">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <button type="submit" class="btn-premium-cart">
                                <i class="bi bi-bag-plus-fill"></i>
                                <span>Thêm vào giỏ hàng</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn-out-stock-premium" disabled>
                            <i class="bi bi-x-circle"></i>
                            Tạm hết hàng
                        </button>
                    }
                </div>

                <!-- TAGS -->
                @if (Model.Tags != null && Model.Tags.Any(t => !t.Isdeleted))
                {
                    <div class="mt-5 pt-3">
                        <span class="text-secondary small fw-bold me-2 uppercase">Tags:</span>
                        @foreach (var tag in Model.Tags.Where(t => !t.Isdeleted))
                        {
                            <a asp-action="Index" asp-controller="Products" asp-route-tag="@tag.Name" class="badge bg-light text-dark me-2 py-2 px-3 border rounded-pill text-decoration-none transition-smooth hover-primary">
                                @tag.Name
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- TABS SECTION -->
        <div class="premium-tabs-wrapper" data-aos="fade-up">
            <ul class="nav nav-tabs premium-nav-tabs" id="productTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(ViewBag.ActiveTab == "detail" ? "active" : "")" id="detail-tab" data-bs-toggle="tab" data-bs-target="#detail" type="button" role="tab" aria-controls="detail" aria-selected="true">
                        Thông số kỹ thuật
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(ViewBag.ActiveTab == "comment" ? "active" : "")" id="comment-tab" data-bs-toggle="tab" data-bs-target="#comment" type="button" role="tab" aria-controls="comment" aria-selected="false">
                        Đánh giá sản phẩm
                    </button>
                </li>
            </ul>

            <div class="tab-content tab-content-premium" id="productTabContent">
                <!-- TAB: DETAILS EXPLAINED -->
                <div class="tab-pane fade @(ViewBag.ActiveTab == "detail" ? "show active" : "")" id="detail" role="tabpanel" aria-labelledby="detail-tab">
                    <div class="specs-container">
                        <div class="specs-column">
                            <h5 class="specs-group-title"><i class="bi bi-info-circle text-primary"></i> Thông tin cơ bản</h5>
                            <ul class="specs-list">
                                <li class="specs-item"><span class="specs-key">Nhà xuất bản</span> <span class="specs-val">@Model.Publisher</span></li>
                                <li class="specs-item"><span class="specs-key">Ngày phát hành</span> <span class="specs-val">@Model.ReleaseDate?.ToString("dd/MM/yyyy")</span></li>
                                <li class="specs-item"><span class="specs-key">Nhà phát hành</span> <span class="specs-val">@Model.Distributor</span></li>
                            </ul>
                        </div>
                        <div class="specs-column">
                            <h5 class="specs-group-title"><i class="bi bi-book text-primary"></i> Hình thức & Khối lượng</h5>
                            <ul class="specs-list">
                                <li class="specs-item"><span class="specs-key">Số trang</span> <span class="specs-val">@Model.Pages</span></li>
                                <li class="specs-item"><span class="specs-key">Kích thước</span> <span class="specs-val">@Model.Size</span></li>
                                <li class="specs-item"><span class="specs-key">Trọng lượng</span> <span class="specs-val">@Model.Weight g</span></li>
                                <li class="specs-item"><span class="specs-key">Loại bìa</span> <span class="specs-val">@Model.Format</span></li>
                            </ul>
                        </div>
                        <div class="specs-column">
                            <h5 class="specs-group-title"><i class="bi bi-layers text-primary"></i> Khác</h5>
                            <ul class="specs-list">
                                <li class="specs-item"><span class="specs-key">Minh họa</span> <span class="specs-val">@Model.IllustrationType</span></li>
                                <li class="specs-item"><span class="specs-key">Độ tuổi</span> <span class="specs-val">@Model.AgeGroup</span></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- TAB: REVIEWS / COMMENTS -->
                <div class="tab-pane fade @(ViewBag.ActiveTab == "comment" ? "show active" : "")" id="comment" role="tabpanel" aria-labelledby="comment-tab">
                    <input type="hidden" id="product-id" value="@Model.Id" />
                    <div class="row g-4">
                        <div class="col-lg-4">
                            @await Html.PartialAsync("~/Views/ProductReviewSummaries/_ProductReviewSummaries.cshtml", Model.ProductReviewSummary)
                        </div>
                        <div class="col-lg-8">
                            <div class="mb-4">
                                @await Html.PartialAsync("~/Views/ProductReviews/_ProductReviewForm.cshtml", new COMICZONE.Models.ProductReview { Productid = Model.Id })
                            </div>
                            <div id="review-container"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RELATED PRODUCTS -->
        @if (RelatedByAuthor != null && RelatedByAuthor.Any())
        {
            ViewBag.SectionTitle = "Cùng Tác Giả";
            ViewBag.SectionIcon = "bi-person text-info";
            ViewBag.CarouselId = "sameAuthorCarousel";
            ViewBag.ViewMoreLink = Url.Action("Index", "Products", new { author = Model.Author });
            ViewBag.SectionDescription = "Khám phá các tác phẩm khác của cùng tác giả.";
            
            <div class="mt-5 pt-5" data-aos="fade-up">
                @await Html.PartialAsync("~/Views/Home/_HomeProduct.cshtml", RelatedByAuthor)
            </div>
        }
    </div>
</div>

<script>
    function changeImage(src, thumb) {
        document.getElementById('mainProductImg').src = src;
        document.querySelectorAll('.thumb-item').forEach(i => i.classList.remove('active'));
        thumb.classList.add('active');
    }
</script>