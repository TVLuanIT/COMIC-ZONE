@model COMICZONE.Models.BlogCategory

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm danh mục blog";
}

<div class="container-fluid px-4 py-5">
    <div class="mb-5">
        <h1 class="h3 fw-bold mb-1 text-dark">Thêm danh mục blog</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">Bảng điều khiển</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Danh mục blog</a></li>
                <li class="breadcrumb-item active fw-medium text-primary" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-7 col-lg-9">
            <div class="card border-0 shadow-lg overflow-hidden" style="border-radius: 12px;">
                <div class="card-header bg-primary py-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="ti ti-folder-plus text-white fs-4"></i>
                        <h5 class="card-title mb-0 text-white fw-semibold">Thông tin danh mục</h5>
                    </div>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" class="needs-validation">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm mb-4" role="alert"></div>
                        
                        <div class="row g-4 mb-4">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label fw-bold text-secondary">Tên danh mục <span class="text-danger">*</span></label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light-subtle text-muted border-end-0"><i class="ti ti-category"></i></span>
                                    <input asp-for="Name" class="form-control border-start-0 ps-0 bg-light-subtle" placeholder="Ví dụ: Tin tức thế giới" autofocus />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                            </div>
                            
                            <div class="col-12">
                                <label asp-for="Slug" class="form-label fw-bold text-secondary">Đường dẫn thân thiện (Slug) <span class="text-danger">*</span></label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light-subtle text-muted border-end-0"><i class="ti ti-link"></i></span>
                                    <input asp-for="Slug" class="form-control border-start-0 ps-0 bg-light-subtle text-muted" placeholder="tin-tuc-the-gioi" />
                                </div>
                                <span asp-validation-for="Slug" class="text-danger small mt-1 d-block"></span>
                                <div class="form-text mt-2 ms-1 text-muted">
                                    <i class="ti ti-info-circle me-1"></i> Slug sẽ tự động tạo từ tên và được dùng làm URL của danh mục.
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-medium rounded-pill transition-all hover:bg-light">
                                <i class="ti ti-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm rounded-pill transition-all transform hover:scale-105">
                                <i class="ti ti-device-floppy me-1"></i> Lưu danh mục
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const nameInput = document.getElementById('Name');
            const slugInput = document.getElementById('Slug');

            if (nameInput && slugInput) {
                nameInput.addEventListener('input', function() {
                    let name = this.value;
                    let slug = name.toLowerCase()
                        .normalize("NFD")
                        .replace(/[\u0300-\u036f]/g, "")
                        .replace(/[đĐ]/g, 'd')
                        .replace(/[^\w\s-]/g, "")
                        .trim()
                        .replace(/\s+/g, '-')
                        .replace(/-+/g, '-');
                    slugInput.value = slug;
                });
            }
        });
    </script>
}

