@model IEnumerable<COMICZONE.Models.ViolationReport>
@using COMICZONE.Models.Enums

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Báo cáo vi phạm";
}

<div class="container-fluid">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">📋 Báo cáo vi phạm</h4>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle table-hover custom-table">
                    <thead>
                        <tr>
                            <th class="fw-bold text-center">Loại</th>
                            <th class="fw-bold">Đối tượng</th>
                            <th class="fw-bold">Lý do</th>
                            <th class="fw-bold text-center">Trạng thái</th>
                            <th class="fw-bold">Ngày gửi</th>
                            <th class="fw-bold text-center">Đã xóa</th>
                            <th class="fw-bold">Người gửi</th>
                            <th class="fw-bold text-center">Hành động</th>
                        </tr>
                    </thead>

                    @if (Model != null && Model.Any())
                    {
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Loại -->
                                    <td class="text-center">
                                        <span class="badge rounded-pill px-3 py-2 fw-semibold
                                                        @(item.ReportTypeEnum == ReportType.Review ? "bg-primary-subtle text-primary" : "bg-success-subtle text-success")">
                                            @(item.ReportTypeEnum == ReportType.Review ? "Review" : "Reply")
                                        </span>
                                    </td>

                                    <!-- Đối tượng -->
                                    <td>
                                        @(item.ReportTypeEnum == ReportType.Review
                                                                        ? $"Review #{item.Targetid}"
                                                                        : $"Reply #{item.Targetid}")
                                                                                                </td>

                                    <!-- Lý do -->
                                    <td class="text-muted">@item.Reason</td>

                                    <!-- Trạng thái -->
                                    <td class="text-center">
                                        <span class="badge rounded-pill px-3 py-2 fw-semibold
                                                        @(item.StatusEnum == ReportStatus.Pending ? "bg-warning-subtle text-warning" :
                                                                                                                                        item.StatusEnum == ReportStatus.Approved ? "bg-success-subtle text-success" :
                                                                                                                                        "bg-danger-subtle text-danger")">
                                    @item.StatusEnum
                                </span>
                            </td>

                                    <!-- Ngày -->
                                    <td class="text-nowrap">
                                        @item.Createdat.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <!-- Đã xóa -->
                                    <td class="text-center">
                                @if (item.Isdeleted)
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Đã xóa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success">Còn</span>
                                        }
                                    </td>

                                    <!-- Người gửi -->
                                    <td>@item.User.Username</td>

                                    <!-- Hành động -->
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">✏️</a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">🔍</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">🗑</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                📭 Không có báo cáo nào
                            </td>
                        </tr>
                    }

                </table>
            </div>
        </div>
    </div>
</div>