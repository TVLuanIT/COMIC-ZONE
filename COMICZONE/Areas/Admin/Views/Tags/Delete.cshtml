@model COMICZONE.Models.Tag

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa Tag";
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 text-danger">
                <i class="ti ti-trash"></i>
                Xóa Tag
            </h4>
            <span class="text-muted small">ID: @Model.Id</span>
        </div>

        <a asp-action="Index" class="btn btn-light">
            <i class="ti ti-arrow-left"></i>
            Quay lại
        </a>
    </div>

    <div class="row">
        <!-- LEFT -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0 text-danger">
                        <i class="ti ti-alert-triangle"></i>
                        Xác nhận xóa
                    </h5>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning">
                        Bạn có chắc chắn muốn xóa tag này không?
                        Hành động này <strong>không thể hoàn tác</strong>.
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3 text-muted">
                            Tên Tag
                        </div>
                        <div class="col-md-9 fw-semibold">
                            @Model.Name
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT -->
        <div class="col-lg-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h6 class="mb-0">Hành động</h6>
                </div>

                <div class="card-body">
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex gap-2">

                            <a asp-action="Index"
                               class="btn btn-light flex-fill">
                                <i class="ti ti-x"></i>
                                Hủy
                            </a>

                            <button type="submit"
                                    class="btn btn-danger flex-fill">
                                <i class="ti ti-trash"></i>
                                Xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>