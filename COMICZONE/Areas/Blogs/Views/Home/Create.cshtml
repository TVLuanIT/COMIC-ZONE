@model COMICZONE.Models.Blog
@{
    ViewData["Title"] = "Chia sẻ đam mê";
    var categories = ViewBag.Categories as List<COMICZONE.Models.BlogCategory>;
}

<div class="blog-hero mini-hero">
    <div class="hero-overlay"></div>
    <div class="container position-relative z-index-2 py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center" data-aos="fade-down">
                <div class="badge-premium mb-3">
                    <i class="bi bi-pencil-fill me-2"></i>Sáng tạo nội dung
                </div>
                <h1 class="hero-title-main">Viết <span class="text-gradient">Blog</span> Của Bạn</h1>
                <p class="hero-subtitle">Chia sẻ những đánh giá, tin tức và cảm xúc của bạn với cộng đồng yêu truyện tranh.</p>
            </div>
        </div>
    </div>
</div>

<section class="py-5 bg-blogs-content">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-10 mx-auto">
                <div class="create-blog-card" data-aos="fade-up">
                    <form asp-action="Create" asp-area="Blogs" asp-controller="Home" method="post" enctype="multipart/form-data" class="premium-form">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                        
                        <div class="row g-4">
                            <!-- Left Side: Basic Info -->
                            <div class="col-lg-8">
                                <div class="form-group-premium mb-4">
                                    <label asp-for="Title" class="form-label-premium">Tiêu đề bài viết</label>
                                    <input asp-for="Title" class="form-control-premium" placeholder="Nhập tiêu đề hấp dẫn..." required />
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>

                                <div class="form-group-premium mb-4">
                                    <label asp-for="Shortdescription" class="form-label-premium">Mô tả ngắn</label>
                                    <textarea asp-for="Shortdescription" class="form-control-premium" rows="3" placeholder="Tóm tắt ngắn gọn nội dung bài viết..."></textarea>
                                    <span asp-validation-for="Shortdescription" class="text-danger"></span>
                                </div>

                                <div class="form-group-premium mb-4">
                                    <label asp-for="Content" class="form-label-premium">Nội dung chi tiết</label>
                                    <textarea asp-for="Content" class="form-control-premium" rows="15" id="blog-content-editor" placeholder="Viết nội dung bài viết ở đây..."></textarea>
                                    <span asp-validation-for="Content" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Right Side: Sidebar Options -->
                            <div class="col-lg-4">
                                <div class="sidebar-card-premium mb-4">
                                    <div class="card-header-premium">
                                        <i class="bi bi-image me-2"></i>
                                        <h6 class="mb-0">Ảnh đại diện (Thumbnail)</h6>
                                    </div>
                                    <div class="card-body-premium">
                                        <div class="thumbnail-upload-wrap">
                                            <div class="thumbnail-preview-container mb-3" id="thumbnail-preview">
                                                <img src="/blogs/images/default-blog.png" class="img-fluid rounded shadow-sm" alt="Preview">
                                            </div>
                                            <input type="file" name="thumbnailFile" id="thumbnail-input" class="d-none" accept="image/*" />
                                            <button type="button" class="btn-cta-outline w-100" onclick="document.getElementById('thumbnail-input').click()">
                                                <i class="bi bi-cloud-upload me-2"></i>Chọn ảnh
                                            </button>
                                            <small class="text-muted d-block mt-2 text-center italic">Định dạng: JPG, PNG, WEBP. Tối đa 2MB.</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="sidebar-card-premium mb-4">
                                    <div class="card-header-premium">
                                        <i class="bi bi-tags-fill me-2"></i>
                                        <h6 class="mb-0">Danh mục bài viết</h6>
                                    </div>
                                    <div class="card-body-premium">
                                        <div class="category-selection-list">
                                            @if (categories != null)
                                            {
                                                var selectedCats = ViewBag.SelectedCategories as List<int> ?? new List<int>();
                                                foreach (var cat in categories)
                                                {
                                                    <div class="form-check custom-check mb-2">
                                                        <input class="form-check-input" type="checkbox" 
                                                               name="selectedCategories" value="@cat.Id" 
                                                               id="cat-@cat.Id" 
                                                               @(selectedCats.Contains(cat.Id) ? "checked" : "")>
                                                        <label class="form-check-label" for="cat-@cat.Id">
                                                            @cat.Name
                                                        </label>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState["selectedCategories"]?.Errors.Count > 0)
                                        {
                                            <div class="text-danger small mt-2">
                                                <i class="bi bi-exclamation-circle me-1"></i>
                                                @Html.ValidationMessage("selectedCategories")
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="publish-card sidebar-card-premium">
                                    <div class="card-body-premium p-4">
                                        <div class="d-flex align-items-center mb-4 text-warning">
                                            <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                            <p class="small mb-0">Bài viết sẽ được chuyển sang trạng thái <strong>Chờ phê duyệt</strong> trước khi đăng tải chính thức.</p>
                                        </div>
                                        <button type="submit" class="btn-premium-grad w-100 py-3 mb-3">
                                            <i class="bi bi-send-fill me-2"></i>Gửi bài ngay
                                        </button>
                                        <a asp-action="Index" class="btn btn-outline-secondary w-100 py-2 border-blogs-dim text-blogs-dim">Hủy bỏ</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .mini-hero {
            min-height: 40vh !important;
        }
        
        .create-blog-card {
            background: rgba(26, 26, 26, 0.4);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 24px;
            padding: 40px;
        }

        .form-label-premium {
            color: rgba(255, 255, 255, 0.9);
            font-weight: 600;
            margin-bottom: 10px;
            display: block;
        }

        .form-control-premium {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            color: #fff;
            padding: 12px 20px;
            transition: all 0.3s ease;
        }

        .form-control-premium:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--primary-color, #ff4d4d);
            box-shadow: 0 0 0 4px rgba(255, 77, 77, 0.1);
            outline: none;
            color: #fff;
        }

        .sidebar-card-premium {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            overflow: hidden;
        }

        .card-header-premium {
            background: rgba(255, 255, 255, 0.05);
            padding: 15px 20px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .card-body-premium {
            padding: 20px;
        }

        .thumbnail-preview-container {
            width: 100%;
            aspect-ratio: 16/9;
            overflow: hidden;
            border-radius: 12px;
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .thumbnail-preview-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .custom-check .form-check-input {
            background-color: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .custom-check .form-check-input:checked {
            background-color: var(--primary-color, #ff4d4d);
            border-color: var(--primary-color, #ff4d4d);
        }

        .custom-check .form-check-label {
            color: rgba(255, 255, 255, 0.7);
            cursor: pointer;
            transition: color 0.2s;
        }

        .custom-check .form-check-input:checked + .form-check-label {
            color: #fff;
        }
        
        .text-blogs-dim {
            color: rgba(255, 255, 255, 0.5) !important;
        }
        
        .border-blogs-dim {
            border-color: rgba(255, 255, 255, 0.1) !important;
        }

        /* Tiny details */
        .italic { font-style: italic; }
        .spacing-1 { letter-spacing: 1px; }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('thumbnail-input').addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.querySelector('#thumbnail-preview img').src = e.target.result;
                }
                reader.readAsDataURL(e.target.files[0]);
            }
        });

        // Animation for form submission
        const form = document.querySelector('.premium-form');
        form.addEventListener('submit', function() {
            if ($(this).valid()) {
                const btn = this.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang gửi bài...';
            }
        });
    </script>
}
