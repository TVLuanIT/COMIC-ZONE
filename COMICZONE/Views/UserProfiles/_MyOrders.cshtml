@model List<COMICZONE.Models.Order>

<div class="profile-content orders-page">

    <h3 class="mb-4">Đơn hàng của tôi</h3>

    @if (!Model.Any())
    {
        <div class="empty-orders">
            <p>Bạn chưa có đơn hàng nào.</p>
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            <div class="order-card">

                <div class="order-header">

                    <div>
                        <span class="order-id">Đơn hàng #@order.OrderId</span>
                        <span class="order-date">
                            @order.OrderDate?.ToString("dd/MM/yyyy")
                        </span>
                    </div>

                    <div class="order-status">

                        @{
                            var statusText = "Chờ xử lý";
                            var statusClass = "status-pending";

                            if (order.Status == "Shipping")
                            {
                                statusText = "Đang giao";
                                statusClass = "status-shipping";
                            }
                            else if (order.Status == "Completed")
                            {
                                statusText = "Hoàn thành";
                                statusClass = "status-completed";
                            }
                        }

                        <span class="@statusClass">@statusText</span>

                    </div>

                </div>

                <div class="order-body">

                    <div class="order-total">
                        Tổng tiền:
                        <span>
                            @order.TotalAmount?.ToString("N0") đ
                        </span>
                    </div>

                    <a asp-controller="Orders"
                       asp-action="OrderDetails"
                       asp-route-id="@order.OrderId"
                       class="btn btn-primary btn-sm">
                        Xem chi tiết
                    </a>

                </div>

            </div>
        }
    }

</div>