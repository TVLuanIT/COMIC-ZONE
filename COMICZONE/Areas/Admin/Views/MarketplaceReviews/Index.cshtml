@model COMICZONE.Areas.Admin.ViewModels.MarketplaceReviewSearchModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Đánh giá người bán Marketplace";
    var reviews = ViewBag.Reviews as List<COMICZONE.Models.MarketplaceReview> ?? new();
}

<div class="container-fluid">
    <!-- Breadcrumb & Title -->
    <div class="row page-titles mb-4">
        <div class="col-md-7 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-5 align-self-center text-end">
            <ol class="breadcrumb justify-content-end mb-0 px-0 bg-transparent">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item">Marketplace</li>
                <li class="breadcrumb-item active">Đánh giá</li>
            </ol>
        </div>
    </div>

    <!-- Search Form -->
    <partial name="_ReviewSearchForm" model="Model" />

    <!-- Table -->
    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase small fw-bold">
                        <tr class="align-middle">
                            <th class="ps-4">@Html.SortHeader("ID", "id", Model.SortColumn, Model.IsAscending, "reviewSearch")</th>
                            <th>Giao dịch</th>
                            <th>Người bán</th>
                            <th>@Html.SortHeader("Người đánh giá", "reviewer", Model.SortColumn, Model.IsAscending, "reviewSearch")</th>
                            <th class="text-center">@Html.SortHeader("Rating", "rating", Model.SortColumn, Model.IsAscending, "reviewSearch")</th>
                            <th>Nội dung</th>
                            <th class="text-center">@Html.SortHeader("Ngày", "createdat", Model.SortColumn, Model.IsAscending, "reviewSearch")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (reviews.Any())
                        {
                            @foreach (var review in reviews)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">#@review.Id</td>
                                    <td>
                                        <span class="text-truncate d-inline-block" style="max-width:150px;" title="@review.Order?.Post?.Title">
                                            @(review.Order?.Post?.Title ?? "N/A")
                                        </span>
                                    </td>
                                    <td>@review.Order?.Seller?.Username</td>
                                    <td>@review.Reviewer?.Username</td>
                                    <td class="text-center">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="ti ti-star@(i <= review.Rating ? "-filled text-warning" : " text-muted")" style="font-size:12px;"></i>
                                        }
                                    </td>
                                    <td><span class="text-truncate d-inline-block" style="max-width:200px;" title="@review.Comment">@review.Comment</span></td>
                                    <td class="text-center small text-muted">@review.Createdat?.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center py-5 text-muted"><i class="ti ti-mood-empty fs-1 d-block mb-2"></i>Không có đánh giá nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top-0 py-3">
                <partial name="~/Areas/Admin/Views/Shared/_AdminPagination.cshtml" model="Model" />
            </div>
        }
    </div>
</div>
