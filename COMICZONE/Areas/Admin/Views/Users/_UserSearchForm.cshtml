@model COMICZONE.Areas.Admin.ViewModels.UserSearchModel

<form method="get" class="user-search-form mb-4 border p-3 rounded bg-light shadow-sm">
    <div class="row align-items-end g-3">
        @* Basic Search *@
        <div class="col-md-3">
            <label class="form-label small fw-bold text-uppercase text-secondary">Từ khóa</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="ti ti-search"></i>
                </span>
                <input type="text" name="Keyword" value="@Model.Keyword" class="form-control border-start-0" placeholder="Username, Email, ID, Tên...">
            </div>
        </div>

        <div class="col-md-2">
            <label class="form-label small fw-bold text-uppercase text-secondary">Vai trò</label>
            <select name="Roles" class="form-select" multiple size="1" style="min-height: 38px;">
                <option value="ADMIN" selected="@(Model.Roles?.Contains("ADMIN") == true)">Quản trị</option>
                <option value="CUSTOMER" selected="@(Model.Roles?.Contains("CUSTOMER") == true)">Khách hàng</option>
                <option value="EMPLOYEE" selected="@(Model.Roles?.Contains("EMPLOYEE") == true)">Nhân viên</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label small fw-bold text-uppercase text-secondary">Trạng thái</label>
            <select name="IsActive" class="form-select">
                <option value="">-- Tất cả --</option>
                <option value="true" selected="@(Model.IsActive == true)">Hoạt động</option>
                <option value="false" selected="@(Model.IsActive == false)">Ngưng HĐ</option>
            </select>
        </div>

        <div class="col-md-5 d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#userAdvancedSearch" aria-expanded="false">
                <i class="ti ti-adjustments-horizontal"></i> Nâng cao
            </button>
            <button type="submit" class="btn btn-primary px-4">
                <i class="ti ti-filter"></i> Lọc
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-refresh"></i>
            </a>
        </div>
    </div>

    @* Advanced Search (Collapsible) *@
    <div class="collapse mt-4 pt-4 border-top @(CheckIfAdvancedFiltersUsed() ? "show" : "")" id="userAdvancedSearch">
        <div class="row g-3">
            @* Account & Security *@
            <div class="col-12"><h6 class="text-primary border-bottom pb-1">Thông tin Tài khoản & Bảo mật</h6></div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase text-secondary">Username</label>
                <input type="text" name="Username" value="@Model.Username" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Email</label>
                <input type="text" name="Email" value="@Model.Email" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Họ tên (Hồ sơ)</label>
                <input type="text" name="CustomerFullName" value="@Model.CustomerFullName" class="form-control">
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase text-secondary">Số điện thoại</label>
                <input type="text" name="CustomerPhoneNumber" value="@Model.CustomerPhoneNumber" class="form-control">
            </div>
            <div class="col-md-2">
                <div class="form-check pt-4 mt-1">
                    <input class="form-check-input" type="checkbox" name="IsDeleted" value="true" @(Model.IsDeleted == true ? "checked" : "")>
                    <label class="form-check-label small fw-bold text-uppercase text-secondary">Đã xóa mềm</label>
                </div>
            </div>

            @* Activity Levels *@
            <div class="col-12 mt-4"><h6 class="text-primary border-bottom pb-1">Mức độ hoạt động</h6></div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Số đơn hàng (Min - Max)</label>
                <div class="input-group">
                    <input type="number" name="OrderCountMin" value="@Model.OrderCountMin" class="form-control" placeholder="Từ">
                    <input type="number" name="OrderCountMax" value="@Model.OrderCountMax" class="form-control" placeholder="Đến">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Số đánh giá (Min - Max)</label>
                <div class="input-group">
                    <input type="number" name="ReviewCountMin" value="@Model.ReviewCountMin" class="form-control" placeholder="Từ">
                    <input type="number" name="ReviewCountMax" value="@Model.ReviewCountMax" class="form-control" placeholder="Đến">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Số bài viết (Min - Max)</label>
                <div class="input-group">
                    <input type="number" name="BlogCountMin" value="@Model.BlogCountMin" class="form-control" placeholder="Từ">
                    <input type="number" name="BlogCountMax" value="@Model.BlogCountMax" class="form-control" placeholder="Đến">
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex flex-wrap gap-3 pt-3 mt-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="HasAvatar" value="true" @(Model.HasAvatar == true ? "checked" : "")>
                        <label class="form-check-label small fw-bold text-uppercase text-secondary">Có Avatar</label>
                    </div>
                     <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="HasNotifications" value="true" @(Model.HasNotifications == true ? "checked" : "")>
                        <label class="form-check-label small fw-bold text-uppercase text-secondary">Có TB</label>
                    </div>
                </div>
            </div>

            @* Timeline & Violations *@
            <div class="col-12 mt-4"><h6 class="text-primary border-bottom pb-1">Thời gian & Vi phạm</h6></div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Ngày đăng ký từ</label>
                <input type="date" name="CreatedFrom" value="@(Model.CreatedFrom?.ToString("yyyy-MM-dd"))" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Ngày đăng ký đến</label>
                <input type="date" name="CreatedTo" value="@(Model.CreatedTo?.ToString("yyyy-MM-dd"))" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Số vi phạm (Min - Max)</label>
                <div class="input-group">
                    <input type="number" name="ViolationCountMin" value="@Model.ViolationCountMin" class="form-control" placeholder="Từ">
                    <input type="number" name="ViolationCountMax" value="@Model.ViolationCountMax" class="form-control" placeholder="Đến">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-check pt-4 mt-2">
                    <input class="form-check-input" type="checkbox" name="HasViolations" value="true" @(Model.HasViolations == true ? "checked" : "")>
                    <label class="form-check-label small fw-bold text-uppercase text-secondary text-danger">Có lịch sử vi phạm</label>
                </div>
            </div>
        </div>
    </div>

    @* Hidden Sort Info *@
    <input type="hidden" name="SortColumn" value="@Model.SortColumn">
    <input type="hidden" name="IsAscending" value="@Model.IsAscending.ToString().ToLower()">
</form>

@functions {
    bool CheckIfAdvancedFiltersUsed()
    {
        return !string.IsNullOrWhiteSpace(Model.Username) || !string.IsNullOrWhiteSpace(Model.Email) ||
               !string.IsNullOrWhiteSpace(Model.CustomerFullName) || !string.IsNullOrWhiteSpace(Model.CustomerPhoneNumber) ||
               Model.IsDeleted == true || Model.OrderCountMin.HasValue || Model.OrderCountMax.HasValue ||
               Model.ReviewCountMin.HasValue || Model.ReviewCountMax.HasValue ||
               Model.BlogCountMin.HasValue || Model.BlogCountMax.HasValue ||
               Model.HasAvatar == true || Model.HasNotifications == true ||
               Model.CreatedFrom.HasValue || Model.CreatedTo.HasValue ||
               Model.HasViolations == true || Model.ViolationCountMin.HasValue;
    }
}
