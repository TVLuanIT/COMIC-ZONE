@using Microsoft.AspNetCore.Http
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var username = Context.Session.GetString("Username");
    var avatar = Context.Session.GetString("Avatar");
}

<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8" />
        <title>@ViewData["Title"] - Trang quản trị</title>

        <meta name="viewport" content="width=device-width, initial-scale=1">

        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/assets/css/main.css">
        <link rel="stylesheet" href="~/assets/css/admin-common.css" asp-append-version="true">
        <link rel="stylesheet" href="~/assets/css/admin-products.css" asp-append-version="true">
        <link rel="stylesheet" href="~/assets/css/admin-reviews.css" asp-append-version="true">
        <link rel="stylesheet" href="~/assets/css/admin-violations.css" asp-append-version="true">
        <link rel="stylesheet" href="~/assets/css/admin-users.css" asp-append-version="true">
        <link rel="stylesheet" href="~/assets/css/admin-reports.css" asp-append-version="true">
        <link rel="stylesheet" href="~/assets/css/admin-dashboard.css" asp-append-version="true">

        <link href="https://unpkg.com/@@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet">

        <!-- Select2 -->
        <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
        <link href="https://cdnjs.cloudflare.com/ajax/libs/select2-bootstrap-5-theme/1.3.0/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    </head>

    <body>
        <div id="overlay" class="overlay"></div>

        <!-- THANH TRÊN -->
        <nav id="topbar" class="navbar bg-white border-bottom fixed-top topbar px-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <!-- Nút cho Desktop -->
                <button id="toggleBtn" class="d-none d-lg-inline-flex btn btn-light btn-icon btn-sm me-2">
                    <i class="ti ti-layout-sidebar-left-expand"></i>
                </button>
                <!-- Nút cho Mobile -->
                <button id="mobileBtn" class="d-inline-flex d-lg-none btn btn-light btn-icon btn-sm">
                    <i class="ti ti-menu-2"></i>
                </button>
            </div>

            <div class="user-profile-topbar ms-auto d-flex align-items-center">
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle user-dropdown" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar-wrapper me-2">
                            @await Component.InvokeAsync("UserAvatar", new { avatarUrl = avatar, size = 32 })
                        </div>
                        <span class="username-text d-none d-sm-inline-block">@username</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                        <li>
                            <div class="dropdown-header d-sm-none">
                                <strong>@username</strong>
                            </div>
                        </li>
                        <li>
                            <form asp-area="Account" asp-controller="Authentication" asp-action="Logout" method="post" id="logoutForm">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="ti ti-logout me-2"></i> Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- THANH BÊN -->
        <aside id="sidebar" class="sidebar">
            <div class="logo-area">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span class="logo-text ms-2">Quản trị</span>
                </a>
            </div>

            <ul class="nav flex-column">
                <!-- 1. Tổng quan -->
                <li class="nav-item">
                    <a class="nav-link @(controller == "Dashboard" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        <i class="ti ti-home"></i>
                        <span class="nav-text">Bảng điều khiển</span>
                    </a>
                </li>

                <!-- 2. Sản phẩm -->
                <li class="nav-item">
                    <a class="nav-link @(controller == "Products" || controller == "Artists" || controller == "Tags" || controller == "InventoryLogs" ? "active" : "")"
                       data-bs-toggle="collapse" href="#productMenu">
                        <i class="ti ti-package"></i>
                        <span class="nav-text">Sản phẩm</span>

                        <i class="ti ti-chevron-down ms-auto icon-plus"></i>
                    </a>

                    <ul class="collapse ps-3 @(controller == "Products" || controller == "Artists" || controller == "Tags" || controller == "InventoryLogs" ? "show" : "")"
                        id="productMenu">
                        <li>
                            <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                               class="@(controller == "Products" ? "active" : "")">
                                <i class="ti ti-box"></i> Quản lý sản phẩm
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="Artists" asp-action="Index"
                               class="@(controller == "Artists" ? "active" : "")">
                                <i class="ti ti-palette"></i> Quản lý họa sĩ
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="Tags" asp-action="Index"
                               class="@(controller == "Tags" ? "active" : "")">
                                <i class="ti ti-tag"></i> Quản lý thẻ
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="InventoryLogs" asp-action="Index"
                               class="@(controller == "InventoryLogs" ? "active" : "")">
                                <i class="ti ti-building-warehouse"></i> Quản lý kho
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- 3. Bán hàng -->
                <li class="nav-item">
                    <a class="nav-link @(controller == "Orders" || controller == "Payments" || controller == "Refunds" || controller == "Invoices" ? "active" : "")"
                       data-bs-toggle="collapse" href="#orderMenu">
                        <i class="ti ti-shopping-cart"></i>
                        <span class="nav-text">Bán hàng</span>

                        <i class="ti ti-chevron-down ms-auto icon-plus"></i>
                    </a>

                    <ul class="collapse ps-3 @(controller == "Orders" || controller == "Payments" || controller == "Refunds" || controller == "Invoices" ? "show" : "")"
                        id="orderMenu">
                        <li>
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                               class="@(controller == "Orders" ? "active" : "")">
                                <i class="ti ti-receipt"></i> Quản lý đơn hàng
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="Payments" asp-action="Index"
                               class="@(controller == "Payments" ? "active" : "")">
                                <i class="ti ti-credit-card"></i> Quản lý thanh toán
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="Refunds" asp-action="Index"
                               class="@(controller == "Refunds" ? "active" : "")">
                                <i class="ti ti-cash"></i> Quản lý hoàn tiền
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="Invoices" asp-action="Index"
                               class="@(controller == "Invoices" ? "active" : "")">
                                <i class="ti ti-file-invoice"></i> Quản lý hóa đơn
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- 4. Người dùng -->
                <li class="nav-item">
                    <a class="nav-link @(controller == "Users" || controller == "Carts" ? "active" : "")"
                       data-bs-toggle="collapse" href="#userMenu">
                        <i class="ti ti-users"></i>
                        <span class="nav-text">Người dùng</span>

                        <i class="ti ti-chevron-down ms-auto icon-plus"></i>
                    </a>

                    <ul class="collapse ps-3 @(controller == "Users" || controller == "Customers" || controller == "Carts" ? "show" : "")"
                        id="userMenu">
                        <li>
                            <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                               class="@(controller == "Users" ? "active" : "")">
                                <i class="ti ti-user"></i> Quản lý người dùng
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="Customers" asp-action="Index"
                                class="@(controller == "Customers" ? "active" : "")">
                                <i class="ti ti-user-heart"></i> Quản lý khách hàng
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="Carts" asp-action="Index"
                               class="@(controller == "Carts" ? "active" : "")">
                                <i class="ti ti-shopping-cart-plus"></i> Quản lý giỏ hàng
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- 5. Nội dung -->
                <li class="nav-item">
                    <a class="nav-link @(controller == "ProductReviews" || controller == "Blogs" || controller == "BlogCategories" || controller == "BlogComments" || controller == "BlogCommentReplies" ? "active" : "")"
                       data-bs-toggle="collapse" href="#contentMenu">
                        <i class="ti ti-article"></i>
                        <span class="nav-text">Nội dung</span>

                        <i class="ti ti-chevron-down ms-auto icon-plus"></i>
                    </a>

                    <ul class="collapse ps-3 @(controller == "ProductReviews" || controller == "Blogs" || controller == "BlogCategories" || controller == "BlogComments" || controller == "BlogCommentReplies" ? "show" : "")"
                        id="contentMenu">
                        <li>
                            <a asp-area="Admin" asp-controller="ProductReviews" asp-action="Index"
                               class="@(controller == "ProductReviews" ? "active" : "")">
                                <i class="ti ti-star"></i> Đánh giá sản phẩm
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="BlogComments" asp-action="Index"
                               class="@(controller == "BlogComments" || controller == "BlogCommentReplies" ? "active" : "")">
                                <i class="ti ti-message-circle"></i> Bình luận blog
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="Blogs" asp-action="Index"
                               class="@(controller == "Blogs" ? "active" : "")">
                                <i class="ti ti-news"></i> Quản lý blogs
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="BlogCategories" asp-action="Index"
                               class="@(controller == "BlogCategories" ? "active" : "")">
                                <i class="ti ti-folder"></i> Danh mục blog
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- 5.5. Marketplace -->
                <li class="nav-item">
                    <a class="nav-link @(controller == "MarketplacePosts" || controller == "MarketplaceOrders" || controller == "MarketplaceReviews" ? "active" : "")"
                       data-bs-toggle="collapse" href="#marketplaceMenu">
                        <i class="ti ti-building-store"></i>
                        <span class="nav-text">Marketplace</span>

                        <i class="ti ti-chevron-down ms-auto icon-plus"></i>
                    </a>

                    <ul class="collapse ps-3 @(controller == "MarketplacePosts" || controller == "MarketplaceOrders" || controller == "MarketplaceReviews" ? "show" : "")"
                        id="marketplaceMenu">
                        <li>
                            <a asp-area="Admin" asp-controller="MarketplacePosts" asp-action="Index"
                               class="@(controller == "MarketplacePosts" ? "active" : "")">
                                <i class="ti ti-package"></i> Quản lý bài đăng
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="MarketplaceOrders" asp-action="Index"
                               class="@(controller == "MarketplaceOrders" ? "active" : "")">
                                <i class="ti ti-transfer"></i> Quản lý giao dịch
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="MarketplaceReviews" asp-action="Index"
                               class="@(controller == "MarketplaceReviews" ? "active" : "")">
                                <i class="ti ti-star"></i> Đánh giá người bán
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- 6. Hệ thống -->
                <li class="nav-item">
                    <a class="nav-link @(controller == "Notifications" || controller == "ViolationReports" || controller == "Reports" ? "active" : "")"
                       data-bs-toggle="collapse" href="#systemMenu">
                        <i class="ti ti-settings"></i>
                        <span class="nav-text">Hệ thống</span>

                        <i class="ti ti-chevron-down ms-auto icon-plus"></i>
                    </a>

                    <ul class="collapse ps-3 @(controller == "Notifications" || controller == "ViolationReports" || controller == "Reports" ? "show" : "")"
                        id="systemMenu">
                        <li>
                            <a asp-area="Admin" asp-controller="Notifications" asp-action="Index"
                               class="@(controller == "Notifications" ? "active" : "")">
                                <i class="ti ti-bell"></i> Quản lý thông báo
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="ViolationReports" asp-action="Index"
                               class="@(controller == "ViolationReports" ? "active" : "")">
                                <i class="ti ti-flag"></i> Báo cáo vi phạm
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="Reports" asp-action="Index"
                               class="@(controller == "Reports" ? "active" : "")">
                                <i class="ti ti-chart-bar"></i> Báo cáo thống kê
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </aside>

        <!-- NỘI DUNG CHÍNH -->
        <main id="content" class="content py-5">
            @RenderBody()
        </main>

        <!-- jQuery -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        
        <!-- Bootstrap Bundle (Popper included) -->
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

        <!-- Select2 -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

        <!-- SweetAlert2 -->
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <!-- Modular Admin Scripts -->
        <script src="~/assets/js/admin-products.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-blogs.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-blog-comments.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-reviews.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-violations.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-orders.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-users.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-customers.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-tags.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-artists.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-invoices.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-notifications.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-reports.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-refunds.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-marketplace.js" asp-append-version="true"></script>
        <script src="~/assets/js/admin-common.js" asp-append-version="true"></script>
        <!-- main -->
        <script src="~/assets/js/main.js" asp-append-version="true"></script>

        <!-- script từ view -->
        @RenderSection("Scripts", required: false)

        <!-- Global Notifications Handler -->
        <script>
            window.notifications = {
                success: '@Html.Raw(TempData["Success"]?.ToString()?.Replace("'", "\\'"))',
                error: '@Html.Raw(TempData["Error"]?.ToString()?.Replace("'", "\\'"))',
                warning: '@Html.Raw(TempData["Warning"]?.ToString()?.Replace("'", "\\'"))'
            };
        </script>
    </body>
</html>