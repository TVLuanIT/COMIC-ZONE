@using COMICZONE.Extensions;
@using System.Globalization;
@model IEnumerable<COMICZONE.Models.Product>

@{
    ViewBag.Title = "Truyện đã xem gần đây";
}

<section class="py-5">
    <div class="container">
        <div class="d-flex align-items-center mb-4 border-bottom pb-3">
            <h2 class="fw-bold mb-0 me-3">Lịch sử xem truyện của bạn</h2>

            <span class="badge bg-secondary">Truyện từng click</span>
        </div>

        @if (Model != null && Model.Any())
        {
            var itemCount = Model.Count();
            var lgCols = itemCount <= 6 ? itemCount : 6;
            var mdCols = itemCount <= 4 ? itemCount : 4;

            <div class="row row-cols-2 row-cols-md-@mdCols row-cols-lg-@lgCols g-4 justify-content-center">
                @foreach (var item in Model)
                {
                    <div class="col" style="max-width: 280px;">
                        <div class="product-card h-100">
                            <div class="product-img-wrapper" style="aspect-ratio: 2/3; padding: 8px;">
                                @if (item.Price < 50000)
                                {
                                    <span class="product-badge badge-hot" style="top: 10px; left: 10px; padding: 4px 10px; font-size: 0.6rem;">HOT</span>
                                }
                                else if (item.Id % 3 == 0)
                                {
                                    <span class="product-badge badge-new" style="top: 10px; left: 10px; padding: 4px 10px; font-size: 0.6rem;">NEW</span>
                                }

                                <a asp-controller="Products" asp-action="Detail" asp-route-id="@item.Id" class="product-main-img">
                                    <img src="@item.GetImagePath()" alt="@item.Name" loading="lazy" />
                                </a>

                                <div class="product-actions-overlay">
                                    <a asp-controller="Products" asp-action="Detail" asp-route-id="@item.Id" class="action-btn-premium" style="width: 36px; height: 36px; font-size: 1rem; border-radius: 10px;" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </div>
                            <div class="product-content p-2">
                                <a asp-controller="Products" asp-action="Detail" asp-route-id="@item.Id" class="product-title-link text-decoration-none" style="font-size: 0.85rem; margin-bottom: 6px;">
                                    @item.Name
                                </a>
                                <div class="product-price-modern" style="font-size: 0.95rem;">
                                    @string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0}", item.Price) <span style="font-size: 0.8rem;">₫</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- THÊM PAGINATION Ở ĐÂY -->
            <div class="d-flex justify-content-center mt-4">
                @await Html.PartialAsync("_Pagination", (PaginationModel)ViewBag.Pagination)
            </div>
        }
    </div>
</section>
