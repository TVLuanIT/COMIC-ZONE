@model IEnumerable<COMICZONE.Models.Blog>

<!-- TIN TỨC & BLOG -->
<section class="py-5 bg-white overflow-hidden">
    <div class="container">

        <!-- Tiêu đề hiện đại -->
        <div class="section-title-modern">
            <h2 data-aos="fade-up">
                <i class="bi bi-journal-text me-2"></i>Tin Tức & Blog
            </h2>
            <p data-aos="fade-up" data-aos-delay="100">Review truyện nổi bật dành cho fan manga & light novel</p>
        </div>

        @if (Model != null && Model.Any())
        {
            <!-- Swiper Container -->
            <div id="blogSwiper" class="swiper product-swiper" data-aos="fade-up" data-aos-delay="200">
                <div class="swiper-wrapper">
                    @foreach (var blog in Model)
                    {
                        <div class="swiper-slide">
                            <a asp-area="Blogs" asp-action="Details" asp-controller="Blogs" asp-route-id="@blog.Id" class="blog-card-modern">
                                <img src="@blog.Thumbnail" alt="@blog.Title" loading="lazy">
                                <div class="blog-overlay">
                                    <div class="blog-date">Review • @DateTime.Now.ToString("dd/MM/yyyy")</div>
                                    <h3 class="blog-title">@blog.Title</h3>
                                </div>
                            </a>
                        </div>
                    }
                </div>
                <!-- Pagination -->
                <div class="swiper-pagination"></div>
            </div>

            <!-- Xem tất cả -->
            <div class="text-center mt-4" data-aos="fade-up">
                <a asp-area="Blogs" asp-action="Index" asp-controller="Blogs" class="btn-premium-pill">
                    Xem Tất Cả Bài Viết <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        }
        else
        {
            <p class="text-center text-muted mt-4">
                Hiện tại chưa có bài đăng nào. Hãy quay lại sau!
            </p>
        }
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        new Swiper('#blogSwiper', {
            slidesPerView: 1,
            spaceBetween: 30,
            loop: false,
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },
            breakpoints: {
                768: {
                    slidesPerView: 2,
                },
                1024: {
                    slidesPerView: 3,
                },
            },
            autoplay: {
                delay: 6000,
                disableOnInteraction: false,
            },
        });
    });
</script>