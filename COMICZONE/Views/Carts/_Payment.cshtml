@model COMICZONE.Models.Cart

@{
    var customer = TempData["CustomerFullname"] != null
        ? new COMICZONE.Models.Customer
        {
            Fullname = (TempData["CustomerFullname"] as string) ?? "",
            Phone = (TempData["CustomerPhone"] as string) ?? "",
            Address = (TempData["CustomerAddress"] as string) ?? ""
        }
        : (ViewBag.Customer as COMICZONE.Models.Customer ?? new COMICZONE.Models.Customer());

    var errors = TempData["CheckoutErrors"] as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="sidebar-summary-card" data-aos="fade-left">
    <div class="d-flex align-items-center gap-2 mb-4 pb-2 border-bottom">
        <i class="bi bi-credit-card-2-front fs-4 text-danger"></i>
        <h4 class="fw-bold mb-0">Thanh toán</h4>
    </div>
    
    <form asp-controller="Orders" asp-action="Checkout" method="post" id="checkout-form">
        <div class="checkout-form-body mb-4">
            <div class="mb-3">
                <label class="form-label fw-semi-bold small text-uppercase text-muted">Họ và tên</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-person text-muted"></i></span>
                    <input type="text" name="fullname" class="form-control bg-light border-0 py-2" placeholder="Nguyễn Văn A" value="@customer?.Fullname">
                </div>
                @if (errors.ContainsKey("Fullname")) { <small class="text-danger">@errors["Fullname"]</small> }
            </div>

            <div class="mb-3">
                <label class="form-label fw-semi-bold small text-uppercase text-muted">Số điện thoại</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-phone text-muted"></i></span>
                    <input type="text" name="phone" class="form-control bg-light border-0 py-2" placeholder="09xxxxxxxx" value="@customer?.Phone">
                </div>
                @if (errors.ContainsKey("Phone")) { <small class="text-danger">@errors["Phone"]</small> }
            </div>

            <div class="mb-3">
                <label class="form-label fw-semi-bold small text-uppercase text-muted">Địa chỉ nhận hàng</label>
                <textarea name="address" class="form-control bg-light border-0" rows="2" placeholder="Số nhà, đường, phường/xã...">@customer?.Address</textarea>
                @if (errors.ContainsKey("Address")) { <small class="text-danger">@errors["Address"]</small> }
            </div>

            <div class="mb-3">
                <label class="form-label fw-semi-bold small text-uppercase text-muted">Ghi chú</label>
                <textarea name="note" class="form-control bg-light border-0" rows="2" placeholder="Ghi chú cho shop (không bắt buộc)"></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semi-bold small text-uppercase text-muted">Phương thức thanh toán</label>
                
                <!-- Hidden original select for backend & paypal.js compatibility -->
                <select name="paymentMethod" id="payment-method" style="display: none;">
                    <option value="COD">COD</option>
                    <option value="VnPay">VnPay</option>
                    <option value="Paypal">Paypal</option>
                </select>

                <!-- Premium Payment Cards -->
                <div class="payment-method-grid">
                    <div class="payment-card active" data-value="COD">
                        <i class="bi bi-cash-coin"></i>
                        <span>Tiền mặt</span>
                    </div>
                    <div class="payment-card" data-value="VnPay">
                        <i class="bi bi-wallet2"></i>
                        <span>VNPAY</span>
                    </div>
                    <div class="payment-card" data-value="Paypal">
                        <i class="bi bi-paypal"></i>
                        <span>Paypal</span>
                    </div>
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const cards = document.querySelectorAll('.payment-card');
                    const hiddenSelect = document.getElementById('payment-method');

                    cards.forEach(card => {
                        card.addEventListener('click', function() {
                            // Remove active from all
                            cards.forEach(c => c.classList.remove('active'));
                            // Add active to current
                            this.classList.add('active');
                            
                            // Update hidden select
                            const val = this.getAttribute('data-value');
                            hiddenSelect.value = val;
                            
                            // Trigger 'change' event for paypal.js
                            const event = new Event('change');
                            hiddenSelect.dispatchEvent(event);
                        });
                    });
                });
            </script>
        </div>

        <div class="p-3 bg-light rounded-4 mb-4">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Tạm tính:</span>
                <span class="fw-bold">@(Model.CartItems.Sum(i => i.Quantity * (i.Product?.Price ?? 0)).ToString("N0")) ₫</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Phí vận chuyển:</span>
                <span class="text-success fw-bold">Miễn phí</span>
            </div>
            <hr class="my-2 border-secondary opacity-25">
            <div class="d-flex justify-content-between">
                <span class="fw-bold h5 mb-0">TỔNG CỘNG</span>
                <span id="cart-total" class="h5 fw-bold text-danger mb-0">
                    @(Model.CartItems.Sum(i => i.Quantity * (i.Product?.Price ?? 0)).ToString("N0")) ₫
                </span>
            </div>
        </div>

        <!-- PayPal Buttons -->
        <div id="paypal-button-container" class="mb-3" style="display:none;"></div>

        <!-- Submit Button -->
        <button id="default-submit-button" class="btn btn-danger w-100 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
            ĐẶT HÀNG NGAY <i class="bi bi-arrow-right"></i>
        </button>

        <input type="hidden" id="paypalTransactionId" name="PaypalTransactionId" />
        <div class="text-center mt-3">
            <img src="https://img.icons8.com/color/48/000000/visa.png" width="30" class="me-1 opacity-75" />
            <img src="https://img.icons8.com/color/48/000000/mastercard.png" width="30" class="me-1 opacity-75" />
            <img src="https://img.icons8.com/color/48/000000/paypal.png" width="30" class="opacity-75" />
        </div>
    </form>
</div>