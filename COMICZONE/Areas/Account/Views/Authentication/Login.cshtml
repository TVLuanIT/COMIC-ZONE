@{
    ViewBag.Title = "Đăng nhập";
    string returnUrl = ViewBag.ReturnUrl as string
                       ?? Context.Request.Query["returnUrl"].FirstOrDefault()
                       ?? "/";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="auth-section">
    <div class="auth-glass-card" data-aos="zoom-in">
        <div class="text-center mb-4">
            <h1 class="auth-title">Chào mừng trở lại</h1>
            <p class="auth-subtitle">Đăng nhập để khám phá thế giới truyện tranh</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 rounded-4 text-center mb-4 py-3" 
                 style="background: rgba(239, 68, 68, 0.1); color: #ef4444; font-weight: 600;" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
            </div>
        }

        <form asp-action="Login" method="post" asp-antiforgery="true">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            
            <div class="auth-input-group">
                <i class="bi bi-envelope-fill"></i>
                <input type="email" name="email" id="email"
                       class="auth-input" placeholder="Nhập email của bạn"
                       required autocomplete="email" />
            </div>

            <div class="auth-input-group">
                <i class="bi bi-lock-fill"></i>
                <input type="password" name="password" id="password"
                       class="auth-input" placeholder="Nhập mật khẩu"
                       required autocomplete="current-password" />
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4 px-2">
                <div class="form-check">
                    <input type="checkbox" name="rememberMe" id="rememberMe" 
                           class="form-check-input" style="cursor: pointer; background-color: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);">
                    <label for="rememberMe" class="form-check-label text-white-50 small" style="cursor: pointer;">
                        Ghi nhớ đăng nhập
                    </label>
                </div>
                <a href="#" class="small text-white-50 text-decoration-none hover-white">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn-auth-premium">Đăng nhập</button>
        </form>

        <div class="auth-footer-text">
            Chưa có tài khoản? 
            <a asp-controller="Authentication"
               asp-action="Register"
               asp-route-returnUrl="@returnUrl"
               class="auth-link">Đăng ký ngay</a>
        </div>
    </div>
</section>