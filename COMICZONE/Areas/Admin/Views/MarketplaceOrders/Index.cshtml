@model COMICZONE.Areas.Admin.ViewModels.MarketplaceOrderSearchModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Giao dịch Marketplace";
    var orders = ViewBag.Orders as List<COMICZONE.Models.MarketplaceOrder> ?? new();
}

<div class="container-fluid">
    <!-- Breadcrumb & Title -->
    <div class="row page-titles mb-4">
        <div class="col-md-7 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-5 align-self-center text-end">
            <ol class="breadcrumb justify-content-end mb-0 px-0 bg-transparent">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item">Marketplace</li>
                <li class="breadcrumb-item active">Giao dịch</li>
            </ol>
        </div>
    </div>

    <!-- Search Form -->
    <partial name="_OrderSearchForm" model="Model" />

    <!-- Table -->
    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase small fw-bold">
                        <tr class="align-middle">
                            <th class="ps-4">@Html.SortHeader("ID", "id", Model.SortColumn, Model.IsAscending, "orderSearch")</th>
                            <th>Bài đăng</th>
                            <th>@Html.SortHeader("Người mua", "buyer", Model.SortColumn, Model.IsAscending, "orderSearch")</th>
                            <th>@Html.SortHeader("Người bán", "seller", Model.SortColumn, Model.IsAscending, "orderSearch")</th>
                            <th class="text-end">@Html.SortHeader("Giá", "price", Model.SortColumn, Model.IsAscending, "orderSearch")</th>
                            <th class="text-center">@Html.SortHeader("Trạng thái", "status", Model.SortColumn, Model.IsAscending, "orderSearch")</th>
                            <th class="text-center">@Html.SortHeader("Ngày", "createdat", Model.SortColumn, Model.IsAscending, "orderSearch")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (orders.Any())
                        {
                            @foreach (var order in orders)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">#@order.Id</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @{var oImg = order.Post?.MarketplacePostImages?.FirstOrDefault()?.Filename;}
                                            @if (oImg != null)
                                            {
                                                <img src="/images/marketplace/@oImg" class="rounded-1 me-2" width="30" height="30" style="object-fit:cover;" />
                                            }
                                            <span class="text-truncate" style="max-width:150px;" title="@order.Post?.Title">@order.Post?.Title</span>
                                        </div>
                                    </td>
                                    <td>@order.Buyer?.Username</td>
                                    <td>@order.Seller?.Username</td>
                                    <td class="text-end fw-semibold text-success">@order.Price.ToString("N0")đ</td>
                                    <td class="text-center">
                                        @{
                                            var oStatusBadge = order.Status switch {
                                                "Pending" => "bg-warning-subtle text-warning",
                                                "Confirmed" => "bg-info-subtle text-info",
                                                "Completed" => "bg-success-subtle text-success",
                                                "Cancelled" => "bg-danger-subtle text-danger",
                                                _ => "bg-secondary-subtle text-secondary"
                                            };
                                            var oStatusText = order.Status switch {
                                                "Pending" => "Chờ xử lý", "Confirmed" => "Đã xác nhận",
                                                "Completed" => "Hoàn thành", "Cancelled" => "Đã hủy",
                                                _ => order.Status
                                            };
                                        }
                                        <span class="badge rounded-pill @oStatusBadge">@oStatusText</span>
                                    </td>
                                    <td class="text-center small text-muted">@order.Createdat?.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center py-5 text-muted"><i class="ti ti-mood-empty fs-1 d-block mb-2"></i>Không có giao dịch nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top-0 py-3">
                <partial name="~/Areas/Admin/Views/Shared/_AdminPagination.cshtml" model="Model" />
            </div>
        }
    </div>
</div>
