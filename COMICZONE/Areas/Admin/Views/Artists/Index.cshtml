@model IEnumerable<COMICZONE.Models.Artist>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý họa sĩ";
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fs-3">Quản lý họa sĩ</h1>

        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus"></i>
            Thêm họa sĩ
        </a>
    </div>

    <!-- TABLE -->
    <div class="card shadow-sm border-0">
        <div class="table-wrapper">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-uppercase small text-secondary">
                        <th>#</th>
                        <th>Tên họa sĩ</th>
                        <th class="text-center">Số sản phẩm</th>

                        <th class="text-end table-actions">
                            Hành động
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <!-- ID -->
                            <td>
                                <span class="fw-medium">#@item.Id</span>
                            </td>

                            <!-- NAME -->
                            <td>
                                <span class="fw-medium">@item.Name</span>
                            </td>

                            <!-- PRODUCT COUNT -->
                            <td class="text-center">
                                <span class="badge bg-light text-dark border center">
                                    @(item.Products?.Count() ?? 0)
                                </span>
                            </td>

                            <!-- ACTION -->
                            <td class="text-end table-actions">
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light">
                                    <i class="ti ti-edit"></i>
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light">
                                    <i class="ti ti-eye"></i>
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light text-danger">
                                    <i class="ti ti-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>