<div class="premium-content-card" data-aos="fade-up">

    <div class="card-header-premium">
        <h2>Quên mật khẩu</h2>
        <a asp-action="MyProfile" asp-controller="UserProfiles" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-sm btn-link text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i> Quay lại hồ sơ
        </a>
    </div>

    <div class="alert alert-info rounded-4 border-0 mb-4 p-3 d-flex align-items-center">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-primary"></i>
        <span class="small">Nhập email của bạn để nhận link đặt lại mật khẩu. Link sẽ có hiệu lực trong 30 phút.</span>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 py-2 small border-0 mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 py-2 small border-0 mb-4">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    <form asp-action="ForgotPassword" asp-controller="UserProfiles" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="profile-input-group mb-4">
            <label class="profile-input-label">Email tài khoản</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 rounded-start-4 ps-3">
                    <i class="bi bi-envelope text-muted"></i>
                </span>
                <input type="email" name="email" class="form-control profile-input-premium border-start-0 rounded-end-4" placeholder="email@example.com" required />
            </div>
        </div>

        <div class="d-flex gap-3 mt-4 pt-3 border-top border-light">
            <button type="submit" class="btn-auth-premium py-2 px-5 w-auto">Gửi yêu cầu</button>
            <a asp-action="MyProfile" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-outline-secondary rounded-pill py-2 px-5 d-flex align-items-center">Hủy</a>
        </div>

    </form>

</div>