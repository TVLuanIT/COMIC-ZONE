@model List<COMICZONE.Models.Notification>

<div class="profile-content notification-page">

    <h3 class="page-title">🔔 Thông báo của tôi</h3>

    @if (!Model.Any())
    {
        <div class="empty-notification">
            <p>Bạn chưa có thông báo nào.</p>
        </div>
    }
    else
    {
        <div class="notification-wrapper">
            @foreach (var item in Model)
            {
                <a asp-action="ReadNotification"
                   asp-controller="UserProfiles"
                   asp-route-id="@item.NotificationId"
                   class="notification-card @(item.IsRead == true ? "" : "unread")">

                    <div class="notification-icon">
                        📦
                    </div>

                    <div class="notification-body">
                        <div class="notification-title">
                            @item.Title
                        </div>

                        <div class="notification-message">
                            @item.Message
                        </div>

                        <div class="notification-time">
                            @(item.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>