@model COMICZONE.Models.ProductReview
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<form class="edit-review-form d-none mt-3" data-review-id="@Model.Reviewid">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Productid" value="@Model.Productid" />
    <input type="hidden" name="Reviewid" value="@Model.Reviewid" />

    <div class="edit-form-premium-inner mt-2 pt-3 border-top">
        <label class="small fw-bold text-secondary text-uppercase mb-2 d-block">
            <i class="bi bi-pencil-square text-primary me-1"></i> Chỉnh sửa nhận xét
        </label>
        
        <textarea class="form-control premium-textarea mb-3"
                  name="Reviewcontent"
                  rows="3"
                  placeholder="Nhập nội dung mới..."
                  required>@Model.Reviewcontent</textarea>

        <div class="d-flex gap-2 justify-content-end">
            <button type="button" class="btn-premium-cancel cancel-edit px-4 py-2 rounded-pill">
                Hủy bỏ
            </button>
            <button type="submit" class="btn-premium-save px-4 py-2 rounded-pill glass-hover-effect">
                <i class="bi bi-check-lg me-1"></i> Cập nhật
            </button>
        </div>
    </div>
</form>