@model IEnumerable<COMICZONE.Models.MarketplacePost>

@{
    ViewData["Title"] = "Cộng đồng bán đồ cũ (Marketplace)";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nice-select2@2.1.0/dist/css/nice-select2.css">
    <link rel="stylesheet" href="~/marketplace/css/marketplace.css" asp-append-version="true">
}

<div class="marketplace-area">
    <!-- Mesh Background -->
    <div class="mesh-bg"></div>

    <div class="container pt-5 pb-5">
        <!-- Cinematic Header -->
        <div class="marketplace-header text-center mb-5" data-aos="fade-down">
            <h1 class="fw-900 letter-spacing-tight mb-3">
                Comic<span class="text-gradient">Marketplace</span>
            </h1>
            <p class="text-muted fs-5 mb-5 mx-auto" style="max-width: 600px;">
                Khám phá kho tàng truyện tranh, mô hình và phụ kiện từ cộng đồng sưu tầm lớn nhất.
            </p>
            
            <div data-aos="zoom-in" data-aos-delay="200">
                <a href="javascript:void(0)" onclick="handleCreatePostClick()" class="btn-premium-grad">
                    <i class="bi bi-plus-lg fs-5"></i> <span>Đăng bán sản phẩm</span>
                </a>
            </div>
        </div>

        <!-- Floating Search & Filter Bar -->
        <div class="mp-search-container mb-5" data-aos="fade-up" data-aos-delay="300">
            <div class="mp-filter-bar">
                <form method="get" asp-action="Index" id="filterForm" class="row g-0 align-items-center">
                    <!-- Search input -->
                    <div class="col-lg-5">
                        <div class="d-flex align-items-center px-2">
                            <i class="bi bi-search text-primary fs-5 me-3"></i>
                            <input type="text" name="searchTerm" value='@ViewData["CurrentSearch"]' 
                                   class="form-control mp-filter-input border-0 bg-transparent shadow-none" 
                                   placeholder="Bạn đang tìm sản phẩm gì?">
                        </div>
                    </div>

                    <!-- Category Filter -->
                    <div class="col-lg-3 border-start border-opacity-10">
                        <select name="category" class="form-select border-0 bg-transparent fw-600 shadow-none px-4">
                            <option value="">Tất cả danh mục</option>
                            <!option value="Manga" @(ViewData["CurrentCategory"]?.ToString() == "Manga" ? "selected" : "")>Manga</!option>
                            <!option value="Manhua" @(ViewData["CurrentCategory"]?.ToString() == "Manhua" ? "selected" : "")>Manhua</!option>
                            <!option value="Manhwa" @(ViewData["CurrentCategory"]?.ToString() == "Manhwa" ? "selected" : "")>Manhwa</!option>
                            <!option value="Comics" @(ViewData["CurrentCategory"]?.ToString() == "Comics" ? "selected" : "")>Comics</!option>
                            <!option value="Novel" @(ViewData["CurrentCategory"]?.ToString() == "Novel" ? "selected" : "")>Light Novel</!option>
                            <!option value="Anime Goods" @(ViewData["CurrentCategory"]?.ToString() == "Anime Goods" ? "selected" : "")>Phụ kiện</!option>
                            <!option value="Figures" @(ViewData["CurrentCategory"]?.ToString() == "Figures" ? "selected" : "")>Mô hình</!option>
                            <!option value="Others" @(ViewData["CurrentCategory"]?.ToString() == "Others" ? "selected" : "")>Khác</!option>
                        </select>
                    </div>

                    <!-- Sort Filter -->
                    <div class="col-lg-2 border-start border-opacity-10">
                        <select name="sortOrder" class="form-select border-0 bg-transparent fw-600 shadow-none px-4">
                            <!option value="date_desc" @(ViewData["CurrentSort"]?.ToString() == "date_desc" ? "selected" : "")>Mới nhất</!option>
                            <!option value="date_asc" @(ViewData["CurrentSort"]?.ToString() == "date_asc" ? "selected" : "")>Cũ nhất</!option>
                            <!option value="price_asc" @(ViewData["CurrentSort"]?.ToString() == "price_asc" ? "selected" : "")>Giá thấp</!option>
                            <!option value="price_desc" @(ViewData["CurrentSort"]?.ToString() == "price_desc" ? "selected" : "")>Giá cao</!option>
                            <!option value="title_asc" @(ViewData["CurrentSort"]?.ToString() == "title_asc" ? "selected" : "")>Tên A-Z</!option>
                            <!option value="title_desc" @(ViewData["CurrentSort"]?.ToString() == "title_desc" ? "selected" : "")>Tên Z-A</!option>
                        </select>
                    </div>

                    <!-- Action Buttons -->
                    <div class="col-lg-2 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm me-1">
                            <i class="bi bi-funnel-fill"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm rounded-4 px-4 py-3 animate__animated animate__fadeIn mb-5">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            </div>
        }

        <!-- Product Grid -->
        <div class="row g-4 mb-5">
            @if (Model != null && Model.Any())
            {
                int delay = 0;
                @foreach (var post in Model)
                {
                    <div class="col-xl-3 col-lg-4 col-sm-6" data-aos="fade-up" data-aos-delay="@(delay * 50)">
                        <a asp-action="Details" asp-route-id="@post.Id" class="text-decoration-none">
                            <div class="mp-card mp-product-card">
                                <div class="mp-img-wrapper">
                                    <span class="mp-badge-tag shadow-sm">@post.Category</span>
                                    <div class="mp-img-inner shadow-sm">
                                        @if (post.MarketplacePostImages != null && post.MarketplacePostImages.Any())
                                        {
                                            <img src="/uploads/marketplace/@post.MarketplacePostImages.First().Filename" alt="@post.Title">
                                        }
                                        else
                                        {
                                            <img src="/uploads/marketplace/default.png" alt="Default Image">
                                        }
                                    </div>
                                    <div class="position-absolute bottom-0 start-0 w-100 p-4" style="background: linear-gradient(to top, rgba(0,0,0,0.6), transparent); border-radius: 0 0 24px 24px;">
                                         <span class="badge rounded-pill bg-white bg-opacity-25 backdrop-blur text-white small fw-bold px-3 py-2">
                                             <i class="bi bi-info-circle me-1"></i> @post.Condition
                                         </span>
                                    </div>
                                </div>
                                <div class="mp-card-body">
                                    <h5 class="fw-800 text-dark text-truncate-2 mb-3" style="height: 3.2rem; line-height: 1.4; overflow: hidden;">@post.Title</h5>
                                    
                                    <div class="d-flex justify-content-center align-items-center mb-4">
                                        <div class="mp-price-highlight">@string.Format("{0:N0}", post.Price)<span class="small ms-1">₫</span></div>
                                    </div>

                                    <div class="d-flex align-items-center justify-content-between pt-3 border-top border-opacity-10">
                                        <div class="d-flex align-items-center gap-2">
                                            @await Component.InvokeAsync("UserAvatar", new { avatarUrl = post.Seller?.Avatar, size = 32 })
                                            <span class="text-secondary small fw-600">@(post.Seller?.Username ?? "Seller")</span>
                                        </div>
                                        <div class="text-primary fs-5">
                                            <i class="bi bi-arrow-right-circle-fill"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                    delay++;
                }
            }
            else
            {
                <div class="col-12 text-center py-5 glass-card" data-aos="fade-up">
                    <div class="mb-4">
                        <i class="bi bi-search-heart text-primary display-1 opacity-25"></i>
                    </div>
                    <h2 class="fw-900 text-dark">Chưa có sản phẩm nào</h2>
                    <p class="text-secondary fs-5">Hãy là người đầu tiên đăng bán sản phẩm tại đây!</p>
                    <a asp-action="Index" class="btn btn-primary rounded-pill px-5 py-3 mt-3 fw-bold shadow-lg">Làm mới danh sách</a>
                </div>
            }
        </div>

        <div class="d-flex justify-content-center py-5">
            <partial name="_Pagination" model="ViewBag.Pagination" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/nice-select2@2.1.0/dist/js/nice-select2.js"></script>
    <script src="~/marketplace/js/marketplace.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Marketplace.initIndex({
                incompleteProfile: '@Html.Raw(TempData["IncompleteProfile"] ?? "")',
                editProfileUrl: '@Url.Action("EditProfile", "UserProfiles", new { area = "Account" })',
                loginUrl: '@Url.Action("Login", "Authentication", new { area = "Account" })',
                checkProfileUrl: '@Url.Action("CheckProfileStatus", "MarketplacePosts")',
                createPostUrl: '@Url.Action("Create", "MarketplacePosts")'
            });
        });
        
        function handleCreatePostClick() {
            Marketplace.handleCreatePostClick();
        }
    </script>
}
