@model COMICZONE.Models.Refund

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xác nhận xóa hoàn tiền";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Hoàn tiền</a></li>
                    <li class="breadcrumb-item active">Xóa</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold text-danger">
                        <i class="ti ti-trash me-2"></i>Xác nhận xóa bản ghi
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <i class="ti ti-alert-triangle fs-4 me-2"></i>
                        <div>
                            Bạn có chắc chắn muốn xóa yêu cầu hoàn tiền này không? Hành động này không thể hoàn tác.
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Mã hoàn tiền</label>
                            <div class="fw-bold text-dark fs-5">#@Model.Id</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Số tiền</label>
                            <div class="fw-bold text-dark fs-5 text-danger">@string.Format("{0:N0} VNĐ", Model.Amount)</div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Mã thanh toán</label>
                            <div class="text-dark">#@Model.Payment?.Paymentid</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Trạng thái hiện tại</label>
                            <span class="badge bg-light text-dark border px-2 py-1">@Model.Status</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Lý do</label>
                        <div class="text-dark bg-light p-2 rounded border">
                            @(string.IsNullOrEmpty(Model.Reason) ? "Không có lý do." : Model.Reason)
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-4">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">
                                <i class="ti ti-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                                <i class="ti ti-trash me-1"></i> Xác nhận xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
