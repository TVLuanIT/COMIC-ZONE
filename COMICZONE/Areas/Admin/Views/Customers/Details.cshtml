@model COMICZONE.Models.Customer

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="ti ti-user me-2 text-info"></i> Chi tiết hồ sơ khách hàng
            </h4>
            <small class="text-muted">
                Thông tin định danh và địa chỉ của khách hàng #@Model.Customerid
            </small>
        </div>

        <div>
            <a asp-action="Edit" asp-route-id="@Model.Customerid"
               class="btn btn-warning shadow-sm me-2 text-white">
                <i class="ti ti-edit"></i> Chỉnh sửa hồ sơ
            </a>
            <a asp-action="Index"
               class="btn btn-light border shadow-sm">
                <i class="ti ti-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="row g-4">
        <!-- CUSTOMER PROFILE CARD -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">
                    <img src="@Model.User.Avatar.AvatarOrDefault()" 
                         alt="@Model.Fullname" class="rounded-circle border border-5 border-light p-1 shadow-sm mb-3" style="width:150px; height:150px; object-fit:cover;">
                    <h4 class="fw-bold mb-1">@Model.Fullname</h4>
                    <p class="text-muted small mb-3">ID Khách hàng: #@Model.Customerid</p>
                    
                    <div class="d-flex justify-content-center gap-2 mb-4">
                        <span class="badge bg-primary-subtle text-primary px-3 py-2 fw-semibold">
                            <i class="ti ti-user me-1"></i> Khách hàng
                        </span>
                        <span class="badge bg-success-subtle text-success px-3 py-2 fw-semibold">
                            <i class="ti ti-check me-1"></i> Liên kết thành công
                        </span>
                    </div>

                    <div class="border-top pt-4 text-start">
                        <div class="mb-3">
                            <label class="small text-muted text-uppercase fw-bold mb-1 d-block font-xs">Ngày đăng ký</label>
                            <span class="fw-medium">@Model.Createdat.ToString("dd MMMM yyyy, HH:mm")</span>
                        </div>
                        <div class="mb-3">
                            <label class="small text-muted text-uppercase fw-bold mb-1 d-block font-xs">Số điện thoại</label>
                            <span class="fw-bold text-primary">@(Model.Phone ?? "Chưa cung cấp")</span>
                        </div>
                        <div>
                            <label class="small text-muted text-uppercase fw-bold mb-1 d-block font-xs">Email hệ thống</label>
                            <span class="fw-medium">@Model.User.Email</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- LINKED USER ACCOUNT & ADDRESS -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="card-title fw-bold mb-0">Địa chỉ & Giao hàng</h5>
                </div>
                <div class="card-body p-4">
                    <div class="bg-light p-4 rounded-3 border">
                        <div class="d-flex">
                            <div class="icon-box bg-white text-info rounded-circle p-2 shadow-sm me-3 h-fit-content" style="width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-map-pin fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-uppercase small text-muted font-xs">Địa chỉ mặc định</h6>
                                <p class="mb-0 fs-5 lh-base">@(string.IsNullOrEmpty(Model.Address) ? "Khách hàng chưa cung cấp địa chỉ giao hàng mặc định." : Model.Address)</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
                    <h5 class="card-title fw-bold mb-0">Tài khoản liên kết</h5>
                    <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.Userid" class="btn btn-sm btn-outline-info">
                        Xem chi tiết tài khoản <i class="ti ti-external-link ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-4 border-top">
                    <div class="row g-4">
                        <div class="col-md-6 border-end">
                            <label class="small text-muted text-uppercase fw-bold mb-1 d-block font-xs">Tên đăng nhập</label>
                            <div class="fw-bold">@Model.User.Username</div>
                        </div>
                        <div class="col-md-6">
                            <label class="small text-muted text-uppercase fw-bold mb-1 d-block font-xs">Trạng thái tài khoản</label>
                            <div>
                                @if (Model.User.Isdeleted)
                                {
                                    <span class="badge bg-danger">Đã xóa mềm</span>
                                }
                                else if (Model.User.Isactive)
                                {
                                    <span class="badge bg-success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Bị vô hiệu hóa</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="alert alert-info mt-4 rounded-4 border-0 shadow-sm d-flex align-items-center" role="alert">
                <i class="ti ti-info-circle fs-4 me-3"></i>
                <div>
                    Tất cả lịch sử đơn hàng và dữ liệu thanh toán sẽ được truy xuất dựa trên tài khoản người dùng <strong>@Model.User.Username</strong>.
                </div>
            </div>
        </div>
    </div>
</div>
