@model IEnumerable<COMICZONE.Models.MarketplacePost>

@{
    ViewData["Title"] = "Cộng đồng bán đồ cũ (Marketplace)";
}

<div class="container mt-5 pt-4">
    <!-- Header & Action -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h2 class="fw-bold m-0" style="color: var(--primary-color);">Marketplace</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm border-0 d-flex align-items-center" style="background: var(--primary-gradient); padding-top: 0.6rem; padding-bottom: 0.6rem;">
            <i class="bi bi-plus-lg me-1"></i> Đăng bán mới
        </a>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 20px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
        <div class="card-body p-4">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="row g-3">
                    <!-- Search input -->
                    <div class="col-lg-4 col-md-12">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 rounded-start-pill ps-3">
                                <i class="bi bi-search text-primary"></i>
                            </span>
                            <input type="text" name="searchTerm" value='@ViewData["CurrentSearch"]' class="form-control bg-light border-0 rounded-end-pill" placeholder="Bạn đang tìm gì?">
                        </div>
                    </div>

                    <!-- Category dropdown -->
                    <div class="col-lg-2 col-md-4">
                        <select name="category" class="form-select bg-light border-0 rounded-pill px-3">
                            <option value="">Tất cả danh mục</option>
                            <!option value="Manga" @(ViewData["CurrentCategory"]?.ToString() == "Manga" ? "selected" : "")>Manga</!option>
                            <!option value="Manhua" @(ViewData["CurrentCategory"]?.ToString() == "Manhua" ? "selected" : "")>Manhua</!option>
                            <!option value="Manhwa" @(ViewData["CurrentCategory"]?.ToString() == "Manhwa" ? "selected" : "")>Manhwa</!option>
                            <!option value="Comics" @(ViewData["CurrentCategory"]?.ToString() == "Comics" ? "selected" : "")>Comics</!option>
                            <!option value="Novel" @(ViewData["CurrentCategory"]?.ToString() == "Novel" ? "selected" : "")>Light Novel</!option>
                            <!option value="Anime Goods" @(ViewData["CurrentCategory"]?.ToString() == "Anime Goods" ? "selected" : "")>Phụ kiện</!option>
                            <!option value="Figures" @(ViewData["CurrentCategory"]?.ToString() == "Figures" ? "selected" : "")>Mô hình</!option>
                            <!option value="Others" @(ViewData["CurrentCategory"]?.ToString() == "Others" ? "selected" : "")>Khác</!option>
                        </select>
                    </div>

                    <!-- Condition dropdown -->
                    <div class="col-lg-2 col-md-4">
                        <select name="condition" class="form-select bg-light border-0 rounded-pill px-3">
                            <option value="">Mọi tình trạng</option>
                            <!option value="NewLike" @(ViewData["CurrentCondition"]?.ToString() == "NewLike" ? "selected" : "")>Như mới</!option>
                            <!option value="VeryGood" @(ViewData["CurrentCondition"]?.ToString() == "VeryGood" ? "selected" : "")>Rất tốt</!option>
                            <!option value="Good" @(ViewData["CurrentCondition"]?.ToString() == "Good" ? "selected" : "")>Tốt</!option>
                            <!option value="Acceptable" @(ViewData["CurrentCondition"]?.ToString() == "Acceptable" ? "selected" : "")>Chấp nhận được</!option>
                        </select>
                    </div>

                    <!-- Sort order -->
                    <div class="col-lg-2 col-md-4">
                        <select name="sortOrder" class="form-select bg-light border-0 rounded-pill px-3">
                            <!option value="date_desc" @(ViewData["CurrentSort"]?.ToString() == "date_desc" ? "selected" : "")>Mới nhất</!option>
                            <!option value="date_asc" @(ViewData["CurrentSort"]?.ToString() == "date_asc" ? "selected" : "")>Cũ nhất</!option>
                            <!option value="price_asc" @(ViewData["CurrentSort"]?.ToString() == "price_asc" ? "selected" : "")>Giá: Thấp - Cao</!option>
                            <!option value="price_desc" @(ViewData["CurrentSort"]?.ToString() == "price_desc" ? "selected" : "")>Giá: Cao - Thấp</!option>
                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="col-lg-2 col-md-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-3 flex-grow-1 shadow-sm" style="background: var(--primary-gradient); border: none;">
                            <i class="bi bi-filter me-1"></i> Lọc
                        </button>
                        <a asp-action="Index" class="btn btn-light rounded-pill px-3 shadow-sm border-0 d-flex align-items-center justify-content-center" title="Xóa bộ lọc">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>

                    <!-- Price range -->
                    <div class="col-12 mt-3">
                        <div class="d-flex align-items-center flex-wrap gap-3">
                            <span class="small fw-bold text-muted ps-2"><i class="bi bi-cash-coin me-1"></i> Khoảng giá:</span>
                            <div class="d-flex align-items-center gap-2">
                                <input type="number" name="minPrice" value='@ViewData["MinPrice"]' class="form-control form-control-sm bg-light border-0 rounded-pill px-3" placeholder="Tối thiểu" style="width: 130px;">
                                <span class="text-muted small">-</span>
                                <input type="number" name="maxPrice" value='@ViewData["MaxPrice"]' class="form-control form-control-sm bg-light border-0 rounded-pill px-3" placeholder="Tối đa" style="width: 130px;">
                                <span class="text-muted small">VNĐ</span>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3 mb-3 border-0 shadow-sm rounded-4 px-4 py-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var post in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 border-0 shadow-sm card-hover" style="border-radius: 16px; overflow: hidden; transition: transform 0.3s ease;">
                        @if (post.MarketplacePostImages != null && post.MarketplacePostImages.Any())
                        {
                            <img src="/uploads/marketplace/@post.MarketplacePostImages.First().Filename" class="card-img-top" alt="@post.Title" style="height: 220px; object-fit: cover;">
                        }
                        else
                        {
                            <img src="/uploads/marketplace/default.png" class="card-img-top" alt="Default Image" style="height: 220px; object-fit: cover;">
                        }
                        <div class="card-body p-4">
                            <h6 class="card-title fw-bold text-truncate mb-2" title="@post.Title">@post.Title</h6>
                            <p class="card-text text-danger fw-bold mb-3" style="font-size: 1.15rem;">
                                @string.Format("{0:N0} đ", post.Price)
                            </p>
                            <div class="d-flex flex-column gap-1">
                                <span class="text-muted small">
                                    <i class="bi bi-tag me-2"></i>@post.Condition
                                </span>
                                <span class="text-muted small">
                                    <i class="bi bi-person me-2"></i>@(post.Seller?.Username ?? "Ẩn danh")
                                </span>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0 pt-0 p-4">
                            <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-outline-dark w-100 rounded-pill fw-bold py-2">
                                Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="mb-3">
                    <i class="bi bi-box2 text-muted display-1"></i>
                </div>
                <h5 class="text-muted">Hiện chưa có sản phẩm nào được đăng bán.</h5>
                <p class="text-secondary">Hãy trở thành người đầu tiên đăng bán đồ cũ trên Marketplace!</p>
            </div>
        }
    </div>

    @if (ViewBag.Pagination != null)
    {
        <div class="mt-5 d-flex justify-content-center">
            <partial name="_Pagination" model="ViewBag.Pagination" />
        </div>
    }
</div>
