@model IEnumerable<COMICZONE.Models.Refund>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý hoàn tiền";
}

<div class="container-fluid">
    <!-- Breadcrumb & Title -->
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active">Hoàn tiền</li>
                </ol>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
            <h5 class="card-title mb-0 fw-bold">
                <i class="ti ti-cash me-2"></i>Danh sách yêu cầu hoàn tiền
            </h5>
            <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="ti ti-plus me-1"></i>Thêm mới
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã thanh toán</th>
                            <th>Số tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th>Lý do</th>
                            <th class="text-center">Ngày tạo</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-primary">#@item.Payment?.Paymentid</span>
                                    <div class="small text-muted">ID: @item.Id</div>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@string.Format("{0:N0} VNĐ", item.Amount)</span>
                                </td>
                                <td class="text-center">
                                    @{
                                        var status = item.Status?.ToUpper() ?? "PENDING";
                                        var statusClass = status switch
                                        {
                                            "SUCCESS" or "COMPLETED" or "APPROVED" => "bg-success-subtle text-success",
                                            "FAILED" or "REJECTED" or "CANCELLED" => "bg-danger-subtle text-danger",
                                            "PROCESSING" or "PENDING" => "bg-warning-subtle text-warning",
                                            _ => "bg-light text-dark"
                                        };
                                        var statusText = status switch
                                        {
                                            "SUCCESS" or "COMPLETED" or "APPROVED" => "Thành công",
                                            "FAILED" or "REJECTED" or "CANCELLED" => "Thất bại",
                                            "PROCESSING" => "Đang xử lý",
                                            "PENDING" => "Chờ duyệt",
                                            _ => item.Status
                                        };
                                    }
                                    <span class="badge @statusClass px-2 py-1 rounded">
                                        @statusText
                                    </span>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 250px;" title="@item.Reason">
                                        @(string.IsNullOrEmpty(item.Reason) ? "Không có lý do" : item.Reason)
                                    </div>
                                </td>
                                <td class="text-center text-muted">
                                    @(item.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-sm text-info" title="Chi tiết">
                                            <i class="ti ti-eye fs-5"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm text-primary" title="Chỉnh sửa">
                                            <i class="ti ti-edit fs-5"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm text-danger" title="Xóa">
                                            <i class="ti ti-trash fs-5"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="ti ti-note-off fs-1 text-muted mb-2"></i>
                    <p class="text-muted">Chưa có dữ liệu hoàn tiền.</p>
                </div>
            }
        </div>
    </div>
</div>
