@model IEnumerable<COMICZONE.Models.Invoice>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý hóa đơn";
    var searchModel = ViewBag.SearchModel as COMICZONE.Areas.Admin.ViewModels.AdminSearchModel ?? new COMICZONE.Areas.Admin.ViewModels.AdminSearchModel();
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h3 class="text-themecolor fw-bold">
                <i class="ti ti-file-invoice me-2 text-primary"></i>@ViewData["Title"]
            </h3>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active">Hóa đơn</li>
                </ol>
            </nav>
        </div>
    </div>
    
    @* Reusable search form *@
    <partial name="_AdminSearchForm" model="searchModel" />

    <!-- Main Content Card -->
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold">Danh sách hóa đơn điện tử</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-nowrap">
                    <thead class="table-light border-bottom fw-bold text-uppercase small">
                        <tr class="align-middle">
                            <th class="ps-4">
                                @Html.SortHeader("Mã hóa đơn", "Id", searchModel.SortColumn ?? "IssueDate", searchModel.IsAscending, searchModel.Keyword, null, null, null)
                            </th>
                            <th>
                                @Html.SortHeader("Đơn hàng", "OrderId", searchModel.SortColumn ?? "IssueDate", searchModel.IsAscending, searchModel.Keyword, null, null, null)
                            </th>
                            <th>
                                @Html.SortHeader("Khách hàng", "CustomerName", searchModel.SortColumn ?? "IssueDate", searchModel.IsAscending, searchModel.Keyword, null, null, null)
                            </th>
                            <th class="text-center">
                                @Html.SortHeader("Ngày xuất", "IssueDate", searchModel.SortColumn ?? "IssueDate", searchModel.IsAscending, searchModel.Keyword, null, null, null)
                            </th>
                            <th class="text-end">
                                @Html.SortHeader("Tổng tiền", "TotalAmount", searchModel.SortColumn ?? "IssueDate", searchModel.IsAscending, searchModel.Keyword, null, null, null)
                            </th>
                            <th class="text-center">
                                @Html.SortHeader("Hiển thị", "Isdeleted", searchModel.SortColumn ?? "IssueDate", searchModel.IsAscending, searchModel.Keyword, null, null, null)
                            </th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr id="invoice-row-@item.Id" class="align-middle @(item.Isdeleted ? "bg-light text-muted opacity-75" : "")">
                                <td class="ps-4 fw-bold text-dark">#@item.Id</td>

                                <td>
                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@item.OrderId" 
                                       class="badge bg-primary-subtle text-primary border border-primary-subtle text-decoration-none px-2 py-1">
                                        <i class="ti ti-shopping-cart-check me-1"></i>Đơn #@item.OrderId
                                    </a>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="symbol symbol-circle symbol-30px me-3">
                                            @if (item.Order?.User != null)
                                            {
                                                <img src="@item.Order.User.GetDisplayAvatar()"
                                                     alt="@item.Order.User.Username" class="rounded-circle border" style="width:32px; height:32px; object-fit:cover;">
                                            }
                                            else
                                            {
                                                <div class="bg-light-secondary text-secondary rounded-circle border d-flex align-items-center justify-content-center" style="width:32px; height:32px;">
                                                    <i class="ti ti-user fs-6"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="text-dark fw-semibold small">@item.CustomerName</div>
                                    </div>
                                </td>
                                
                                <td class="text-muted small">
                                    @(item.IssueDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                </td>
                                
                                <td class="fw-bold text-dark">
                                    @string.Format("{0:N0}", item.TotalAmount) <span class="small opacity-75">₫</span>
                                </td>

                                <td id="soft-delete-status-cell-@item.Id">
                                    @if (item.Isdeleted)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2">
                                            <i class="ti ti-eye-off me-1 small"></i> Ẩn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2">
                                            <i class="ti ti-eye me-1 small"></i> Hiện
                                        </span>
                                    }
                                </td>

                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-sm text-success" title="In hóa đơn">
                                            <i class="ti ti-printer fs-5"></i>
                                        </a>
                                        
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-sm text-info" title="Xem chi tiết">
                                            <i class="ti ti-eye fs-5"></i>
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm text-primary" title="Chỉnh sửa">
                                            <i class="ti ti-edit fs-5"></i>
                                        </a>
                                            
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm text-danger" title="Xóa vĩnh viễn">
                                            <i class="ti ti-trash fs-5"></i>
                                        </a>

                                        <button type="button"
                                                class="btn btn-light btn-sm ajax-toggle-invoice-status @(item.Isdeleted ? "text-success" : "text-danger")"
                                                data-id="@item.Id"
                                                data-url="@Url.Action("ToggleDelete", "Invoices", new { area = "Admin" })"
                                                title="@(item.Isdeleted ? "Khôi phục" : "Ẩn")">
                                            <i class="ti @(item.Isdeleted ? "ti-refresh" : "ti-ban") fs-5"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="bg-light-subtle rounded-circle p-4 d-inline-block mb-3 border">
                        <i class="ti ti-file-off fs-1 text-muted"></i>
                    </div>
                    <p class="text-muted fw-semibold">Chưa có dữ liệu hóa đơn.</p>
                    <small class="text-muted opacity-75">Hóa đơn sẽ tự động xuất hiện khi đơn hàng được thanh toán hoặc xác nhận.</small>
                </div>
            }
        </div>
    </div>
    
    @if (Model.Any())
    {
        <div class="card-footer bg-white border-top-0 pb-4">
            <partial name="_AdminPagination" model="searchModel" />
        </div>
    }
</div>
