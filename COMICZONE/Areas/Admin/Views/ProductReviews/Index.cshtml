@using COMICZONE.Helpers;

@model IEnumerable<COMICZONE.Models.ProductReview>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý đánh giá";
    var searchModel = ViewBag.SearchModel as COMICZONE.Areas.Admin.ViewModels.AdminSearchModel ?? new COMICZONE.Areas.Admin.ViewModels.AdminSearchModel();
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h3 class="text-themecolor fw-bold">
                <i class="ti ti-star me-2 text-primary"></i>Quản lý đánh giá
            </h3>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active">Đánh giá</li>
                </ol>
            </nav>
        </div>
    </div>

    @* Reusable search form *@
    <partial name="_AdminSearchForm" model="searchModel" />

    <!-- TABLE -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="align-middle">
                        <th>
                            @Html.SortHeader("Rating", "Rating", searchModel.SortColumn ?? "Createdat", searchModel.IsAscending, searchModel.Keyword, searchModel.StatusFilter)
                        </th>
                        <th class="text-center">
                            @Html.SortHeader("Trạng thái", "Isdeleted", searchModel.SortColumn ?? "Createdat", searchModel.IsAscending, searchModel.Keyword, searchModel.StatusFilter)
                        </th>
                        <th>
                            @Html.SortHeader("Nội dung", "Reviewcontent", searchModel.SortColumn ?? "Createdat", searchModel.IsAscending, searchModel.Keyword, searchModel.StatusFilter)
                        </th>
                        <th>
                            @Html.SortHeader("Sản phẩm", "Product.Name", searchModel.SortColumn ?? "Createdat", searchModel.IsAscending, searchModel.Keyword, searchModel.StatusFilter)
                        </th>
                        <th>
                            @Html.SortHeader("Người dùng", "User.Username", searchModel.SortColumn ?? "Createdat", searchModel.IsAscending, searchModel.Keyword, searchModel.StatusFilter)
                        </th>
                        <th>
                            @Html.SortHeader("Ngày tạo", "Createdat", searchModel.SortColumn ?? "Createdat", searchModel.IsAscending, searchModel.Keyword, searchModel.StatusFilter)
                        </th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr id="review-row-@item.Reviewid" class="align-middle @(item.Isdeleted ? "bg-light text-muted opacity-75" : "")">
                            <!-- RATING -->
                            <td>
                                <span class="badge bg-warning text-dark">
                                    @item.Rating ★
                                </span>
                            </td>

                            <!-- STATUS -->
                            <td>
                                <span id="status-cell-@item.Reviewid">
                                    @if (item.Isdeleted)
                                    {
                                        <span class="badge bg-danger">Đã ẩn</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Hiển thị</span>
                                    }
                                </span>
                            </td>

                            <!-- CONTENT -->
                            <td style="max-width: 300px;">
                                <span class="text-truncate d-inline-block" style="max-width: 280px;">
                                    @item.Reviewcontent
                                </span>
                            </td>

                            <!-- PRODUCT -->
                            <td>
                                @Html.Raw(item.Product != null
                                    ? OrderHelper.GetProductCell(item.Product)
                                    : "<span class='text-muted'>N/A</span>")
                            </td>

                            <!-- USER -->
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.User?.Username
                                </span>
                            </td>

                            <!-- DATE -->
                            <td>
                                <small class="text-muted">
                                    @item.Createdat?.ToString("dd/MM/yyyy")
                                </small>
                            </td>

                            <!-- ACTION -->
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Reviewid"
                                       class="btn btn-sm btn-light"
                                       title="Xem chi tiết">
                                        <i class="ti ti-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Reviewid"
                                       class="btn btn-sm btn-primary"
                                       title="Chỉnh sửa">
                                        <i class="ti ti-edit"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Reviewid"
                                       class="btn btn-sm btn-danger"
                                       title="Xóa vĩnh viễn">
                                        <i class="ti ti-trash"></i>
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm ajax-toggle-review-status @(item.Isdeleted ? "btn-success" : "btn-outline-danger")"
                                            data-id="@item.Reviewid"
                                            data-url="@Url.Action("ToggleDelete", "ProductReviews", new { area = "Admin" })"
                                            title="@(item.Isdeleted ? "Hiện đánh giá" : "Ẩn đánh giá")">
                                        <i class="ti @(item.Isdeleted ? "ti-refresh" : "ti-ban")"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div> <!-- card-body closed -->

        @if (Model.Any())
        {
            <div class="card-footer bg-white border-top-0 pb-4">
                <partial name="_AdminPagination" model="searchModel" />
            </div>
        }
    </div> <!-- card closed -->
</div> <!-- container-fluid closed -->