@model COMICZONE.Models.Refund

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết hoàn tiền";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Hoàn tiền</a></li>
                    <li class="breadcrumb-item active">Chi tiết</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="ti ti-info-circle me-2 text-info"></i>Thông tin hoàn tiền #@Model.Id
                    </h5>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm rounded-pill px-3">
                        <i class="ti ti-edit me-1"></i> Chỉnh sửa
                    </a>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Mã thanh toán</label>
                            <div class="d-flex align-items-center">
                                <i class="ti ti-credit-card fs-4 me-2 text-primary"></i>
                                <span class="fw-bold text-dark fs-5">#@Model.Payment?.Paymentid</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Số tiền hoàn</label>
                            <div class="d-flex align-items-center">
                                <i class="ti ti-coin fs-4 me-2 text-success"></i>
                                <span class="fw-bold text-dark fs-5">@string.Format("{0:N0} VNĐ", Model.Amount)</span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Trạng thái</label>
                            @{
                                var status = Model.Status?.ToUpper() ?? "PENDING";
                                var statusClass = status switch
                                {
                                    "SUCCESS" or "COMPLETED" or "APPROVED" => "bg-success-subtle text-success",
                                    "FAILED" or "REJECTED" or "CANCELLED" => "bg-danger-subtle text-danger",
                                    "PROCESSING" or "PENDING" => "bg-warning-subtle text-warning",
                                    _ => "bg-light text-dark"
                                };
                                var statusText = status switch
                                {
                                    "SUCCESS" or "COMPLETED" or "APPROVED" => "Thành công",
                                    "FAILED" or "REJECTED" or "CANCELLED" => "Thất bại",
                                    "PROCESSING" => "Đang xử lý",
                                    "PENDING" => "Chờ duyệt",
                                    _ => Model.Status
                                };
                            }
                            <span class="badge @statusClass px-3 py-2 rounded fs-6">
                                @statusText
                            </span>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Ngày tạo</label>
                            <div class="text-dark">
                                <i class="ti ti-calendar-plus me-1 text-muted"></i>
                                @(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4 border-top pt-4">
                        <div class="col-md-12">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Lý do hoàn tiền</label>
                            <div class="bg-light p-3 rounded border">
                                @(string.IsNullOrEmpty(Model.Reason) ? "Không có lý do được cung cấp." : Model.Reason)
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-start align-items-center border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">
                            <i class="ti ti-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
