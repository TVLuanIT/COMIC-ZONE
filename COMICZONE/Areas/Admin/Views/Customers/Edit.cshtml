@model COMICZONE.Models.Customer

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa khách hàng";
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="ti ti-edit me-2 text-warning"></i> Chỉnh sửa khách hàng
            </h4>
            <small class="text-muted">
                Cập nhật thông tin chi tiết cho khách hàng #@Model.Customerid
            </small>
        </div>

        <a asp-action="Index"
           class="btn btn-light border shadow-sm">
            <i class="ti ti-arrow-left"></i> Quay lại
        </a>
    </div>

    <!-- CARD -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Customerid" />

                <div class="row g-4">
                    <!-- USER INFO (Read-only or Link) -->
                    <div class="col-md-6 text-center text-md-start">
                        <div class="d-flex align-items-center mb-3">
                            <img src="@Model.User.Avatar.AvatarOrDefault()" 
                                 class="rounded-circle border p-1" style="width: 80px; height: 80px; object-fit: cover;" />
                            <div class="ms-3">
                                <h5 class="mb-0 fw-bold">Tài khoản liên kết</h5>
                                <p class="text-muted mb-0 small">@Model.User.Username (@Model.User.Email)</p>
                                <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.Userid" class="btn btn-sm btn-link p-0 text-decoration-none small">
                                    Xem tài khoản <i class="ti ti-external-link"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- USER SELECTION (Hidden or Read-only) -->
                    <div class="col-md-6">
                        <label asp-for="Userid" class="form-label fw-semibold">ID Tài khoản</label>
                        <select asp-for="Userid" class="form-select bg-light" asp-items="ViewBag.Userid" disabled></select>
                        <input type="hidden" asp-for="Userid" />
                        <span asp-validation-for="Userid" class="text-danger small"></span>
                        <div class="form-text small">Tài khoản liên kết không thể thay đổi sau khi tạo.</div>
                    </div>

                    <div class="col-12 border-top pt-3"></div>

                    <!-- FULLNAME -->
                    <div class="col-md-6">
                        <label asp-for="Fullname" class="form-label fw-semibold">Họ và tên</label>
                        <input asp-for="Fullname" class="form-control" />
                        <span asp-validation-for="Fullname" class="text-danger small"></span>
                    </div>

                    <!-- PHONE -->
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold">Số điện thoại</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="ti ti-phone"></i></span>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <!-- CREATED AT -->
                    <div class="col-md-6">
                        <label asp-for="Createdat" class="form-label fw-semibold">Ngày đăng ký hồ sơ</label>
                        <input asp-for="Createdat" class="form-control" type="datetime-local" value="@Model.Createdat.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="Createdat" class="text-danger small"></span>
                    </div>

                    <!-- ADDRESS -->
                    <div class="col-md-12">
                        <label asp-for="Address" class="form-label fw-semibold">Địa chỉ giao hàng</label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>

                <!-- BUTTONS -->
                <div class="mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm me-2">
                        <i class="ti ti-device-floppy me-1"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
