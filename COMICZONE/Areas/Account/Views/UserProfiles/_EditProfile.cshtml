@model COMICZONE.Models.Customer

<div class="premium-content-card" data-aos="fade-up">

    <div class="card-header-premium">
        <h2>Chỉnh sửa hồ sơ</h2>
        <a asp-action="MyProfile" asp-controller="UserProfiles" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-sm btn-link text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <form asp-action="EditProfile" asp-controller="UserProfiles" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Customerid" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="profile-input-group">
                    <label class="profile-input-label">Họ tên</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-4 ps-3">
                            <i class="bi bi-person text-muted"></i>
                        </span>
                        <input asp-for="Fullname" class="form-control profile-input-premium border-start-0 rounded-end-4" placeholder="Nhập họ tên" />
                    </div>
                    <span asp-validation-for="Fullname" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="profile-input-group">
                    <label class="profile-input-label">Email (Không thể thay đổi)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-4 ps-3">
                            <i class="bi bi-envelope text-muted"></i>
                        </span>
                        <input value="@Model.User?.Email" class="form-control profile-input-premium border-start-0 rounded-end-4 bg-light" readonly />
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="profile-input-group">
                    <label class="profile-input-label">Số điện thoại</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-4 ps-3">
                            <i class="bi bi-phone text-muted"></i>
                        </span>
                        <input asp-for="Phone" class="form-control profile-input-premium border-start-0 rounded-end-4" placeholder="Nhập số điện thoại" />
                    </div>
                    <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="profile-input-group">
                    <label class="profile-input-label">Địa chỉ</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-4 ps-3">
                            <i class="bi bi-geo-alt text-muted"></i>
                        </span>
                        <input asp-for="Address" class="form-control profile-input-premium border-start-0 rounded-end-4" placeholder="Nhập địa chỉ" />
                    </div>
                    <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-3 mt-4 pt-3 border-top border-light">
            <button type="submit" class="btn-auth-premium py-2 px-5 w-auto">Lưu thay đổi</button>
            <a asp-action="MyProfile" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-outline-secondary rounded-pill py-2 px-5 d-flex align-items-center">Hủy</a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}