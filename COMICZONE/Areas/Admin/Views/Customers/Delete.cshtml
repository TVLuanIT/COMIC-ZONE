@model COMICZONE.Models.Customer

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa khách hàng";
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-danger mb-1">
                <i class="ti ti-trash me-2"></i> Xóa khách hàng
            </h4>
            <small class="text-muted">
                Xác nhận thao tác xóa hồ sơ khách hàng khỏi hệ thống
            </small>
        </div>

        <a asp-action="Index"
           class="btn btn-light border shadow-sm">
            <i class="ti ti-arrow-left"></i> Quay lại
        </a>
    </div>

    <!-- MAIN CONTENT -->
    <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-danger text-white py-3 border-bottom-0">
                    <h5 class="card-title fw-bold mb-0 text-center"><i class="ti ti-alert-triangle me-2"></i> CẢNH BÁO: XÓA KHÁCH HÀNG</h5>
                </div>
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <img src="@Model.User.Avatar.AvatarOrDefault()" 
                             alt="@Model.Fullname" class="rounded-circle border border-5 border-light p-1 shadow-sm mb-3" style="width:120px; height:120px; object-fit:cover;">
                        <h4 class="fw-bold mb-1 text-dark">Bạn có chắc chắn muốn xóa khách hàng này?</h4>
                        <p class="text-muted">Mọi thông liên quan đến hồ sơ khách hàng sẽ bị gỡ bỏ. Tài khoản người dùng vẫn sẽ tồn tại nhưng không còn thông tin khách hàng.</p>
                    </div>

                    <div class="bg-light p-4 rounded-3 border mb-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="small text-muted text-uppercase fw-bold mb-1 d-block font-xs">Họ và tên</label>
                                <div class="fw-bold">@Model.Fullname</div>
                            </div>
                            <div class="col-md-6">
                                <label class="small text-muted text-uppercase fw-bold mb-1 d-block font-xs">ID Khách hàng</label>
                                <div class="fw-bold">#@Model.Customerid</div>
                            </div>
                            <div class="col-md-6">
                                <label class="small text-muted text-uppercase fw-bold mb-1 d-block font-xs">Số điện thoại</label>
                                <div class="fw-medium">@(Model.Phone ?? "Chưa cung cấp")</div>
                            </div>
                            <div class="col-md-6">
                                <label class="small text-muted text-uppercase fw-bold mb-1 d-block font-xs">Tài khoản liên kết</label>
                                <div class="fw-medium text-primary">@Model.User.Username</div>
                            </div>
                            <div class="col-12 border-top pt-3 mt-3">
                                <label class="small text-muted text-uppercase fw-bold mb-1 d-block font-xs">Địa chỉ giao hàng</label>
                                <p class="mb-0 small">@(string.IsNullOrEmpty(Model.Address) ? "Không có địa chỉ." : Model.Address)</p>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-danger rounded-3 border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
                         <i class="ti ti-info-circle fs-4 me-3"></i>
                         <div class="small">
                             <strong>Lưu ý:</strong> Hành động này <b>KHÔNG THỂ</b> hoàn tác. Nếu khách hàng có đơn hàng hoặc lịch sử giao dịch liên quan, việc xóa hồ sơ trực tiếp này có thể gây lỗi dữ liệu (Foreign Key Constraints). Hãy cân nhắc <b>Kích hoạt/Vô hiệu hóa</b> tài khoản thay vì xóa hồ sơ.
                         </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Customerid" />
                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-danger btn-lg px-5 shadow-sm fw-bold">
                                <i class="ti ti-trash-x me-2"></i> Xác nhận xóa ngay
                            </button>
                            <a asp-action="Index" class="btn btn-light btn-lg px-5 border shadow-sm fw-bold">
                                Hủy bỏ & Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="text-center">
                <p class="text-muted small">Mẹo: Bạn có thể vào <a asp-controller="Users" asp-action="Index" class="text-decoration-none">Quản lý người dùng</a> để vô hiệu hóa tài khoản này thay vì xóa hẳn.</p>
            </div>
        </div>
    </div>
</div>
