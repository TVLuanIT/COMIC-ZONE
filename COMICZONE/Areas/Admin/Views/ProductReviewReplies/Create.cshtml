@model COMICZONE.Models.ProductReviewReply

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm phản hồi";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-success mb-0">
            <i class="ti ti-message-plus me-2"></i> Thêm phản hồi
        </h4>

        <a asp-controller="ProductReviews"
           asp-action="Details"
           asp-route-id="@ViewBag.ReviewId"
           class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg" style="border-radius:16px;">
                <div class="card-body p-4">
                    <form asp-area="Admin"
                          asp-controller="ProductReviewReplies"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Reviewid" value="@ViewBag.ReviewId" />
                        <input type="hidden" asp-for="Parentreplyid" value="@ViewBag.ParentReplyId" />
                        <input type="hidden" asp-for="Replytouserid" value="@ViewBag.ParentReplyUserId" />
                        <input type="hidden"
                               asp-for="Userid"
                               value="@Context.Session.GetString("UserId")" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="fw-semibold mb-2">Nội dung phản hồi</label>

                            <textarea asp-for="Replycontent"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Nhập nội dung phản hồi..."></textarea>
                            <span asp-validation-for="Replycontent" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="ProductReviews"
                               asp-action="Details"
                               asp-route-id="@ViewBag.ReviewId"
                               class="btn btn-light px-4">Hủy</a>

                            <button type="submit" class="btn btn-success px-4 shadow-sm">
                                <i class="ti ti-send me-1"></i> Gửi phản hồi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}