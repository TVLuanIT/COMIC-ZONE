@model COMICZONE.Models.BlogComment

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa bình luận blog";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-7 align-self-center">
            <h4 class="text-themecolor text-danger">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-5 align-self-center text-end">
            <ol class="breadcrumb justify-content-end mb-0 px-0 bg-transparent">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="BlogComments" asp-action="Index">Bình luận blog</a></li>
                <li class="breadcrumb-item active">Xóa</li>
            </ol>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm border-danger border-0">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="ti ti-alert-triangle me-2"></i>Xác nhận xóa vĩnh viễn</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger border-0">
                        <i class="ti ti-alert-circle me-2"></i>
                        <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác. Tất cả phản hồi và lượt thích liên quan sẽ bị xóa.
                    </div>

                    <table class="table table-borderless mb-0">
                        <tr>
                            <th class="text-muted" style="width: 150px;">ID</th>
                            <td class="fw-bold">#@Model.Id</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Bài viết</th>
                            <td class="fw-bold">@Model.Blog?.Title</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Người dùng</th>
                            <td>
                                <div class="fw-bold">@Model.User?.Username</div>
                                <div class="small text-muted">@Model.User?.Email</div>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Nội dung</th>
                            <td>@Model.Content</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Ngày tạo</th>
                            <td>@Model.Createdat.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Trạng thái</th>
                            <td>
                                @if (Model.Isdeleted == true)
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">Đã ẩn</span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">Hiển thị</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Dữ liệu liên quan</th>
                            <td>
                                <span class="badge bg-light text-dark">@(Model.BlogCommentReplies?.Count ?? 0) phản hồi</span>
                                <span class="badge bg-light text-dark">@(Model.BlogCommentLikes?.Count ?? 0) lượt thích</span>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="card-footer bg-white d-flex gap-2">
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="ti ti-trash me-1"></i>Xóa vĩnh viễn
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
                        <i class="ti ti-arrow-left me-1"></i>Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
