@{
    ViewData["Title"] = "Về chúng tôi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<!-- CINEMATIC ABOUT HERO -->
<div class="about-modern-hero" data-aos="zoom-out" data-aos-duration="1200">
    <div class="container hero-container-premium">
        <div class="hero-content-wrapper text-center">
            <span class="hero-badge mb-4" data-aos="fade-up" data-aos-delay="200">
                <i class="bi bi-stars me-2"></i>Chặng Đường 10 Năm
            </span>
            <h1 class="about-hero-title mb-3" data-aos="fade-up" data-aos-delay="400">
                Comic<span class="text-gradient-primary">Zone</span>
            </h1>
            <p class="about-hero-subtitle mb-5" data-aos="fade-up" data-aos-delay="600">
                Nơi những giấc mơ được vẽ nên từ hàng triệu khung tranh và những trái tim nồng cháy.
            </p>
            <div class="scroll-indicator-premium" data-aos="fade-up" data-aos-delay="800">
                <i class="bi bi-chevron-double-down animate-bounce fs-2 text-white"></i>
            </div>
        </div>
    </div>
</div>

<div class="container my-5 py-5">
    <!-- CÂU CHUYỆN (Story section with Glass Card) -->
    <div class="row align-items-center mb-5 pb-5 mt-n5">
        <div class="col-lg-6 mb-5 mb-lg-0" data-aos="fade-right">
            <div class="position-relative premium-image-reveal">
                <div class="glass-panel p-2 overflow-hidden shadow-premium" style="border-radius: 40px;">
                    <div class="parallax-img-container" style="height: 500px; overflow: hidden; border-radius: 32px;">
                        <img src="~/images/about_hero_bg.png" class="img-fluid w-100 h-100" 
                             style="object-fit: cover; transition: transform 0.8s ease;" 
                             onmouseover="this.style.transform='scale(1.05)'" 
                             onmouseout="this.style.transform='scale(1)'"
                             alt="Câu chuyện ComicZone">
                    </div>
                </div>
                <!-- Interactive Floating Medal -->
                <div class="position-absolute top-100 start-100 translate-middle d-none d-lg-block">
                    <div class="glass-panel p-4 floating-element" style="border-radius: 25px;">
                        <div class="text-center">
                            <i class="bi bi-trophy-fill fs-1 text-gradient-primary"></i>
                            <div class="fw-800 small mt-2">BEST STORE</div>
                            <div class="text-muted small">Since 2014</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 ps-lg-5" data-aos="fade-left">
            <h6 class="text-uppercase fw-800 text-primary mb-3 ls-2">OUR JOURNEY</h6>
            <h2 class="display-4 fw-900 mb-4">Hành Trình <span class="text-gradient-primary">Thắp Sáng</span> Đam Mê</h2>
            <p class="lead text-secondary mb-4" style="line-height: 1.8;">
                ComicZone không chỉ là một sàn thương mại điện tử, mà là một cộng đồng - nơi mọi Otaku và fan Comic đều tìm thấy ngôi nhà thứ hai của mình.
            </p>
            <p class="text-muted mb-5">
                Chúng tôi bắt đầu từ một cửa hàng nhỏ ở TP. Long Xuyên, với niềm tin rằng kiến thức và nghệ thuật từ truyện tranh có sức mạnh thay đổi thế giới quan của con người. Sau hơn một thập kỷ, chúng tôi tự hào là đối tác chiến lược của những nhà xuất bản lớn nhất Việt Nam và quốc tế.
            </p>
            
            <div class="row g-4 pt-4 border-top border-light">
                <div class="col-4">
                    <h3 class="fw-900 text-gradient-primary mb-1">10K+</h3>
                    <small class="text-muted text-uppercase fw-800 small ls-1">Bộ truyện</small>
                </div>
                <div class="col-4 border-start">
                    <h3 class="fw-900 text-gradient-primary mb-1">50K+</h3>
                    <small class="text-muted text-uppercase fw-800 small ls-1">Giao dịch</small>
                </div>
                <div class="col-4 border-start">
                    <h3 class="fw-900 text-gradient-primary mb-1">99%</h3>
                    <small class="text-muted text-uppercase fw-800 small ls-1">Hài lòng</small>
                </div>
            </div>
        </div>
    </div>

    <!-- SỨ MỆNH (Full Width Glass Panel) -->
    <div class="glass-panel text-center my-5 py-5 premium-glow-section" data-aos="fade-up">
        <div class="py-4">
            <h6 class="text-uppercase fw-800 text-primary mb-3 ls-2">PRINCIPLES</h6>
            <h2 class="display-5 fw-900 mb-4">Tầm Nhìn & <span class="text-gradient-primary">Sứ Mệnh</span></h2>
            <p class="text-secondary mx-auto mb-5" style="max-width: 700px;">
                Kiến tạo một hệ sinh thái văn hóa đọc hiện đại, nơi mọi độc giả đều có quyền tiếp cận với những tác phẩm bản quyền chất lượng nhất.
            </p>
            
            <div class="row g-4 px-lg-5">
                <div class="col-md-4" data-aos="zoom-in" data-aos-delay="100">
                    <div class="p-4 rounded-4 luxury-card">
                        <div class="premium-icon-box mb-4">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                        <h4 class="fw-800 mb-3">Chất Lượng Thật</h4>
                        <p class="text-muted small">Từng trang giấy, từng bìa truyện đều được kiểm soát gắt gao theo tiêu chuẩn Nhật Bản.</p>
                    </div>
                </div>
                <div class="col-md-4" data-aos="zoom-in" data-aos-delay="200">
                    <div class="p-4 rounded-4 luxury-card">
                        <div class="premium-icon-box mb-4">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>
                        <h4 class="fw-800 mb-3">Tâm Huyết</h4>
                        <p class="text-muted small">Phục vụ khách hàng với tinh thần "Omotenashi" - luôn đặt trải nghiệm độc giả lên hàng đầu.</p>
                    </div>
                </div>
                <div class="col-md-4" data-aos="zoom-in" data-aos-delay="300">
                    <div class="p-4 rounded-4 luxury-card">
                        <div class="premium-icon-box mb-4">
                            <i class="bi bi-rocket-takeoff-fill"></i>
                        </div>
                        <h4 class="fw-800 mb-3">Đột Phá</h4>
                        <p class="text-muted small">Áp dụng công nghệ AR/VR vào việc trải nghiệm chọn lọc truyện tại hệ thống offline.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .about-modern-hero {
        position: relative;
        overflow: hidden;
    }

    .ls-2 { letter-spacing: 2px; }
    .ls-1 { letter-spacing: 1px; }
    .fw-800 { font-weight: 800; }
    .fw-900 { font-weight: 900; }
    
    .floating-element {
        animation: float 4s ease-in-out infinite;
        box-shadow: 0 20px 50px rgba(99, 102, 241, 0.2);
    }

    @@keyframes float {
        0%, 100% { transform: translate(-50%, -50%) translateY(0); }
        50% { transform: translate(-50%, -50%) translateY(-15px); }
    }

    .luxury-card {
        background: rgba(255, 255, 255, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.5);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .luxury-card:hover {
        background: #fff;
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    }

    .premium-icon-box {
        width: 65px;
        height: 65px;
        background: var(--primary-gradient);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: white;
        margin: 0 auto;
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
    }

    .mt-n5 { margin-top: -3rem; }
    
    @@media (max-width: 991px) {
        .mt-n5 { margin-top: 0; }
        .about-hero-title { font-size: 3.5rem; }
    }
</style>