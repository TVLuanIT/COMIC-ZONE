@model COMICZONE.Models.MarketplacePost

@{
    ViewData["Title"] = "Quảng cáo Bài đăng";
}

@section Styles {
    <style>
        .promotion-container {
            max-width: 600px;
            margin: auto;
        }

        .promo-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 15px 35px rgba(0,0,0,0.05);
            border-radius: 20px;
            overflow: hidden;
        }

        .promo-header {
            background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
            color: #fff;
            padding: 30px 20px;
            text-align: center;
        }

        .range-wrap {
            position: relative;
            margin: 30px 0;
            width: 100%;
        }

        input[type=range].promo-slider {
            -webkit-appearance: none;
            width: 100%;
            background: transparent;
        }

        input[type=range].promo-slider:focus {
            outline: none;
        }

        input[type=range].promo-slider::-webkit-slider-runnable-track {
            width: 100%;
            height: 10px;
            cursor: pointer;
            animate: 0.2s;
            box-shadow: 0px 0px 0px #000000;
            background: #ffe3e3;
            border-radius: 5px;
            border: 1px solid #ffcdcd;
        }

        input[type=range].promo-slider::-webkit-slider-thumb {
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
            border: 2px solid #fff;
            height: 25px;
            width: 25px;
            border-radius: 50%;
            background: #FF6B6B;
            cursor: pointer;
            -webkit-appearance: none;
            margin-top: -8.5px;
            transition: transform 0.1s;
        }

        input[type=range].promo-slider::-webkit-slider-thumb:hover {
            transform: scale(1.1);
        }

        .price-display-wrapper {
            background: #f8f9fc;
            padding: 20px;
            border-radius: 12px;
            border-left: 4px solid #FF6B6B;
        }

        .btn-vnpay {
            background-color: #0050A3;
            color: white;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .btn-vnpay:hover {
            background-color: #003e80;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 80, 163, 0.3);
        }

        .payment-options {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 30px;
        }
    </style>
}

<div class="container my-5 pt-5 promotion-container" data-aos="fade-up">
    <div class="promo-card">
        <div class="promo-header">
            <i class="bi bi-megaphone fs-1 mb-2 d-block"></i>
            <h3 class="fw-bold mb-1" style="font-family: 'Outfit', sans-serif;">Gói Quảng Cáo Sản Phẩm</h3>
            <p class="mb-0 text-white-50">Tiếp cận hàng ngàn khách hàng tiềm năng</p>
        </div>

        <div class="p-4 p-md-5">
            <div class="mb-4 text-center">
                <span class="badge bg-light text-dark shadow-sm px-3 py-2 mb-3 border border-secondary rounded-pill">
                    <i class="bi bi-box me-1"></i> @Model.Title
                </span>
                <p class="text-muted mb-0">Điều chỉnh thanh trượt bên dưới để chọn số ngày bạn muốn hiển thị bài đăng ưu tiên ở vị trí nổi bật.</p>
            </div>

            <div class="range-wrap px-3">
                <input type="range" class="promo-slider w-100" min="1" max="30" step="1" id="promotionDays" value="3">
            </div>

            <div class="price-display-wrapper mt-4 d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-1">Thời gian</div>
                    <div class="fs-4 fw-black text-dark" style="font-family: 'Outfit', sans-serif;" id="daysDisplay">3 Ngày</div>
                </div>
                <div class="text-end">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Tổng tiền</div>
                    <div class="fs-3 fw-black text-danger" style="font-family: 'Outfit', sans-serif;" id="priceDisplay">30,000 ₫</div>
                </div>
            </div>

            <form id="vnpayForm" asp-action="CreatePromotionPayment_VnPay" method="post" style="display:none;">
                <input type="hidden" name="postId" value="@Model.Id" />
                <input type="hidden" name="days" id="vnpayDays" value="3" />
            </form>

            @Html.AntiForgeryToken()

            <div class="payment-options mt-5">
                <p class="text-center text-muted fw-bold small mb-2 text-uppercase letter-spacing-1">Chọn phương thức thanh toán</p>
                
                <button type="button" class="btn btn-vnpay w-100 py-3 rounded-3 fw-bold fs-5 border-0" onclick="document.getElementById('vnpayForm').submit();">
                    <i class="bi bi-wallet2 me-2"></i> Thanh toán bằng VNPAY
                </button>

                <div class="position-relative mt-2">
                    <div class="position-absolute top-50 w-100 border-top" style="z-index: 1;"></div>
                    <div class="position-relative text-center" style="z-index: 2;">
                        <span class="bg-white px-3 text-muted small fw-bold">HOẶC</span>
                    </div>
                </div>

                <div id="paypal-button-container" class="mt-2 w-100" style="min-height: 45px;"></div>
            </div>
            
            <div class="text-center mt-4">
                <a asp-action="MyPosts" class="text-decoration-none text-secondary small fw-bold transition-smooth hover-primary">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại Danh sách
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (!string.IsNullOrEmpty(ViewBag.PaypalClientId))
    {
        <script src="https://www.paypal.com/sdk/js?client-id=@ViewBag.PaypalClientId"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const slider = document.getElementById('promotionDays');
                const daysDisplay = document.getElementById('daysDisplay');
                const priceDisplay = document.getElementById('priceDisplay');
                const vnpayDays = document.getElementById('vnpayDays');
                const rate = 10000;

                slider.addEventListener('input', function () {
                    const days = parseInt(this.value);
                    daysDisplay.innerText = days + " Ngày";
                    priceDisplay.innerText = (days * rate).toLocaleString('vi-VN') + " ₫";
                    vnpayDays.value = days;
                });

                paypal.Buttons({
                    style: {
                        shape: 'rect',
                        color: 'gold',
                        layout: 'horizontal',
                        label: 'paypal',
                        height: 50
                    },
                    createOrder: function (data, actions) {
                        return fetch('/Marketplace/MarketplacePosts/CreatePaypalPromotion', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify({
                                postId: @Model.Id,
                                days: parseInt(slider.value)
                            })
                        }).then(function (res) {
                            return res.json();
                        }).then(function (orderData) {
                            if (orderData.id) {
                                return orderData.id;
                            } else {
                                Swal.fire('Lỗi', 'Có lỗi xảy ra khi tạo đơn hàng PayPal', 'error');
                            }
                        });
                    },
                    onApprove: function (data, actions) {
                        // Wait UI
                        Swal.fire({
                            title: 'Đang xử lý thanh toán...',
                            allowEscapeKey: false,
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });

                        return fetch('/Marketplace/MarketplacePosts/CapturePaypalPromotion?orderID=' + data.orderID, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            }
                        }).then(function (res) {
                            return res.json();
                        }).then(function (orderData) {
                            if (orderData.success) {
                                window.location.href = '/Marketplace/MarketplacePosts/MyPosts';
                            } else {
                                Swal.fire('Lỗi', 'Giao dịch Paypal chưa được hệ thống ghi nhận hoàn tất.', 'error');
                            }
                        }).catch(function(err) {
                            Swal.fire('Lỗi', 'Giao dịch Paypal chưa được hệ thống ghi nhận hoàn tất.', 'error');
                        });
                    },
                    onError: function (err) {
                        console.error(err);
                        Swal.fire('Lỗi', 'Thanh toán bị huỷ hoặc xảy ra lỗi kết nối.', 'error');
                    }
                }).render('#paypal-button-container');
            });
        </script>
    }
}
