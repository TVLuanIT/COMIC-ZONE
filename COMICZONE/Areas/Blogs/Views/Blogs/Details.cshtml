@model COMICZONE.Models.Blog
@using COMICZONE.Extensions

@{
    ViewData["Title"] = Model.Title;
}

<!-- READING PROGRESS BAR -->
<div class="reading-progress-container">
    <div class="reading-progress-bar" id="readingProgress"></div>
</div>

<!-- PREMIUM ARTICLE HEADER -->
<div class="article-hero" style="background-image: url('@(string.IsNullOrEmpty(Model.Thumbnail) ? "/blogs/images/default-blog.png" : (Model.Thumbnail.StartsWith("http") ? Model.Thumbnail : "/uploads/blogs/" + Model.Thumbnail))');">
    <div class="hero-glass-overlay"></div>
    <div class="container position-relative z-index-3">
        <div class="row justify-content-center">
            <div class="col-lg-10 text-center">
                <div class="breadcrumb-glass mb-4" data-aos="fade-down">
                    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                    <span class="sep">/</span>
                    <a asp-area="Blogs" asp-controller="Home" asp-action="Index">Blog</a>
                    <span class="sep">/</span>
                    <span class="active">Bài viết</span>
                </div>
                
                <div class="category-badges mb-4" data-aos="zoom-in" data-aos-delay="200">
                    @foreach(var cat in Model.Categories)
                    {
                        <span class="badge-glass">@cat.Name</span>
                    }
                </div>

                <h1 class="article-hero-title mb-5" data-aos="fade-up" data-aos-delay="300">@Model.Title</h1>
                
                <div class="author-info-glass d-flex align-items-center justify-content-center" data-aos="fade-up" data-aos-delay="400">
                    <img src="@(Model.Author?.Avatar.AvatarOrDefault())" alt="Author" class="author-avatar me-3">
                    <div class="text-start">
                        <div class="fw-bold text-dark small">@(Model.Author?.Username ?? "Admin")</div>
                        <div class="text-muted x-small">@Model.Createdat.ToString("MMMM dd, yyyy") • 5 min read</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center g-5">
            <!-- ARTICLE CONTENT -->
            <div class="col-lg-8 blog-main-column" data-aos="fade-up">
                <div class="article-excerpt">
                    <i class="bi bi-quote fs-1 text-primary-light"></i>
                    <p style="white-space: pre-line;">@Model.Shortdescription</p>
                </div>

                <div class="article-body lh-lg" style="white-space: pre-line;">
                    @Html.Raw(Model.Content)
                </div>

                <!-- SHARE BAR -->
                <div class="article-footer-tools d-flex justify-content-between align-items-center mt-5 py-4 border-top border-bottom">
                    <div class="tags-list">
                         <span class="fw-bold text-uppercase small text-muted me-3">Tags:</span>
                         @if (Model.Categories != null && Model.Categories.Any())
                         {
                             foreach(var cat in Model.Categories)
                             {
                                 <span class="badge bg-light text-secondary rounded-pill px-3">@cat.Name</span>
                             }
                         }
                    </div>
                    <div class="share-group d-flex gap-2">
                        <a href="#" class="share-icon fb"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="share-icon tw"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="share-icon link"><i class="bi bi-link-45deg"></i></a>
                    </div>
                </div>

                <!-- COMMENTS SECTION -->
                @await Html.PartialAsync("_BlogComments", Model)
            </div>

            <!-- SIDEBAR DETAILS -->
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 110px;">
                    <div class="sidebar-card-premium p-4 mb-4">
                        <h6 class="fw-bold mb-3 d-flex align-items-center"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Có thể bạn thích</h6>
                        @if (ViewBag.RelatedBlogs != null)
                        {
                            foreach (var related in (IEnumerable<COMICZONE.Models.Blog>)ViewBag.RelatedBlogs)
                            {
                                <a asp-area="Blogs" asp-controller="Blogs" asp-action="Details" asp-route-id="@related.Id" class="related-item d-flex gap-3 mb-4 text-decoration-none">
                                    <img src="@(string.IsNullOrEmpty(related.Thumbnail) ? "/blogs/images/default-blog.png" : (related.Thumbnail.StartsWith("http") ? related.Thumbnail : "/uploads/blogs/" + related.Thumbnail))" class="related-thumb">
                                    <div>
                                        <h6 class="related-title text-dark line-clamp-2">@related.Title</h6>
                                        <span class="x-small text-muted">@related.Createdat.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </a>
                            }
                        }
                    </div>

                    <div class="p-5 rounded-4 text-center" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                         <img src="/images/logo-nobg.png" style="width: 80px;" class="mb-3 opacity-75">
                         <h5 class="text-white fw-bold">COMICZONE</h5>
                         <p class="x-small text-white-50">Chuyên cung cấp truyện tranh bản quyền chất lượng nhất.</p>
                         <a asp-area="" asp-controller="Products" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-4 mt-2">Ghé thăm Shop</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/blogs/css/blogs-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/blogs/css/blogs-widgets.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/blogs/js/blogs-details.js" asp-append-version="true"></script>
}
