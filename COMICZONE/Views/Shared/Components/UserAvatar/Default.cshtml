<img src="@(string.IsNullOrEmpty(ViewData["AvatarUrl"]?.ToString()) ? "/uploads/avatar/default-avatar.png" : ViewData["AvatarUrl"])"
     alt="avatar"
     class="avatar-img"
     style="--avatar-size:@(ViewData["Size"])px;"
     onerror="this.onerror=null;this.src='/uploads/avatar/default-avatar.png';" />