@model COMICZONE.Models.BlogComment

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa bình luận blog";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-7 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-5 align-self-center text-end">
            <ol class="breadcrumb justify-content-end mb-0 px-0 bg-transparent">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="BlogComments" asp-action="Index">Bình luận blog</a></li>
                <li class="breadcrumb-item active">Chỉnh sửa</li>
            </ol>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="ti ti-edit me-2"></i>Chỉnh sửa bình luận #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <!-- Info -->
                    <div class="bg-light rounded p-3 mb-4">
                        <div class="row">
                            <div class="col-md-6">
                                <small class="text-muted text-uppercase fw-bold">Bài viết</small>
                                <div class="fw-bold">@Model.Blog?.Title</div>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted text-uppercase fw-bold">Người dùng</small>
                                <div class="fw-bold">@Model.User?.Username <span class="text-muted small">(@Model.User?.Email)</span></div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Blogid" />
                        <input type="hidden" asp-for="Userid" />
                        <input type="hidden" asp-for="Createdat" />

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-bold">Nội dung bình luận</label>
                            <textarea asp-for="Content" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Trạng thái</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="Isdeleted" value="true" @(Model.Isdeleted == true ? "checked" : "") id="isDeletedSwitch">
                                <label class="form-check-label" for="isDeletedSwitch">
                                    <span class="text-danger fw-bold">Ẩn bình luận</span>
                                </label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i>Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="ti ti-arrow-left me-1"></i>Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
