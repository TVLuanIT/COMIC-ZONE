<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ComicZone Blog</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@700;800;900&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons & AOS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <!-- Bootstrap CSS (included in the workspace usually, assuming it's available as it's a standard ASP.NET Core project) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Modular Blogs CSS -->
    <link rel="stylesheet" href="~/blogs/css/blogs-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/blogs/css/blogs-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/blogs/css/blogs-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/blogs/css/blogs-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/blogs/css/blogs-widgets.css" asp-append-version="true" />
    
    @if (ViewContext.RouteData.Values["area"]?.ToString() == "Account")
    {
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    }
    
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    
    <!-- PREMIUM NAVIGATION -->
    <nav class="blogs-nav" id="mainNav">
        <div class="nav-brand">
            <a asp-area="Blogs" asp-controller="Home" asp-action="Index">
                <i class="bi bi-mask text-primary"></i>COMIC<span class="text-gradient">ZONE</span>
            </a>
        </div>
        <ul class="nav-links">
            <li><a asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li><a asp-area="Blogs" asp-controller="Home" asp-action="Index" class="active">Blog</a></li>
            <li><a href="#featured-section">Nổi bật</a></li>
            <li><a href="#latest">Mới nhất</a></li>
        </ul>
        <div class="nav-actions d-none d-md-block">
            <partial name="_LoginPartial" />
        </div>
        
        <!-- Mobile Toggle -->
        <button class="btn d-md-none text-dark fs-2" type="button" id="mobileMenuBtn">
            <i class="bi bi-list"></i>
        </button>
    </nav>

    <!-- MAIN CONTENT AREA -->
    @{
        var isAccountArea = ViewContext.RouteData.Values["area"]?.ToString() == "Account";
    }
    <main role="main" class="@(isAccountArea ? "main-content-premium" : "")">
        @RenderBody()
    </main>

    <!-- PREMIUM FOOTER -->
    <footer class="blogs-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4" data-aos="fade-up">
                    <span class="footer-logo"><i class="bi bi-mask text-primary me-2"></i>COMICZONE</span>
                    <p class="footer-text pe-lg-5">Nơi hội tụ đam mê Manga & Light Novel. Cập nhật những tin tức, review sâu sắc và chất lượng nhất từ cộng đồng truyện tranh Việt Nam.</p>
                    <div class="social-icons mt-4">
                        <a href="#" class="social-circle"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-circle"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="social-circle"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4" data-aos="fade-up" data-aos-delay="100">
                    <h6 class="footer-heading">Khám phá</h6>
                    <ul class="footer-links">
                        <li><a href="#">Review Truyện</a></li>
                        <li><a href="#">Tin Tức Manga</a></li>
                        <li><a href="#">Light Novel</a></li>
                        <li><a href="#">Cộng Đồng</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-4" data-aos="fade-up" data-aos-delay="200">
                    <h6 class="footer-heading">Thông tin</h6>
                    <ul class="footer-links">
                        <li><a href="#">Về ComicZone</a></li>
                        <li><a href="#">Liên Hệ</a></li>
                        <li><a href="#">Điều Khoản</a></li>
                        <li><a href="#">Bảo Mật</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-4" data-aos="fade-up" data-aos-delay="300">
                    <h6 class="footer-heading">Bản tin ComicZone</h6>
                    <p class="footer-text x-small">Đừng bỏ lỡ những bài viết hay nhất được gửi trực tiếp đến email của bạn hằng tuần.</p>
                    <div class="footer-input-group mt-3">
                        <input type="text" placeholder="Email của bạn...">
                        <button class="btn btn-primary px-4 rounded-pill"><i class="bi bi-send-fill"></i></button>
                    </div>
                </div>
            </div>
            <div class="border-top border-dark-subtle mt-5 pt-4 text-center">
                <p class="footer-text x-small mb-0">© 2026 ComicZone. Designed with <i class="bi bi-heart-fill text-danger mx-1"></i> for the community.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    
    <script>
        // Init AOS
        AOS.init({
            duration: 1000,
            once: true,
            offset: 100
        });

        // Navbar Scroll Effect
        window.addEventListener('scroll', function() {
            const nav = document.getElementById('mainNav');
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
