@model COMICZONE.Models.InventoryLog

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa nhật ký";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Nhật ký kho</a></li>
                    <li class="breadcrumb-item active">Chỉnh sửa</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold"><i class="ti ti-edit me-2"></i>Cập nhật thông tin nhật ký</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="mb-3">
                            <label asp-for="ProductId" class="form-label fw-bold">Sản phẩm</label>
                            <select asp-for="ProductId" class="form-select select2" asp-items="ViewBag.ProductId"></select>
                            <span asp-validation-for="ProductId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChangeAmount" class="form-label fw-bold">Số lượng thay đổi</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-hash"></i></span>
                                <input asp-for="ChangeAmount" class="form-control" />
                            </div>
                            <small class="text-muted"><i class="ti ti-info-circle me-1"></i>Nhập kho (+), Xuất kho (-)</small>
                            <span asp-validation-for="ChangeAmount" class="text-danger small d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Loại giao dịch</label>
                            <select name="Type" id="logType" class="form-select no-select2">
                                <option value="Import" selected="@(Model.Type == "Import" ? "selected" : null)">Nhập kho (+)</option>
                                <option value="Export" selected="@(Model.Type == "Export" ? "selected" : null)">Xuất kho (-)</option>
                            </select>
                            <span asp-validation-for="Type" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CreatedAt" class="form-label fw-bold">Ngày tạo</label>
                            <input asp-for="CreatedAt" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" value="@(Model.CreatedAt?.ToString("yyyy-MM-ddTHH:mm"))" />
                            <span asp-validation-for="CreatedAt" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">
                                <i class="ti ti-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="ti ti-device-floppy me-1"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if (typeof $.fn.select2 === 'function') {
                // ProductId dropdown - dùng select2 có tìm kiếm
                $('.select2').select2({
                    theme: 'bootstrap-5',
                    width: '100%'
                });

                // Loại giao dịch - select2 không có ô tìm kiếm (chỉ 2 options)
                $('#logType').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    minimumResultsForSearch: Infinity
                });
            }
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

