@model int

@if (Model > 0)
{
    <span class="cart-badge notification-badge-total" style="background: #ef4444; position: static; transform: none; display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; font-size: 0.7rem;">
        @(Model > 99 ? "99+" : Model.ToString())
    </span>
}
