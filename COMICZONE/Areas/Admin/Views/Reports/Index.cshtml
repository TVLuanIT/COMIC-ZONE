@model COMICZONE.ViewModels.Admin.Reports.DashboardSummaryViewModel

@{
    ViewData["Title"] = "Báo cáo & Thống kê";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<div class="container-fluid">
    <div class="row align-items-center mb-6">
        <div class="col-lg-6 col-12">
            <h1 class="fs-3 mb-1">Thống kê kinh doanh</h1>
            <p class="text-secondary mb-0">Tổng quan về hiệu quả bán hàng và quản trị hệ thống.</p>
        </div>
        <div class="col-lg-6 col-12 text-lg-end mt-3 mt-lg-0">
            <div class="d-flex flex-wrap justify-content-lg-end gap-2">
                <div class="dropdown">
                    <button id="btnQuickFilter" class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="ti ti-clock-hour-4 me-1"></i> Chọn nhanh
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item quick-filter" href="#" data-days="7">7 ngày qua</a></li>
                        <li><a class="dropdown-item quick-filter" href="#" data-days="14">14 ngày qua</a></li>
                        <li><a class="dropdown-item quick-filter" href="#" data-days="30">30 ngày qua (1 tháng)</a></li>
                        <li><a class="dropdown-item quick-filter" href="#" data-days="60">60 ngày qua (2 tháng)</a></li>
                    </ul>
                </div>
                <div class="input-group input-group-sm w-auto">
                    <span class="input-group-text bg-white border-end-0"><i class="ti ti-calendar"></i></span>
                    <input type="text" id="dateRangePicker" class="form-control bg-white border-start-0" placeholder="Chọn ngày..." style="width: 220px;">
                </div>
                <button id="btnExport" class="btn btn-sm btn-success d-inline-flex align-items-center">
                    <i class="ti ti-file-spreadsheet me-1"></i> Xuất Excel
                </button>
            </div>
        </div>
    </div>

    <!-- HÀNG THẺ THỐNG KÊ NHANH -->
    <div class="row g-3 mb-6">
        <div class="col-xl-3 col-lg-6 col-md-12 col-12">
            <div class="card h-100 card-lift">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-semi-bold text-uppercase fs-6">Tổng doanh thu</span>
                        <div class="icon-shape icon-md bg-light-primary text-primary rounded-2">
                             <i class="ti ti-currency-dollar fs-4"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-1">@Model.TotalRevenue.ToString("N0") ₫</h2>
                    <span class="text-success fw-semi-bold"><i class="ti ti-trending-up me-1"></i>+@Model.RevenueGrowth%</span>
                    <span class="ms-1 text-secondary">so với tháng trước</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-12 col-12">
            <div class="card h-100 card-lift">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-semi-bold text-uppercase fs-6">Tổng đơn hàng</span>
                         <div class="icon-shape icon-md bg-light-info text-info rounded-2">
                             <i class="ti ti-shopping-cart fs-4"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-1">@Model.TotalOrders</h2>
                    <span class="text-info fw-semi-bold">@Model.PendingOrders</span>
                    <span class="ms-1 text-secondary">đơn đang chờ duyệt</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-12 col-12">
            <div class="card h-100 card-lift">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-semi-bold text-uppercase fs-6">Khách hàng</span>
                        <div class="icon-shape icon-md bg-light-success text-success rounded-2">
                             <i class="ti ti-users fs-4"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-1">@Model.TotalUsers</h2>
                    <span class="ms-1 text-secondary">người dùng đã đăng ký</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-12 col-12">
            <div class="card h-100 card-lift">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-semi-bold text-uppercase fs-6">Sản phẩm</span>
                        <div class="icon-shape icon-md bg-light-warning text-warning rounded-2">
                             <i class="ti ti-box fs-4"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-1">@Model.TotalProducts</h2>
                    <span class="ms-1 text-secondary">comic trong danh mục</span>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG BIỂU ĐỒ -->
    <div class="row g-3">
        <div class="col-xl-8 col-12">
            <div class="card h-100 border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-white py-4 d-flex justify-content-between align-items-center border-bottom-0">
                    <h4 class="mb-0">Doanh thu</h4>
                    <span id="salesChartTitle" class="badge bg-light-primary text-primary">7 ngày qua</span>
                </div>
                <div class="card-body position-relative" style="height: 350px;">
                    <div id="salesLoading" class="chart-loader">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                    <canvas id="salesChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-12">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white py-4 border-bottom-0">
                    <h4 class="mb-0">Trạng thái đơn hàng</h4>
                </div>
                <div class="card-body d-flex flex-column justify-content-center position-relative" style="height: 350px;">
                    <div id="statusLoading" class="chart-loader">
                        <div class="spinner-border text-info" role="status"></div>
                    </div>
                    <div id="noDataAlert" class="text-center d-none py-10">
                        <i class="ti ti-database-off fs-1 text-muted mb-2 d-block"></i>
                        <p class="text-muted">Chưa có dữ liệu đơn hàng</p>
                    </div>
                    <canvas id="orderStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>

    <script>
        // Hàm này sẽ được admin.js gọi khi DOM ready
        window.initReports = function() {
            if (typeof ReportsDashboard === 'function') {
                ReportsDashboard().init({
                    sales: '@Url.Action("GetSalesChartData", "Reports", new { area = "Admin" })',
                    status: '@Url.Action("GetOrderStatusData", "Reports", new { area = "Admin" })',
                    export: '@Url.Action("ExportToExcel", "Reports", new { area = "Admin" })'
                });
            }
        };
    </script>
}
