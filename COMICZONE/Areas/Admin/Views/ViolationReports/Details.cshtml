@model COMICZONE.Models.ViolationReport
@using COMICZONE.Models.Enums

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết báo cáo";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">

        <!-- Header -->
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">📋 Chi tiết báo cáo #@Model.Id</h5>
            <a asp-action="Index" class="btn btn-light btn-sm">⬅ Quay lại</a>
        </div>

        <!-- Body -->
        <div class="card-body">

            <div class="row g-4">

                <!-- Loại -->
                <div class="col-md-6">
                    <label class="text-muted small">Loại</label><br />
                    <span class="badge px-3 py-2 rounded-pill fw-semibold
                        @(Model.Reporttype == (int)ReportType.Review ? "bg-primary-subtle text-primary" : "bg-success-subtle text-success")">
                        @(Model.Reporttype == (int)ReportType.Review ? "Review" : "Reply")
                    </span>
                </div>

                <!-- Đối tượng -->
                <div class="col-md-6">
                    <label class="text-muted small">Đối tượng</label><br />
                    <strong>
                        @(Model.Reporttype == (int)ReportType.Review
                                                ? $"Review #{Model.Targetid}"
                                                : $"Reply #{Model.Targetid}")
                    </strong>
                </div>

                <!-- Trạng thái -->
                <div class="col-md-6">
                    <label class="text-muted small">Trạng thái</label><br />
                    <span class="badge px-3 py-2 rounded-pill fw-semibold
                        @(Model.Status == (int)ReportStatus.Pending ? "bg-warning-subtle text-warning" :
                                                    Model.Status == (int)ReportStatus.Approved ? "bg-success-subtle text-success" :
                                                    "bg-danger-subtle text-danger")">
                        @((ReportStatus)Model.Status)
                    </span>
                </div>

                <!-- Ngày -->
                <div class="col-md-6">
                    <label class="text-muted small">Ngày gửi</label><br />
                    <span>@Model.Createdat.ToString("dd/MM/yyyy HH:mm")</span>
                </div>

                <!-- Người gửi -->
                <div class="col-md-6">
                    <label class="text-muted small">Người gửi</label><br />
                    <strong>@Model.User?.Username</strong>
                </div>

                <!-- Đã xóa -->
                <div class="col-md-6">
                    <label class="text-muted small">Trạng thái dữ liệu</label><br />
                    @if (Model.Isdeleted)
                    {
                        <span class="badge bg-danger-subtle text-danger px-3 py-2">Đã xóa</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success px-3 py-2">Còn</span>
                    }
                </div>

                <!-- Lý do -->
                <div class="col-12">
                    <label class="text-muted small">Lý do</label>
                    <div class="p-3 border rounded-3 bg-light mt-1">
                        @Model.Reason
                    </div>
                </div>

            </div>

        </div>

        <!-- Footer -->
        <div class="card-footer text-end bg-white">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                ✏️ Chỉnh sửa
            </a>
        </div>

    </div>
</div>