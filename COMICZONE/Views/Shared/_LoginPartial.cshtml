@using Microsoft.AspNetCore.Http.Extensions;

@{
    var username = Context.Session.GetString("Username");
    var avatar = Context.Session.GetString("Avatar");
}

<ul class="navbar-nav">
    @if (!string.IsNullOrEmpty(username))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center"
               href="#"
               data-bs-toggle="dropdown">

            <div class="me-2 position-relative">
                @await Component.InvokeAsync("UserAvatar",
                new { avatarUrl = avatar, size = 35 })
                @await Component.InvokeAsync("UnreadNotificationCount")
            </div>

            @username
        </a>

        <ul class="dropdown-menu dropdown-menu-end premium-dropdown shadow-lg animate slideIn">
            <li>
                <a class="premium-dropdown-item"
                   asp-area="Account"
                   asp-controller="UserProfiles"
                   asp-action="MyProfile"
                   asp-route-returnUrl="@(Context.Request.Path.Value + Context.Request.QueryString.Value)">
                    <i class="bi bi-person-circle me-2"></i>
                    <span>Trang cá nhân</span>
                </a>
            </li>

            <li><hr class="dropdown-divider opacity-10"></li>

            <li>
                <form asp-area="Account"
                      asp-controller="Authentication"
                      asp-action="Logout"
                      asp-route-returnUrl="@(Context.Request.Path.Value + Context.Request.QueryString.Value)"
                      method="post">
                    <button type="submit"
                            class="premium-dropdown-item logout-btn-premium">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </li>
        </ul>
    </li>
        }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Account"
               asp-controller="Authentication"
               asp-action="Register"
               asp-route-returnUrl="@(Context.Request.Query["returnUrl"].FirstOrDefault() ?? Context.Request.Path.Value)">
                Đăng ký
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link"
               asp-area="Account"
               asp-controller="Authentication"
               asp-action="Login"
               asp-route-returnUrl="@(Context.Request.Query["returnUrl"].FirstOrDefault() ?? Context.Request.Path.Value)">
                Đăng nhập
            </a>
        </li>
    }
</ul>