@model IEnumerable<COMICZONE.Models.User>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fs-3">Quản lý người dùng</h1>

        <a class="btn btn-primary" asp-action="Create"><i class="ti ti-plus"></i>Thêm người dùng</a>
    </div>

    <!-- TABLE -->
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Ảnh đại diện</th>
                <th>Tên người dùng</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Ngày tạo</th>
                <th>Hành động</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>
                        <img src="@user.Avatar.AvatarOrDefault()"
                             alt="@user.Username" class="rounded-circle" style="width:40px; height:40px; object-fit:cover;">
                    </td>

                    <td>@user.Username</td>
                    
                    <td>@user.Email</td>
                    
                    <td>
                        <span class="badge bg-@(user.Role == "Admin" ? "danger" : "secondary")">
                            @(user.Role == "Admin" ? "Quản trị viên" : "Người dùng")
                        </span>
                    </td>

                    <td>
                        <span class="badge bg-@(user.Isactive ? "success" : "warning")">
                            @(user.Isactive ? "Đang hoạt động" : "Ngưng hoạt động")
                        </span>
                    </td>
                    
                    <td>@user.Createdat.ToString("dd/MM/yyyy")</td>
                    
                    <td>
                        <a class="btn btn-sm btn-info me-1" asp-action="Details" asp-route-id="@user.Id"><i class="ti ti-eye"></i></a>
                        <a class="btn btn-sm btn-warning me-1" asp-action="Edit" asp-route-id="@user.Id"><i class="ti ti-edit"></i></a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@user.Id"><i class="ti ti-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>