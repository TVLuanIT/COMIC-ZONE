@model IEnumerable<COMICZONE.Models.Artist>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý họa sĩ";
    var searchModel = ViewBag.SearchModel as COMICZONE.Areas.Admin.ViewModels.ArtistSearchModel ?? new COMICZONE.Areas.Admin.ViewModels.ArtistSearchModel();
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fs-3">Quản lý họa sĩ</h1>

        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="ti ti-plus"></i>
            Thêm họa sĩ
        </a>
    </div>

    @* Reusable search form *@
    <partial name="_ArtistSearchForm" model="searchModel" />

    <!-- TABLE -->
    <div class="card shadow-sm border-0">
        <div class="table-wrapper">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr class="align-middle">
                        <th>
                            @Html.SortHeader("#", "Id", searchModel.SortColumn ?? "Id", searchModel.IsAscending, searchModel.Keyword)
                        </th>
                        <th>
                            @Html.SortHeader("Tên họa sĩ", "Name", searchModel.SortColumn ?? "Id", searchModel.IsAscending, searchModel.Keyword)
                        </th>
                        <th class="text-center">
                            @Html.SortHeader("Trạng thái", "Isdeleted", searchModel.SortColumn ?? "Id", searchModel.IsAscending, searchModel.Keyword)
                        </th>
                        <th class="text-end">
                            @Html.SortHeader("Số sản phẩm", "Products.Count", searchModel.SortColumn ?? "Id", searchModel.IsAscending, searchModel.Keyword)
                        </th>

                        <th class="text-end table-actions">
                            Hành động
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr id="artist-row-@item.Id" class="@(item.Isdeleted ? "bg-light text-muted opacity-75" : "")">
                            <!-- ID -->
                            <td>
                                <span class="fw-medium">#@item.Id</span>
                            </td>

                            <!-- NAME -->
                            <td>
                                <span class="fw-medium">@item.Name</span>
                            </td>

                            <td>
                                <span id="status-cell-@item.Id">
                                    @if (item.Isdeleted)
                                    {
                                        <span class="badge bg-danger">Đã ẩn</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                </span>
                            </td>

                            <!-- PRODUCT COUNT -->
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">
                                    @(item.Products?.Count() ?? 0)
                                </span>
                            </td>

                            <!-- ACTION -->
                            <td class="text-end table-actions">
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light">
                                    <i class="ti ti-edit"></i>
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light">
                                    <i class="ti ti-eye"></i>
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light text-danger">
                                    <i class="ti ti-trash"></i>
                                </a>

                                <button type="button"
                                        title="@(item.Isdeleted ? "Khôi phục" : "Xóa mềm")"
                                        data-id="@item.Id"
                                        data-url="@Url.Action("ToggleDelete", "Artists", new { area = "Admin" })"
                                        class="btn btn-sm ajax-toggle-artist-status
                                            @(item.Isdeleted ? "btn-success" : "btn-light text-danger")">
                                    
                                    <i class="ti @(item.Isdeleted ? "ti-refresh" : "ti-ban")"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-top-0 pb-4">
            <partial name="_AdminPagination" model="searchModel" />
        </div>
    </div>
</div>