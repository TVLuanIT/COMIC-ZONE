@* _Report.cshtml không có @model *@
<div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <form id="reportForm" method="post" class="w-100 px-lg-0 px-3">
            @Html.AntiForgeryToken()
            <div class="modal-content report-modal-premium shadow-lg border-0">
                <div class="modal-header border-0 pb-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="modal-title fw-black h4 m-0" id="reportModalLabel">
                        <i class="bi bi-shield-exclamation text-danger me-2"></i>Báo cáo vi phạm
                    </h5>
                    <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Đóng">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                
                <div class="modal-body py-4 px-4">
                    <div class="bg-light p-3 rounded-4 mb-4 border border-light">
                        <p class="text-secondary small mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            Hành động này giúp cộng đồng <strong>ComicZone</strong> trở nên trong sạch hơn. Hãy cho chúng tôi biết chi tiết lý do bạn báo cáo nội dung này.
                        </p>
                    </div>
                    
                    <input type="hidden" id="report-review-id" name="ReviewId" />
                    <input type="hidden" id="report-reply-id" name="ReplyId" />

                    <div class="form-group">
                        <label for="reason" class="small fw-bold text-secondary text-uppercase mb-2 d-block">
                            Lý do báo cáo chi tiết:
                        </label>
                        <textarea class="form-control premium-textarea no-resize" 
                                  id="reason" name="Reason" 
                                  rows="4" 
                                  placeholder="Ví dụ: Nội dung nhạy cảm, ngôn từ xúc phạm, spam quảng cáo..." 
                                  required></textarea>
                    </div>
                </div>
                
                <div class="modal-footer border-0 pt-0 pb-4 px-4 gap-3">
                    <button type="button" class="btn btn-outline-light-custom px-4 py-2 flex-grow-1" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-report-submit flex-grow-1 py-2 glass-hover-effect">
                        <i class="bi bi-send me-1"></i> Gửi báo cáo
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>