@model COMICZONE.Models.MarketplacePost

@{
    ViewData["Title"] = "Đăng bán sản phẩm";
}

<div class="container mt-5 pt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-header bg-white border-bottom pb-0 pt-4 px-4">
                    <h4 class="fw-bold" style="color: var(--primary-color);">Tạo bài đăng bán mới</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Tiêu đề sản phẩm</label>
                            <input asp-for="Title" class="form-control" placeholder="Ví dụ: Bán combo Dragon Ball tập 1-10 còn mới..." required />
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ)</label>
                                <input asp-for="Price" type="number" class="form-control" placeholder="0" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Condition" class="form-label fw-bold">Tình trạng</label>
                                <select asp-for="Condition" class="form-select">
                                    <option value="NewLike">Như mới (NewLike)</option>
                                    <option value="VeryGood">Rất tốt (VeryGood)</option>
                                    <option value="Good">Tốt (Good)</option>
                                    <option value="Acceptable">Chấp nhận được</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Category" class="form-label fw-bold">Danh mục</label>
                            <select asp-for="Category" class="form-select" required>
                                <option value="" disabled selected>-- Chọn danh mục --</option>
                                <option value="Manga">Manga</option>
                                <option value="Manhua">Manhua</option>
                                <option value="Manhwa">Manhwa</option>
                                <option value="Comics">Comics (Truyện tranh Âu Mỹ)</option>
                                <option value="Novel">Light Novel / Tiểu thuyết</option>
                                <option value="Anime Goods">Anime Goods (Phụ kiện)</option>
                                <option value="Figures">Figures / Models (Mô hình)</option>
                                <option value="Others">Khác</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Mô tả kỹ tình trạng, lỗi nếu có..."></textarea>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Hình ảnh minh họa <span class="text-danger">*</span></label>
                            <input type="file" name="uploadedImages" id="imageInput" class="form-control @(ViewData.ModelState["uploadedImages"]?.Errors.Count > 0 ? "is-invalid" : "")" multiple accept="image/*" required />
                            <div class="invalid-feedback">
                                @Html.ValidationMessage("uploadedImages")
                            </div>
                            <div id="imagePreviewContainer" class="d-flex flex-wrap gap-2 mt-3"></div>
                            <small class="text-muted">Bắt buộc tải lên ít nhất 1 ảnh. Bạn có thể chọn nhiều ảnh cùng lúc.</small>
                        </div>
                        
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary px-4">Hủy</a>
                            <button type="submit" class="btn btn-primary px-5" style="background-color: var(--primary-color);">Đăng tin</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imageInput').addEventListener('change', function (event) {
            const container = document.getElementById('imagePreviewContainer');
            container.innerHTML = ''; // Xóa các ảnh cũ

            const files = event.target.files;
            if (files) {
                Array.from(files).forEach(file => {
                    if (file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const imgWrapper = document.createElement('div');
                            imgWrapper.style.position = 'relative';
                            imgWrapper.style.width = '100px';
                            imgWrapper.style.height = '100px';
                            
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.classList.add('img-thumbnail');
                            img.style.width = '100%';
                            img.style.height = '100%';
                            img.style.objectFit = 'cover';
                            
                            imgWrapper.appendChild(img);
                            container.appendChild(imgWrapper);
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        });
    </script>
}
