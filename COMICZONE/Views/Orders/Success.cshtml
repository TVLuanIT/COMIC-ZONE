@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="status-result-page">
    <div class="result-card success-glow text-center" data-aos="zoom-in">
        <div class="icon-box-status icon-box-success pulse-success animate-scale">
            <i class="bi bi-check2-all"></i>
        </div>

        <h2 class="result-title text-success">Đặt hàng thành công!</h2>
        
        <p class="result-msg">
            Cảm ơn bạn đã tin tưởng lựa chọn <strong>ComicZone</strong>.<br>
            Đơn hàng của bạn đã được ghi nhận và đang được chuẩn bị để xưởng truyện sớm gửi tới tay bạn.
        </p>

        <div class="order-info-badge">
            <i class="bi bi-box-seam me-2"></i> Trạng thái: Đang chuẩn bị hàng
        </div>

        <div class="result-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger btn-lg rounded-pill py-3 fw-bold shadow-sm">
                TIẾP TỤC MUA SẮM
            </a>
            <a asp-controller="UserProfiles" asp-action="MyOrders" class="btn btn-light btn-lg rounded-pill py-3 fw-bold text-muted border">
                XEM ĐƠN HÀNG CỦA TÔI
            </a>
        </div>

        <div class="mt-5 pt-4 border-top border-light">
            <small class="text-muted">Bạn có thắc mắc? <a href="#" class="text-danger text-decoration-none">Liên hệ hỗ trợ</a></small>
        </div>
    </div>
</div>