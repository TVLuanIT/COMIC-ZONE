@{
    ViewData["Title"] = "Thanh toán thất bại";
}

<div class="status-result-page">
    <div class="result-card fail-glow text-center" data-aos="zoom-in">
        <div class="icon-box-status icon-box-fail animate-scale">
            <i class="bi bi-x-circle"></i>
        </div>

        <h2 class="result-title text-danger">Thanh toán thất bại</h2>
        
        <p class="result-msg text-muted">
            Rất tiếc, đã có lỗi xảy ra trong quá trình thanh toán.<br>
            @if (TempData["Message"] != null)
            {
                <span class="text-danger fw-bold">Lý do: @TempData["Message"]</span>
            }
            else
            {
                <span>Vui lòng kiểm tra lại số dư hoặc thông tin thẻ của bạn.</span>
            }
        </p>

        <div class="order-info-badge bg-light">
            <i class="bi bi-shield-exclamation me-2"></i> Trạng thái: Chưa thanh toán
        </div>

        <div class="result-actions">
            <a asp-controller="Carts" asp-action="Index" class="btn btn-danger btn-lg rounded-pill py-3 fw-bold shadow-sm">
                QUAY LẠI GIỎ HÀNG
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-light btn-lg rounded-pill py-3 fw-bold text-muted border">
                QUAY VỀ TRANG CHỦ
            </a>
        </div>

        <div class="mt-5 pt-4 border-top border-light">
            <p class="small text-muted mb-0">Bạn cần hỗ trợ thanh toán? <br> Gọi ngay: <span class="text-danger fw-bold">0373-801-713</span></p>
        </div>
    </div>
</div>