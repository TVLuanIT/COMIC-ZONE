@model COMICZONE.Areas.Admin.ViewModels.MarketplaceReviewSearchModel

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <form asp-action="Index" method="get" id="reviewSearchForm">
            <input type="hidden" name="activeTab" value="Reviews" />
            <input type="hidden" asp-for="SortColumn" />
            <input type="hidden" asp-for="IsAscending" />

            <div class="row g-3">
                <div class="col-md-5 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="ti ti-search text-muted"></i></span>
                        <input asp-for="Keyword" class="form-control border-start-0 ps-0" placeholder="Tìm theo nội dung, người đánh giá..." />
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <select asp-for="Rating" class="form-select">
                        <option value="">-- Rating --</option>
                        <option value="5">⭐⭐⭐⭐⭐ (5)</option>
                        <option value="4">⭐⭐⭐⭐ (4)</option>
                        <option value="3">⭐⭐⭐ (3)</option>
                        <option value="2">⭐⭐ (2)</option>
                        <option value="1">⭐ (1)</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="ti ti-filter me-1"></i>Lọc</button>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-light" data-bs-toggle="collapse" data-bs-target="#mktReviewAdvancedSearch">
                        <i class="ti ti-adjustments-horizontal"></i>
                    </button>
                </div>
            </div>

            <div class="collapse @(!string.IsNullOrEmpty(Model.ReviewerUsername) || Model.CreatedFrom.HasValue ? "show" : "")" id="mktReviewAdvancedSearch">
                <hr class="my-3 opacity-25">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Người đánh giá</label>
                        <input asp-for="ReviewerUsername" class="form-control form-control-sm" placeholder="Username..." />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Từ ngày</label>
                        <input asp-for="CreatedFrom" type="date" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Đến ngày</label>
                        <input asp-for="CreatedTo" type="date" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
