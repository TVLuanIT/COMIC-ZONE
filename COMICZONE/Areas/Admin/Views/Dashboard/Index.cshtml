@using COMICZONE.Areas.Admin.ViewModels.Dashboard
@using COMICZONE.Helpers
@using COMICZONE.Models
@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4"
     data-reports-config='{
        "sales": "@Url.Action("GetOrderVolumeData", "Reports", new { area = "Admin" })",
        "status": "@Url.Action("GetOrderStatusData", "Reports", new { area = "Admin" })",
        "export": "@Url.Action("ExportToExcel", "Reports", new { area = "Admin" })"
     }'>
    
    <!-- 1. Banner chào và Thống kê nhanh -->
    <partial name="_DashboardHeader" model="Model" />

    <!-- 2. Nội dung vận hành (Biểu đồ, Đơn hàng, Cảnh báo...) -->
    <partial name="_DashboardOperationContent" model="Model" />
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
}