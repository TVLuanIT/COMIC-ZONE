<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - COMICZONE</title>

        <!-- Bootstrap CSS -->
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

        <!-- Bootstrap Icons -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

        <!-- Google Font -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

        <!-- Swiper CSS -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
        
        <!-- AOS CSS -->
        <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

        <!-- Site CSS -->
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/COMICZONE.styles.css" asp-append-version="true" />
    </head>

    <body style="font-family: 'Poppins', sans-serif;">
        <!-- HEADER / NAVBAR -->
        <header>
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm fixed-top glass-nav">
                <div class="container">
                    <!-- Logo -->
                    <div class="d-flex align-items-center">
                        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                            <img src="~/images/logo-nobg.png"
                                 asp-append-version="true"
                                 alt="ComicZone Logo"
                                 style="height:40px; width:auto; margin-right:10px;" />
                        </a>
                        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                            COMIC<span class="text-danger">ZONE</span>
                        </a>
                    </div>

                    <!-- Mobile toggle -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <!-- Menu -->
                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </li>
                        
                            <li class="nav-item">
                                @await Component.InvokeAsync("NavCategories")
                            </li>
                        
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="About" >Về chúng tôi</a>
                            </li>
                        
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Carts" asp-action="Index">
                                    <i class="bi bi-cart"></i> Giỏ hàng
                                </a>
                            </li>
                        </ul>

					    <!-- Search Form -->
                        <form class="d-flex my-3" asp-controller="Products" asp-action="Search" method="get">
                            <input class="form-control me-2" type="search" name="keyword"
                                   placeholder="Tìm truyện...">
                            <button class="btn" type="submit">🔍</button>
                        </form>
                        <!-- Login / Register -->
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>

        <!-- MAIN CONTENT -->
        <main role="main">
            @RenderBody()
            
            <!-- FOOTER -->
        <footer class="modern-footer">
            <div class="container overflow-hidden">
                <div class="row g-5">
                    <!-- Column 1: Brand -->
                    <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <a class="footer-brand-title text-decoration-none text-white" asp-controller="Home" asp-action="Index">
                            COMIC<span>ZONE</span>
                        </a>
                        <p class="footer-desc mb-4">
                            ComicZone là điểm đến lý tưởng cho những tín đồ yêu thích thế giới truyện tranh bản quyền. Chúng tôi cam kết mang lại những trải nghiệm đọc tuyệt vời nhất với kho truyện khổng lồ và chất lượng phục vụ tận tâm.
                        </p>
                        <div class="social-links">
                            <a href="https://facebook.com" class="social-btn" target="_blank"><i class="bi bi-facebook"></i></a>
                            <a href="https://instagram.com" class="social-btn" target="_blank"><i class="bi bi-instagram"></i></a>
                            <a href="https://tiktok.com" class="social-btn" target="_blank"><i class="bi bi-tiktok"></i></a>
                            <a href="https://youtube.com" class="social-btn" target="_blank"><i class="bi bi-youtube"></i></a>
                        </div>
                    </div>

                    <!-- Column 2: Quick Links -->
                    <div class="col-lg-2 col-md-6" data-aos="fade-up" data-aos-delay="200">
                        <h4 class="footer-column-title">Khám Phá</h4>
                        <ul class="footer-links">
                            <li><a asp-controller="Home" asp-action="Index" class="footer-link">Trang chủ</a></li>
                            <li><a asp-controller="Products" asp-action="Index" class="footer-link">Cửa hàng</a></li>
                            <li><a asp-controller="Home" asp-action="About" class="footer-link">Về chúng tôi</a></li>
                            <li><a href="#" class="footer-link">Blog truyện</a></li>
                        </ul>
                    </div>

                    <!-- Column 3: Support -->
                    <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                        <h4 class="footer-column-title">Hỗ Trợ</h4>
                        <ul class="footer-links">
                            <li><a href="#" class="footer-link">Câu hỏi thường gặp</a></li>
                            <li><a href="#" class="footer-link">Chính sách bảo mật</a></li>
                            <li><a href="#" class="footer-link">Điều khoản dịch vụ</a></li>
                            <li><a href="#" class="footer-link">Chính sách hoàn tiền</a></li>
                        </ul>
                    </div>

                    <!-- Column 4: Contact -->
                    <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
                        <h4 class="footer-column-title">Liên Hệ</h4>
                        <div class="footer-contact-item">
                            <i class="bi bi-geo-alt-fill"></i>
                            <span>18 Ung Văn Khiêm, Đông Xuyên, TP. Long Xuyên, An Giang</span>
                        </div>
                        <div class="footer-contact-item">
                            <i class="bi bi-telephone-fill"></i>
                            <span>0373-801-713</span>
                        </div>
                        <div class="footer-contact-item">
                            <i class="bi bi-envelope-fill"></i>
                            <span>luan31032004@gmail.com</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Copyright Bar -->
            <div class="copyright-bar">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-md-6 text-center text-md-start">
                            <p class="copyright-text">&copy; 2026 ComicZone. Tất cả quyền được bảo lưu.</p>
                        </div>
                        <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
                            <img src="https://img.icons8.com/color/48/000000/visa.png" width="30" class="me-2" />
                            <img src="https://img.icons8.com/color/48/000000/mastercard.png" width="30" class="me-2" />
                            <img src="https://img.icons8.com/color/48/000000/paypal.png" width="30" />
                        </div>
                    </div>
            </div>
        </footer>

        <!-- Scripts -->
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        
        <!-- Swiper JS -->
        <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
        
        <!-- AOS JS -->
        <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>
            // Initialize AOS
            AOS.init({
                duration: 800,
                once: true,
                offset: 50
            });
        </script>

        @if (TempData["LoginRequired"] != null)
        {
            <script>
                window.loginRequiredMessage = "@Html.Raw(TempData["LoginRequired"])";
            </script>
        }

        @await RenderSectionAsync("Scripts", required: false)

        <div id="chatbot-container">
            <div id="chatbot-window">
                <div id="chatbot-header">
                    <div class="chatbot-title">
                        🤖 Trợ Lý COMICZONE
                    </div>

                    <span id="close-chat">×</span>
                </div>

                <div id="chatbot-messages"></div>

                <div id="chatbot-input-area">
                    <input id="chatbot-input"
                           placeholder="Nhập câu hỏi..."
                           type="text" />

                    <button id="chatbot-send">➤</button>
                </div>
            </div>

            <div id="chatbot-icon">
                💬
            </div>
        </div>
    </body>
</html>