@model IEnumerable<COMICZONE.Models.Invoice>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý hóa đơn";
}

<div class="container-fluid">
    <!-- Breadcrumb & Title -->
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active">Hóa đơn</li>
                </ol>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
            <h5 class="card-title mb-0 fw-bold">
                <i class="ti ti-file-invoice me-2 text-primary"></i>Danh sách hóa đơn
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã hóa đơn</th>
                            <th>Khách hàng</th>
                            <th>Mã đơn hàng</th>
                            <th class="text-end">Tổng tiền</th>
                            <th class="text-center">Ngày xuất</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark">#@item.Id</span>
                                </td>
                                <td>
                                    <div class="fw-bold">@item.CustomerName</div>
                                    <div class="small text-muted">Hóa đơn điện tử</div>
                                </td>
                                <td>
                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@item.OrderId" class="badge bg-info-subtle text-info text-decoration-none">
                                        Đơn hàng #@item.Order?.OrderId
                                    </a>
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold text-success">@string.Format("{0:N0} VNĐ", item.TotalAmount)</span>
                                </td>
                                <td class="text-center text-muted">
                                    @(item.IssueDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-sm text-info" title="Chi tiết">
                                            <i class="ti ti-eye fs-5"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm text-primary" title="Chỉnh sửa">
                                            <i class="ti ti-edit fs-5"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm text-danger" title="Xóa">
                                            <i class="ti ti-trash fs-5"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="ti ti-file-off fs-1 text-muted mb-2"></i>
                    <p class="text-muted">Chưa có dữ liệu hóa đơn.</p>
                </div>
            }
        </div>
    </div>
</div>
