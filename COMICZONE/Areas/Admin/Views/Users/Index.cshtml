@model IEnumerable<COMICZONE.Models.User>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý người dùng";
    var searchModel = ViewBag.SearchModel as COMICZONE.Areas.Admin.ViewModels.UserSearchModel ?? new COMICZONE.Areas.Admin.ViewModels.UserSearchModel();
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h3 class="text-themecolor fw-bold">
                <i class="ti ti-users me-2 text-primary"></i>Quản lý người dùng
            </h3>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-end mb-0">
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                        <li class="breadcrumb-item active">Người dùng</li>
                    </ol>
                </nav>
                <a class="btn btn-primary shadow-sm ms-3" asp-action="Create">
                    <i class="ti ti-plus me-1"></i>Thêm người dùng
                </a>
            </div>
        </div>
    </div>

    @* Reusable search form *@
    <partial name="_UserSearchForm" model="searchModel" />

    <!-- TABLE -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom fw-bold text-uppercase small">
                    <tr class="align-middle">
                        <th class="ps-3">Ảnh</th>
                        <th>
                            @Html.SortHeader("Người dùng", "Username", searchModel.SortColumn ?? "Id", searchModel.IsAscending, searchModel.Keyword)
                        </th>
                        <th>
                            @Html.SortHeader("Email", "Email", searchModel.SortColumn ?? "Id", searchModel.IsAscending, searchModel.Keyword)
                        </th>
                        <th class="text-center">
                            @Html.SortHeader("Vai trò", "Role", searchModel.SortColumn ?? "Id", searchModel.IsAscending, searchModel.Keyword)
                        </th>
                        <th class="text-center">
                            @Html.SortHeader("Xóa mềm", "Isdeleted", searchModel.SortColumn ?? "Id", searchModel.IsAscending, searchModel.Keyword)
                        </th>
                        <th class="text-center">
                            @Html.SortHeader("Trạng thái", "Isactive", searchModel.SortColumn ?? "Id", searchModel.IsAscending, searchModel.Keyword)
                        </th>
                        <th>
                            @Html.SortHeader("Ngày tạo", "Createdat", searchModel.SortColumn ?? "Id", searchModel.IsAscending, searchModel.Keyword)
                        </th>
                        <th class="text-center pe-3">Hành động</th>
                    </tr>
                </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr id="user-row-@user.Id" class="align-middle @(user.Isdeleted ? "bg-light text-muted opacity-75" : "")">
                    <td>
                        <img src="@user.Avatar.AvatarOrDefault()"
                             alt="@user.Username" class="rounded-circle" style="width:40px; height:40px; object-fit:cover;">
                    </td>

                    <td>@user.Username</td>
                    
                    <td>@user.Email</td>
                    
                    <td>
                        <span class="badge rounded-pill px-3 py-2 fw-semibold
                            @(user.UserRoleEnum == UserRole.Admin
                            ? "bg-danger-subtle text-danger"
                            : "bg-success-subtle text-success")">

                            @user.UserRoleEnum.GetDisplayName()
                        </span>
                    </td>

                    <td>
                        <span id="soft-delete-status-cell-@user.Id">
                        @if (user.Isdeleted)
                            {
                                <span class="badge bg-danger">Đã xóa mềm</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Chưa xóa</span>
                            }
                        </span>
                    </td>

                    <td>
                        <span id="active-status-cell-@user.Id">
                            <span class="badge bg-@(user.Isactive ? "success" : "warning")">
                                @(user.Isactive ? "Hoạt động" : "Ngưng hoạt động")
                            </span>
                        </span>
                    </td>
                    
                    <td>@user.Createdat.ToString("dd/MM/yyyy")</td>
                    
                    <td class="text-center">
                        <a class="btn btn-sm btn-icon btn-outline-info me-1" 
                           asp-action="Details" asp-route-id="@user.Id" 
                           title="Chi tiết người dùng">
                           <i class="ti ti-eye"></i>
                        </a>

                        <a class="btn btn-sm btn-icon btn-outline-warning me-1" 
                           asp-action="Edit" asp-route-id="@user.Id" 
                           title="Chỉnh sửa">
                           <i class="ti ti-edit"></i>
                        </a>

                        @if (user.Id.ToString() != (ViewBag.CurrentUserId as string))
                        {
                            <a class="btn btn-sm btn-icon btn-outline-danger shadow-sm me-1"
                               asp-action="Delete" asp-route-id="@user.Id"
                               title="Trang xóa & Quản lý phụ thuộc">
                                <i class="ti ti-trash"></i>
                            </a>

                            <button type="button"
                                    class="btn btn-sm btn-icon ajax-toggle-user-status me-1 @(user.Isdeleted ? "btn-success" : "btn-outline-danger")"
                                    data-id="@user.Id"
                                    data-url="@Url.Action("ToggleDelete", "Users", new { area = "Admin" })"
                                    title="@(user.Isdeleted ? "Khôi phục tài khoản" : "Xóa mềm (Vô hiệu hóa)")">
                                <i class="ti @(user.Isdeleted ? "ti-refresh" : "ti-ban")"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-top-0 pb-4">
            <partial name="_AdminPagination" model="searchModel" />
        </div>
    </div>
</div>