@using COMICZONE.Areas.Admin.ViewModels.Dashboard
@using COMICZONE.Helpers
@using COMICZONE.Models
@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4"
     data-reports-config='{
        "sales": "@Url.Action("GetOrderVolumeData", "Reports", new { area = "Admin" })",
        "status": "@Url.Action("GetOrderStatusData", "Reports", new { area = "Admin" })",
        "export": "@Url.Action("ExportToExcel", "Reports", new { area = "Admin" })"
     }'>
    <!-- TIÊU ĐỀ CHÀO MỪNG -->
    <div class="d-flex align-items-center justify-content-between mb-4 mt-2">
        <div>
            <h1 class="fs-3 fw-bold mb-0">@Model.Greeting, @Model.UserName!</h1>
            <p class="text-muted mb-0">Hôm nay là @DateTime.Now.ToString("dddd, dd/MM/yyyy")</p>
        </div>
        <div class="d-none d-md-block">
            <button class="btn btn-primary shadow-sm" onclick="location.reload()">
                <i class="ti ti-refresh me-1"></i> Làm mới dữ liệu
            </button>
        </div>
    </div>

    <!-- HÀNG THỐNG KÊ NHANH TRONG NGÀY -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="p-2 bg-white bg-opacity-25 rounded">
                            <i class="ti ti-shopping-cart fs-4"></i>
                        </div>
                        <span class="badge bg-white text-primary fw-bold">Hôm nay</span>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.TodayStats?.NewOrders</h3>
                    <p class="mb-0 small opacity-75">Đơn hàng mới</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="p-2 bg-white bg-opacity-25 rounded">
                            <i class="ti ti-currency-dong fs-4"></i>
                        </div>
                        <span class="badge bg-white text-success fw-bold">Hôm nay</span>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.TodayStats?.Revenue.ToString("N0")₫</h3>
                    <p class="mb-0 small opacity-75">Doanh thu thu về</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="p-2 bg-dark bg-opacity-10 rounded">
                            <i class="ti ti-alert-triangle fs-4"></i>
                        </div>
                        <span class="badge bg-dark text-white fw-bold">Cần xử lý</span>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.TodayStats?.LowStockCount</h3>
                    <p class="mb-0 small opacity-75 text-dark">Sản phẩm sắp hết hàng</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-danger text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="p-2 bg-white bg-opacity-25 rounded">
                            <i class="ti ti-flag fs-4"></i>
                        </div>
                        <span class="badge bg-white text-danger fw-bold">Cần xem</span>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.TodayStats?.PendingReports</h3>
                    <p class="mb-0 small opacity-75">Báo cáo vi phạm mới</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- CỘT TRÁI: BIỂU ĐỒ DOANH THU & ĐƠN HÀNG MỚI -->
        <div class="col-lg-8">
            <!-- Biểu đồ -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Số lượng đơn hàng mới</h5>
                    <span id="salesChartTitle" class="badge bg-light-primary text-primary">7 ngày qua</span>
                </div>
                <div class="card-body">
                    <div class="position-relative w-100" style="height: 420px;">
                        <div id="salesLoading" class="chart-loader">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                        <canvas id="salesChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Đơn hàng gần đây -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Đơn hàng mới nhất</h5>
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-light">Xem tất cả</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mã đơn</th>
                                <th>Thời gian</th>
                                <th>Sản phẩm điển hình</th>
                                <th>Trạng thái</th>
                                <th class="text-end pe-3">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                            {
                                foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold">#@order.OrderId</td>
                                        <td>@order.OrderDate.ToString("HH:mm dd/MM")</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="@order.Product.GetImagePath()" style="width:30px; height:40px; object-fit:cover; border-radius:4px;">
                                                <span class="text-truncate" style="max-width: 150px;">@order.Product.Name</span>
                                            </div>
                                        </td>
                                        <td>@Html.Raw(OrderHelper.GetStatusBadge(order.Status))</td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-icon btn-light">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Chưa có đơn hàng nào hôm nay</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: KHO HÀNG & ĐÁNH GIÁ -->
        <div class="col-lg-4">
            <!-- Cảnh báo kho -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom border-warning border-3">
                    <h5 class="fw-bold mb-0 text-warning">
                        <i class="ti ti-package-export me-1"></i> Cảnh báo kho hàng
                    </h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (Model.LowStockProducts != null && Model.LowStockProducts.Any())
                        {
                            foreach (var p in Model.LowStockProducts)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@p.GetImagePath()" style="width:40px; height:55px; object-fit:cover; border-radius:4px;">
                                        <div>
                                            <div class="fw-bold small text-truncate" style="max-width: 160px;">@p.Name</div>
                                            <div class="text-muted smaller">ID: #@p.Id</div>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-danger-subtle text-danger rounded-pill">@p.StockQuantity</span>
                                        <div class="smaller text-muted mt-1">Còn lại</div>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                </div>
                <div class="card-footer bg-white border-0 text-center py-3">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-warning w-100">Nhập hàng ngay</a>
                </div>
            </div>

            <!-- Đánh giá mới -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">Đánh giá mới nhất</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @if (Model.LatestReviews != null && Model.LatestReviews.Any())
                        {
                            foreach (var r in Model.LatestReviews)
                            {
                                <div class="list-group-item py-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-bold text-primary small">@r.User.Customer?.Fullname</span>
                                        <small class="text-muted">@r.Createdat?.ToString("dd/MM")</small>
                                    </div>
                                    <div class="mb-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="ti @(i <= r.Rating ? "ti-star-filled text-warning" : "ti-star text-muted") smaller"></i>
                                        }
                                    </div>
                                    <p class="mb-0 text-muted smaller text-truncate-2">@r.Reviewcontent</p>
                                    <div class="mt-2 bg-light p-2 rounded smaller d-flex align-items-center gap-2">
                                        <img src="@r.Product.GetImagePath()" style="width:20px; height:30px; object-fit:cover;">
                                        <span class="text-truncate">@r.Product.Name</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="card-footer bg-white border-0 text-center py-3">
                    <a asp-controller="ProductReviews" asp-action="Index" class="btn btn-sm btn-link text-primary">Xem tất cả đánh giá</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
}