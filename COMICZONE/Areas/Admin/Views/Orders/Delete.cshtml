@model COMICZONE.Models.Order

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa đơn hàng";
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="text-danger mb-1">
                <i class="ti ti-trash"></i>
                Xóa đơn hàng #@Model.OrderId
            </h4>

            <span class="badge @(Model.OrderStatusEnum switch
                  {
                      OrderStatus.Pending => "bg-warning text-dark",
                      OrderStatus.Completed => "bg-success",
                      OrderStatus.Cancelled => "bg-danger",
                      _ => "bg-secondary"
                  })">

                @Model.OrderStatusEnum.GetDisplayName()
            </span>
        </div>

        <a asp-action="Index" class="btn btn-light">
            <i class="ti ti-arrow-left"></i>
            Quay lại
        </a>
    </div>


    <div class="row">
        <!-- LEFT -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="ti ti-info-circle"></i>
                        Thông tin đơn hàng
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">
                            Ngày đặt
                        </div>
                        <div class="col-md-8">
                            @Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">
                            Địa chỉ giao hàng
                        </div>
                        <div class="col-md-8">
                            @Model.ShippingAddress
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">
                            Số điện thoại
                        </div>
                        <div class="col-md-8">
                            @Model.PhoneNumber
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 text-muted">
                            Ghi chú
                        </div>
                        <div class="col-md-8">
                            @(Model.Note ?? "Không có")
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mt-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        Sản phẩm trong đơn hàng
                    </h5>
                </div>

                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Giá</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>@Html.Raw(item.Product?.GetProductCell())</td>
                                    
                                    <td class="text-center align-middle">
                                        @item.Quantity
                                    </td>

                                    <td class="text-end align-middle">
                                        @((item.Price ?? 0).ToVnd())
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.Payments?.Any() == true)
            {
                <div class="card shadow-sm border-0 mt-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            Thanh toán liên quan
                        </h5>
                    </div>

                    <div class="card-body">
                        @foreach (var payment in Model.Payments)
                        {
                            <div class="border rounded p-2 mb-2">
                                <div>
                                    Phương thức thanh toán:

                                    <strong>
                                        @payment.PaymentMethodEnum.GetDisplayName()
                                    </strong>
                                </div>

                                <div>
                                    Trạng thái:

                                    <strong>
                                        @payment.PaymentStatusEnum.GetDisplayName()
                                    </strong>
                                </div>

                                <div>
                                    Giao dịch:
                                    
                                    <strong>
                                        @(payment.PaymentTransactions?.Count ?? 0)
                                    </strong>
                                </div>

                                <div>
                                    Hoàn trả:

                                    <strong>
                                        @(payment.Refunds?.Count ?? 0)
                                    </strong>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }


            @if (Model.OrderStatusHistories?.Any() == true)
            {
                <div class="card shadow-sm border-0 mt-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            Lịch sử trạng thái
                        </h5>
                    </div>

                    <div class="card-body">

                        @foreach (var history in Model.OrderStatusHistories)
                        {
                            <div>
                                @history.OrderStatusEnum.GetDisplayName() - @history.UpdatedAt
                            </div>
                        }

                    </div>
                </div>
            }

        </div>

        <!-- RIGHT -->
        <div class="col-lg-4">
            <!-- CUSTOMER -->
            <!-- ẩn dates + note -->
            <partial name="_CustomerInfo"
                model="Model"
                view-data='new ViewDataDictionary(ViewData)
                    {
                        { "ShowNote", false },
                        { "ShowDates", false }
                    }' />

            <!-- DELETE CONFIRM -->
            <div class="card shadow-sm border-0 border-danger">
                <div class="card-body text-center">
                    <p class="text-danger fw-semibold mb-3">
                        Bạn có chắc muốn xóa đơn hàng này?
                    </p>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="OrderId" />

                        <button type="submit"
                                class="btn btn-danger w-100 mb-2">
                            <i class="ti ti-trash"></i>
                            Xóa đơn hàng
                        </button>
                    </form>

                    <a asp-action="Index"
                       class="btn btn-light w-100">
                        Hủy
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>