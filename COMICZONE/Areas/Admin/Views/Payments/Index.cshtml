@model IEnumerable<COMICZONE.Models.Payment>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý thanh toán";
    var searchModel = ViewBag.SearchModel as COMICZONE.Areas.Admin.ViewModels.PaymentSearchModel ?? new COMICZONE.Areas.Admin.ViewModels.PaymentSearchModel();
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active">Thanh toán</li>
                </ol>
            </div>
        </div>
    </div>
    
    @* Reusable search form *@
    <partial name="_PaymentSearchForm" model="searchModel" />

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold"><i class="ti ti-credit-card me-2"></i>Danh sách giao dịch</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="align-middle">
                            <th class="ps-4">
                                @Html.SortHeader("Mã GD", "Paymentid", searchModel.SortColumn ?? "Createdat", searchModel.IsAscending, searchModel.Keyword)
                            </th>
                            <th>
                                @Html.SortHeader("Mã Đơn", "Orderid", searchModel.SortColumn ?? "Createdat", searchModel.IsAscending, searchModel.Keyword)
                            </th>
                            <th class="text-center">
                                @Html.SortHeader("Số tiền", "Amount", searchModel.SortColumn ?? "Createdat", searchModel.IsAscending, searchModel.Keyword)
                            </th>
                            <th class="text-center">
                                @Html.SortHeader("Trạng thái", "Paymentstatus", searchModel.SortColumn ?? "Createdat", searchModel.IsAscending, searchModel.Keyword)
                            </th>
                            <th class="text-center">
                                @Html.SortHeader("Phương thức", "Paymentmethod", searchModel.SortColumn ?? "Createdat", searchModel.IsAscending, searchModel.Keyword)
                            </th>
                            <th class="text-center">
                                @Html.SortHeader("Ngày tạo", "Createdat", searchModel.SortColumn ?? "Createdat", searchModel.IsAscending, searchModel.Keyword)
                            </th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr class="align-middle">
                                <td class="ps-4">
                                    <span class="fw-bold text-primary">#@item.Paymentid</span>
                                    @if (!string.IsNullOrEmpty(item.Transactionid))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 150px;" title="@item.Transactionid">TXID: @item.Transactionid</div>
                                    }
                                </td>
                                <td>
                                    <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@item.Orderid" class="fw-bold text-dark text-decoration-none">
                                        #@item.Orderid
                                    </a>
                                </td>
                                <td class="fw-bold text-dark">
                                    @item.Amount.ToString("N0") VNĐ
                                </td>
                                <td>

                                    @{
                                        var statusClass = item.Paymentstatus switch
                                        {
                                            "SUCCESS" => "bg-success-subtle text-success",
                                            "PENDING" => "bg-warning-subtle text-warning",
                                            "FAILED" => "bg-danger-subtle text-danger",
                                            "CANCELLED" => "bg-secondary-subtle text-secondary",
                                            "REFUNDED" => "bg-info-subtle text-info",
                                            _ => "bg-light text-dark"
                                        };
                                        var statusText = item.Paymentstatus switch
                                        {
                                            "SUCCESS" => "Thành công",
                                            "PENDING" => "Chờ thanh toán",
                                            "FAILED" => "Thất bại",
                                            "CANCELLED" => "Đã hủy",
                                            "REFUNDED" => "Đã hoàn tiền",
                                            _ => item.Paymentstatus
                                        };
                                    }
                                    <span class="badge @statusClass px-2 py-1 rounded">
                                        @statusText
                                    </span>
                                </td>
                                <td>
                                    @if (item.Paymentmethod?.ToLower() == "vnpay")
                                    {
                                        <span class="text-primary fw-medium"><i class="ti ti-brand-stripe me-1"></i>VNPay</span>
                                    }
                                    else if (item.Paymentmethod?.ToLower() == "cod")
                                    {
                                        <span class="text-secondary fw-medium"><i class="ti ti-truck me-1"></i>COD</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@item.Paymentmethod</span>
                                    }
                                </td>
                                <td class="text-muted">
                                    @(item.Createdat?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Paymentid" class="btn btn-light btn-sm text-info" title="Chi tiết">
                                            <i class="ti ti-eye fs-5"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Paymentid" class="btn btn-light btn-sm text-primary" title="Chỉnh sửa">
                                            <i class="ti ti-edit fs-5"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Paymentid" class="btn btn-light btn-sm text-danger" title="Xóa">
                                            <i class="ti ti-trash fs-5"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="ti ti-credit-card-off fs-1 text-muted mb-2"></i>
                    <p class="text-muted">Chưa có dữ liệu thanh toán.</p>
                </div>
            }
        </div> <!-- card-body closed -->
        
        @if (Model.Any())
        {
            <div class="card-footer bg-white border-top-0 pb-4">
                <partial name="_AdminPagination" model="searchModel" />
            </div>
        }
    </div> <!-- card closed -->
</div> <!-- container-fluid closed -->
