@model List<COMICZONE.Models.Blog>

<div class="p-4">
    <div class="mb-4 text-center">
        <h2 class="fw-bold text-dark mb-1">Bài viết của tôi</h2>
        <p class="text-muted small mb-0">Danh sách các bài review và tin tức bạn đã đóng góp.</p>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            for (int i = 0; i < Model.Count; i++)
            {
                var blog = Model[i];
                var isUnread = ViewBag.UnreadBlogIds != null && ((List<int>)ViewBag.UnreadBlogIds).Contains(blog.Id);
                <div class="col-md-6" id="blog-@blog.Id" data-aos="fade-up" data-aos-delay="@(i * 50)">
                    <div class="card blog-manage-card border-0 rounded-4 overflow-hidden h-100 shadow-sm transition-all position-relative @(isUnread ? "unread-blog-card" : "")">
                        <div class="row g-0 h-100">
                            <div class="col-4 position-relative">
                                <div class="manage-thumb-wrapper h-100">
                                    <img src="@(string.IsNullOrEmpty(blog.Thumbnail) ? "/blogs/images/default-blog.png" : (blog.Thumbnail.StartsWith("http") ? blog.Thumbnail : "/images/blogs/" + blog.Thumbnail))" 
                                         class="manage-thumb" alt="@blog.Title">
                                    @if (isUnread)
                                    {
                                        <div class="unread-badge animate-pulse">
                                            Mới cập nhật
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-8">
                                <div class="card-body p-3 d-flex flex-column justify-content-between h-100">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start mb-2 position-relative" style="z-index: 2;">
                                            <span class="badge @(blog.Status == "Approved" ? "bg-success" : (blog.Status == "Pending" ? "bg-warning" : "bg-secondary")) rounded-pill small">
                                                @(blog.Status == "Approved" ? "Đã duyệt" : (blog.Status == "Pending" ? "Chờ duyệt" : "Bản nháp"))
                                            </span>
                                            <span class="text-muted x-small"><i class="bi bi-calendar3 me-1"></i>@blog.Createdat.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        <h6 class="text-dark fw-bold line-clamp-2 mb-2">@blog.Title</h6>
                                    </div>
                                    <div class="d-flex justify-content-end align-items-center mt-2">
                                        <div class="text-primary fw-bold x-small">
                                            <i class="bi bi-eye me-1"></i> Xem chi tiết
                                            <a asp-area="Blogs" asp-controller="Blogs" asp-action="Details" asp-route-id="@blog.Id" class="stretched-link"></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12" data-aos="fade-up">
                <div class="empty-state-premium text-center py-5">
                    <div class="empty-state-icon mb-4">
                        <div class="icon-circle shadow-premium mx-auto">
                            <i class="bi bi-journal-richtext text-primary"></i>
                        </div>
                        <div class="icon-dots mt-2">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                    <h4 class="text-dark fw-bold mb-2">Chưa có bài viết nào</h4>
                    <p class="text-muted mx-auto" style="max-width: 400px;">
                        Bạn chưa có bài đóng góp hoặc review nào được hiển thị tại đây. 
                        Đừng quên khám phá những tin tức hấp dẫn khác từ cộng đồng nhé!
                    </p>
                    <div class="mt-4">
                        <a asp-area="Blogs" asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm transition-all transform hover:scale-105">
                            <i class="bi bi-search me-2"></i> Khám phá Blog
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (ViewBag.Pagination != null)
    {
        <div class="mt-4 d-flex justify-content-center">
             @await Html.PartialAsync("_Pagination", (PaginationModel)ViewBag.Pagination)
        </div>
    }
</div>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.8em !important;
        line-height: 1.4em !important;
    }
    .x-small { font-size: 0.75rem; }
    .object-fit-cover { object-fit: cover; }

    /* Premium Empty State Styles */
    .empty-state-icon .icon-circle {
        width: 100px;
        height: 100px;
        background: rgba(0, 0, 0, 0.05);
        backdrop-filter: blur(10px);
        border: 2px solid rgba(0, 0, 0, 0.05);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        position: relative;
    }

    .icon-dots span {
        display: inline-block;
        width: 6px;
        height: 6px;
        background: var(--bs-primary);
        border-radius: 50%;
        margin: 0 3px;
        animation: dotPulse 1.5s infinite ease-in-out;
        opacity: 0.5;
    }

    .icon-dots span:nth-child(2) { animation-delay: 0.2s; }
    .icon-dots span:nth-child(3) { animation-delay: 0.4s; }

    @@keyframes dotPulse {
        0%, 100% { transform: scale(1); opacity: 0.3; }
        50% { transform: scale(1.5); opacity: 1; }
    }

    .empty-state-premium {
        background: rgba(0, 0, 0, 0.02);
        border-radius: 30px;
        border: 1px dashed rgba(0, 0, 0, 0.1);
    }

    /* Premium Blog Manage Card */
    .blog-manage-card {
        background: rgba(255, 255, 255, 0.6) !important;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.05) !important;
        height: 170px !important; /* Fixed height for absolute consistency */
    }
    
    .blog-manage-card:hover {
        background: rgba(255, 255, 255, 0.9) !important;
        transform: translateY(-5px);
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.08) !important;
    }

    .manage-thumb-wrapper {
        position: relative;
        height: 170px !important;
        overflow: hidden;
    }

    .manage-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .blog-manage-card:hover .manage-thumb {
        transform: scale(1.1);
    }

    /* Unread Blog Styling */
    .unread-blog-card {
        background: rgba(13, 110, 253, 0.05) !important;
        border: 1px solid rgba(13, 110, 253, 0.2) !important;
        box-shadow: 0 10px 30px rgba(13, 110, 253, 0.1) !important;
    }
    
    .unread-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background: var(--bs-primary);
        color: white;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        z-index: 2;
        box-shadow: 0 4px 10px rgba(13, 110, 253, 0.3);
    }

    .animate-pulse {
        animation: pulse-red 2s infinite;
    }

    @@keyframes pulse-red {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.4); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(13, 110, 253, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(13, 110, 253, 0); }
    }
</style>
