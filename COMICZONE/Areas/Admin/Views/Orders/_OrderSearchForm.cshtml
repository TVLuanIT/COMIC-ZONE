@model COMICZONE.Areas.Admin.ViewModels.OrderSearchModel
@using COMICZONE.Models.Enums

<form method="get" class="order-search-form mb-4 border p-3 rounded bg-light shadow-sm">
    <div class="row align-items-end g-3">
        @* Basic Search *@
        <div class="col-md-3">
            <label class="form-label small fw-bold text-uppercase text-secondary">Từ khóa</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="ti ti-search"></i>
                </span>
                <input type="text" name="Keyword" value="@Model.Keyword" class="form-control border-start-0" placeholder="Mã ĐH, SĐT, User...">
            </div>
        </div>

        <div class="col-md-2">
            <label class="form-label small fw-bold text-uppercase text-secondary">Trạng thái</label>
            <select name="Status" class="form-select">
                <option value="">-- Tất cả --</option>
                @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                {
                    <option value="@status.ToString()" selected="@(Model.Status == status.ToString())">@status.GetDisplayName()</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <div class="form-check pb-2">
                <input class="form-check-input" type="checkbox" name="UnpaidOnly" value="true" @(Model.UnpaidOnly == true ? "checked" : "")>
                <label class="form-check-label small fw-bold text-uppercase text-secondary text-danger">Chưa thanh toán</label>
            </div>
        </div>

        <div class="col-md-5 d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#orderAdvancedSearch" aria-expanded="false">
                <i class="ti ti-adjustments-horizontal"></i> Nâng cao
            </button>
            <button type="submit" class="btn btn-primary px-4">
                <i class="ti ti-filter"></i> Lọc
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-refresh"></i>
            </a>
        </div>
    </div>

    @* Advanced Search (Collapsible) *@
    <div class="collapse mt-4 pt-4 border-top @(CheckIfAdvancedFiltersUsed() ? "show" : "")" id="orderAdvancedSearch">
        <div class="row g-3">
            @* User Section *@
            <div class="col-12"><h6 class="text-primary border-bottom pb-1">Thông tin khách hàng</h6></div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Username</label>
                <input type="text" name="Username" value="@Model.Username" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Email</label>
                <input type="text" name="UserEmail" value="@Model.UserEmail" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Số điện thoại</label>
                <input type="text" name="PhoneNumber" value="@Model.PhoneNumber" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Địa chỉ giao hàng</label>
                <input type="text" name="ShippingAddress" value="@Model.ShippingAddress" class="form-control">
            </div>

            @* Payment & Invoice *@
            <div class="col-12 mt-4"><h6 class="text-primary border-bottom pb-1">Thanh toán & Hóa đơn</h6></div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">PT Thanh toán</label>
                <select name="PaymentMethod" class="form-select">
                    <option value="">-- Tất cả --</option>
                    <option value="COD" selected="@(Model.PaymentMethod == "COD")">COD</option>
                    <option value="VNPAY" selected="@(Model.PaymentMethod == "VNPAY")">VNPAY</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Mã GD (VNPAY)</label>
                <input type="text" name="TransactionId" value="@Model.TransactionId" class="form-control">
            </div>
            <div class="col-md-3">
                <div class="form-check pt-4 mt-2">
                    <input class="form-check-input" type="checkbox" name="PaidOnly" value="true" @(Model.PaidOnly == true ? "checked" : "")>
                    <label class="form-check-label small fw-bold text-uppercase text-secondary text-success">Đã thanh toán (SUCCESS)</label>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Số hóa đơn</label>
                <input type="text" name="InvoiceNumber" value="@Model.InvoiceNumber" class="form-control">
            </div>

            @* Order Details *@
            <div class="col-12 mt-4"><h6 class="text-primary border-bottom pb-1">Đặc điểm đơn hàng</h6></div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Số tiền từ</label>
                <input type="number" name="TotalAmountMin" value="@Model.TotalAmountMin" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Số tiền đến</label>
                <input type="number" name="TotalAmountMax" value="@Model.TotalAmountMax" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Số lượng SP từ</label>
                <input type="number" name="ItemCountMin" value="@Model.ItemCountMin" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Số lượng SP đến</label>
                <input type="number" name="ItemCountMax" value="@Model.ItemCountMax" class="form-control">
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Ngày đặt từ</label>
                <input type="date" name="OrderDateFrom" value="@(Model.OrderDateFrom?.ToString("yyyy-MM-dd"))" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-secondary">Ngày đặt đến</label>
                <input type="date" name="OrderDateTo" value="@(Model.OrderDateTo?.ToString("yyyy-MM-dd"))" class="form-control">
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold text-uppercase text-secondary">Chứa sản phẩm (Tên)</label>
                <input type="text" name="ProductName" value="@Model.ProductName" class="form-control" placeholder="Tên sản phẩm trong đơn...">
            </div>
        </div>
    </div>

    @* Hidden Sort Info *@
    <input type="hidden" name="SortColumn" value="@Model.SortColumn">
    <input type="hidden" name="IsAscending" value="@Model.IsAscending.ToString().ToLower()">
</form>

@functions {
    bool CheckIfAdvancedFiltersUsed()
    {
        return !string.IsNullOrWhiteSpace(Model.Username) || !string.IsNullOrWhiteSpace(Model.UserEmail) ||
               !string.IsNullOrWhiteSpace(Model.PhoneNumber) || !string.IsNullOrWhiteSpace(Model.ShippingAddress) ||
               !string.IsNullOrWhiteSpace(Model.PaymentMethod) || !string.IsNullOrWhiteSpace(Model.TransactionId) ||
               Model.PaidOnly == true || !string.IsNullOrWhiteSpace(Model.InvoiceNumber) ||
               Model.TotalAmountMin.HasValue || Model.TotalAmountMax.HasValue ||
               Model.ItemCountMin.HasValue || Model.ItemCountMax.HasValue ||
               Model.OrderDateFrom.HasValue || Model.OrderDateTo.HasValue ||
               !string.IsNullOrWhiteSpace(Model.ProductName);
    }
}
