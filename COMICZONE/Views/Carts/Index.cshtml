@using COMICZONE.Extensions;
@model COMICZONE.Models.Cart

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container my-5 pt-4">
    <!-- TIẾN TRÌNH THANH TOÁN -->
    <div class="checkout-steps mb-5" data-aos="fade-down">
        <div class="step-item active">
            <div class="step-number">1</div>
            <span>Giỏ hàng</span>
        </div>
        <div class="step-line"></div>
        <div class="step-item">
            <div class="step-number">2</div>
            <span>Thanh toán</span>
        </div>
        <div class="step-line"></div>
        <div class="step-item">
            <div class="step-number">3</div>
            <span>Hoàn tất</span>
        </div>
    </div>

    @if (Model == null || Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="empty-cart-view" data-aos="zoom-in">
            <img src="~/images/empty_cart.png" alt="Giỏ hàng trống" class="empty-cart-img">
            <h2 class="fw-bold mb-3">Giỏ hàng của bạn đang trống</h2>
            <p class="text-muted mb-4">Có vẻ như bạn chưa chọn được bộ truyện ưng ý nào.<br>Hãy khám phá kho truyện khổng lồ của chúng tôi nhé!</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger btn-lg px-5 rounded-pill shadow">
                Khám phá ngay
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <!-- DANH SÁCH SẢN PHẨM -->
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold mb-0">Sản phẩm (@Model.CartItems.Count)</h4>
                    <a asp-controller="Home" asp-action="Index" class="text-danger text-decoration-none fw-semi-bold">
                        <i class="bi bi-arrow-left me-1"></i> Tiếp tục mua sắm
                    </a>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                    </div>
                }

                <div class="cart-items-wrapper">
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="cart-item-modern d-flex align-items-center justify-content-between flex-wrap gap-3" data-aos="fade-up">
                            <div class="d-flex align-items-center gap-3 flex-grow-1">
                                <div class="cart-img-box">
                                    <img src="@item.Product?.GetImagePath()" alt="@item.Product?.Name">
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-1">@item.Product?.Name</h5>
                                    <div class="text-danger fw-bold fs-5">@((item.Product?.Price ?? 0).ToString("N0")) ₫</div>
                                    <small class="text-muted">Bộ truyện bản quyền</small>
                                </div>
                            </div>

                            <div class="d-flex flex-column align-items-end gap-3">
                                <div class="cart-qty-wrapper">
                                    <button class="cart-qty-btn decrease-qty" data-id="@item.CartItemId"><i class="bi bi-dash"></i></button>
                                    <input type="number" 
                                           class="form-control border-0 bg-transparent text-center fw-bold quantity-input" 
                                           value="@item.Quantity" 
                                           min="1" 
                                           data-cartitem-id="@item.CartItemId"
                                           style="width: 50px;">
                                    <button class="cart-qty-btn increase-qty" data-id="@item.CartItemId"><i class="bi bi-plus"></i></button>
                                </div>
                                <div class="d-flex align-items-center gap-4">
                                    <div class="text-end">
                                        <div class="small text-muted">Thành tiền</div>
                                        <div class="fw-bold text-danger item-total">@((item.Quantity * (item.Product?.Price ?? 0)).ToString("N0")) ₫</div>
                                    </div>
                                    <a asp-action="Remove" asp-route-cartItemId="@item.CartItemId" class="btn btn-light rounded-circle text-danger p-2 shadow-sm">
                                        <i class="bi bi-trash fs-5"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- THANH TOÁN -->
            <div class="col-lg-4">
                <partial name="_Payment" model="Model" />
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://www.paypal.com/sdk/js?client-id=@ViewBag.PaypalClientId"></script>
    <script src="~/js/paypal.js" asp-append-version="true"></script>
    
    <script>
        // Xử lý nút tăng giảm số lượng (nếu chưa có trong paypal.js hoặc site.js)
        document.querySelectorAll('.increase-qty').forEach(btn => {
            btn.addEventListener('click', function() {
                const input = this.parentElement.querySelector('.quantity-input');
                input.value = parseInt(input.value) + 1;
                input.dispatchEvent(new Event('change'));
            });
        });

        document.querySelectorAll('.decrease-qty').forEach(btn => {
            btn.addEventListener('click', function() {
                const input = this.parentElement.querySelector('.quantity-input');
                if (parseInt(input.value) > 1) {
                    input.value = parseInt(input.value) - 1;
                    input.dispatchEvent(new Event('change'));
                }
            });
        });
    </script>
}