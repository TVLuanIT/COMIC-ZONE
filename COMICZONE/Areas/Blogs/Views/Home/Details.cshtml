@model COMICZONE.Models.Blog

@{
    ViewData["Title"] = Model.Title;
}

<!-- PREMIUM ARTICLE HEADER -->
<div class="article-hero" style="background-image: url('@(string.IsNullOrEmpty(Model.Thumbnail) ? "/blogs/images/default-blog.png" : (Model.Thumbnail.StartsWith("http") ? Model.Thumbnail : "/images/blogs/" + Model.Thumbnail))');">
    <div class="hero-glass-overlay"></div>
    <div class="container position-relative z-index-3">
        <div class="row justify-content-center">
            <div class="col-lg-10 text-center">
                <div class="breadcrumb-glass mb-4" data-aos="fade-down">
                    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                    <span class="sep">/</span>
                    <a asp-area="Blogs" asp-controller="Home" asp-action="Index">Blog</a>
                    <span class="sep">/</span>
                    <span class="active">Bài viết</span>
                </div>
                
                <div class="category-badges mb-4" data-aos="zoom-in">
                    @foreach(var cat in Model.Categories)
                    {
                        <span class="badge-glass">@cat.Name</span>
                    }
                </div>

                <h1 class="article-hero-title mb-4" data-aos="fade-up">@Model.Title</h1>
                
                <div class="author-info-glass d-flex align-items-center justify-content-center" data-aos="fade-up" data-aos-delay="100">
                    <img src="@(string.IsNullOrEmpty(Model.Author?.Avatar) ? "/uploads/avatar/default.png" : Model.Author.Avatar)" alt="Author" class="author-avatar me-3">
                    <div class="text-start">
                        <div class="fw-bold text-white small">@(Model.Author?.Username ?? "Admin")</div>
                        <div class="text-white-50 x-small">@Model.Createdat.ToString("MMMM dd, yyyy") • 5 min read</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center g-5">
            <!-- ARTICLE CONTENT -->
            <div class="col-lg-8 blog-main-column" data-aos="fade-up">
                <div class="article-excerpt">
                    <i class="bi bi-quote fs-1 text-primary-light"></i>
                    <p>@Model.Shortdescription</p>
                </div>

                <div class="article-body lh-lg">
                    @Html.Raw(Model.Content)
                </div>

                <!-- SHARE BAR -->
                <div class="article-footer-tools d-flex justify-content-between align-items-center mt-5 py-4 border-top border-bottom">
                    <div class="tags-list">
                         <span class="fw-bold text-uppercase small text-muted me-3">Tags:</span>
                         <span class="badge bg-light text-secondary rounded-pill px-3">Manga</span>
                         <span class="badge bg-light text-secondary rounded-pill px-3">Review</span>
                    </div>
                    <div class="share-group d-flex gap-2">
                        <a href="#" class="share-icon fb"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="share-icon tw"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="share-icon link"><i class="bi bi-link-45deg"></i></a>
                    </div>
                </div>

                <!-- COMMENTS SECTION -->
                <div class="comments-area mt-5" id="comments">
                    <h3 class="fw-bold mb-4">Thảo luận (@Model.BlogComments.Count)</h3>
                    
                    @if (Context.Session.GetString("UserId") != null)
                    {
                        <div class="comment-form-premium mb-5">
                            <textarea id="commentContent" class="form-control-premium" rows="3" placeholder="Để lại cảm nhận của bạn..."></textarea>
                            <div class="text-end mt-3">
                                <button class="btn btn-primary rounded-pill px-4">Gửi bình luận <i class="bi bi-send-fill ms-2"></i></button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="auth-suggest mb-5 text-center p-4 bg-light rounded-4">
                             <p class="mb-3 fw-medium">Bạn cần đăng nhập để bình luận</p>
                             <a asp-area="Account" asp-controller="Authentication" asp-action="Login" class="btn btn-dark rounded-pill px-4">Đăng nhập ngay</a>
                        </div>
                    }

                    <div class="comments-list">
                        @foreach(var comment in Model.BlogComments.OrderByDescending(c => c.Createdat))
                        {
                            <div class="comment-node mb-4">
                                <div class="d-flex gap-3">
                                    <img src="@(string.IsNullOrEmpty(comment.User?.Avatar) ? "/uploads/avatar/default.png" : comment.User.Avatar)" class="comment-avatar">
                                    <div class="comment-body">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="mb-0 fw-bold">@(comment.User.Username)</h6>
                                            <span class="x-small text-muted">@comment.Createdat.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                        <p class="text-secondary mb-0">@comment.Content</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- SIDEBAR DETAILS -->
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 110px;">
                    <div class="sidebar-card-premium p-4 mb-4">
                        <h6 class="fw-bold mb-3 d-flex align-items-center"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Có thể bạn thích</h6>
                        @if (ViewBag.RelatedBlogs != null)
                        {
                            foreach (var related in (IEnumerable<COMICZONE.Models.Blog>)ViewBag.RelatedBlogs)
                            {
                                <a asp-area="Blogs" asp-controller="Home" asp-action="Details" asp-route-id="@related.Id" class="related-item d-flex gap-3 mb-4 text-decoration-none">
                                    <img src="@(string.IsNullOrEmpty(related.Thumbnail) ? "/images/no-image.jpg" : (related.Thumbnail.StartsWith("http") ? related.Thumbnail : "/images/blogs/" + related.Thumbnail))" class="related-thumb">
                                    <div>
                                        <h6 class="related-title text-dark line-clamp-2">@related.Title</h6>
                                        <span class="x-small text-muted">@related.Createdat.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </a>
                            }
                        }
                    </div>

                    <div class="p-5 rounded-4 text-center" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                         <img src="/images/logo-nobg.png" style="width: 80px;" class="mb-3 opacity-75">
                         <h5 class="text-white fw-bold">COMICZONE</h5>
                         <p class="x-small text-white-50">Chuyên cung cấp truyện tranh bản quyền chất lượng nhất.</p>
                         <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-4 mt-2">Ghé thăm Shop</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

