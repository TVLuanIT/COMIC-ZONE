@model COMICZONE.Models.MarketplacePost

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa bài đăng";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">⚠️ Xác nhận xóa bài đăng #@Model.Id</h5>
            <a asp-action="Index" class="btn btn-light btn-sm">⬅ Quay lại</a>
        </div>

        <div class="card-body">
            <div class="alert alert-danger">
                Bạn có chắc chắn muốn xóa <strong>vĩnh viễn</strong> bài đăng này không? Hành động này <strong>không thể hoàn tác</strong>.
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    @{var firstImg = Model.MarketplacePostImages?.FirstOrDefault()?.Filename;}
                    @if (firstImg != null)
                    {
                        <img src="/images/marketplace/@firstImg" class="img-fluid rounded-3 border" style="max-height: 250px; object-fit: contain; width: 100%; background: #f8f9fa;" />
                    }
                    else
                    {
                        <div class="bg-light rounded-3 d-flex align-items-center justify-content-center border" style="height: 200px;">
                            <i class="ti ti-photo-off fs-1 text-muted"></i>
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <h5 class="fw-bold">@Model.Title</h5>
                    <div class="row g-3 mt-2">
                        <div class="col-6">
                            <label class="text-muted small">Người bán</label>
                            <p class="fw-semibold mb-0">@Model.Seller?.Username</p>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">Giá</label>
                            <p class="fw-bold text-success mb-0">@Model.Price.ToString("N0")đ</p>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">Danh mục</label>
                            <p class="mb-0">@Model.Category</p>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">Tình trạng</label>
                            <p class="mb-0">@Model.Condition</p>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">Trạng thái</label>
                            <p class="mb-0">@Model.Status</p>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">Ngày đăng</label>
                            <p class="mb-0">@Model.Createdat?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer text-end bg-white">
            <form asp-action="Delete" class="d-inline">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                <button type="submit" class="btn btn-danger">🗑 Xóa vĩnh viễn</button>
            </form>
        </div>
    </div>
</div>
