@model COMICZONE.Models.Customer

<div class="premium-content-card" data-aos="fade-up">

    <div class="card-header-premium">
        <h2>Đổi mật khẩu</h2>
        <a asp-action="MyProfile" asp-controller="UserProfiles" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-sm btn-link text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <form asp-action="ChangePassword" asp-controller="UserProfiles" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 py-2 small border-0 mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            </div>
        }

        <div class="row g-4">
            <div class="col-md-12">
                <div class="profile-input-group">
                    <label class="profile-input-label">Mật khẩu hiện tại</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-4 ps-3">
                            <i class="bi bi-shield-lock text-muted"></i>
                        </span>
                        <input name="currentPassword" type="password" class="form-control profile-input-premium border-start-0 rounded-end-4" placeholder="••••••••" required />
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="profile-input-group">
                    <label class="profile-input-label">Mật khẩu mới</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-4 ps-3">
                            <i class="bi bi-key text-muted"></i>
                        </span>
                        <input name="newPassword" type="password" class="form-control profile-input-premium border-start-0 rounded-end-4" placeholder="••••••••" required />
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="profile-input-group">
                    <label class="profile-input-label">Xác nhận mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-4 ps-3">
                            <i class="bi bi-check-circle text-muted"></i>
                        </span>
                        <input name="confirmPassword" type="password" class="form-control profile-input-premium border-start-0 rounded-end-4" placeholder="••••••••" required />
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-3 mt-4 pt-3 border-top border-light">
            <button type="submit" class="btn-auth-premium py-2 px-5 w-auto">Cập nhật mật khẩu</button>
            <a asp-action="MyProfile" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-outline-secondary rounded-pill py-2 px-5 d-flex align-items-center">Hủy</a>
        </div>

    </form>

</div>