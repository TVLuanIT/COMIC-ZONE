@model COMICZONE.Models.ProductReview
@{
    var reviewId = Model.Reviewid;
    var currentAvatar = Context.Session.GetString("Avatar");
    // var currentAvatar = ViewBag.CurrentUserAvatar as string;
    var username = Model.User?.Username ?? "Người dùng ẩn danh";
}

<div class="reply-form-container mt-2" id="reply-form-@reviewId" style="display:none;">
    <form class="reply-form d-flex gap-2" data-review-id="@reviewId">
        <!-- Avatar người dùng -->
        @await Component.InvokeAsync("UserAvatar", new { avatarUrl = currentAvatar, size = 32 })

        <div class="flex-grow-1 d-flex flex-column">
            <!-- Textarea -->
            <textarea class="form-control form-control-sm mb-1"
                      placeholder="Viết phản hồi..."></textarea>

            <!-- Nút gửi / hủy -->
            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-sm btn-primary">Gửi</button>
                <button type="button" class="btn btn-sm btn-secondary cancel-reply">Hủy</button>
            </div>
        </div>
    </form>
</div>