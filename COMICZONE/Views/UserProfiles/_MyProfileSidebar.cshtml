@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var avatar = Context.Session.GetString("Avatar");
    var username = Context.Session.GetString("Username");

    var firstChar = !string.IsNullOrEmpty(username)
        ? username.Substring(0, 1).ToUpper()
        : "U";
}

<div class="profile-left">

    <div class="profile-user">

        <div class="profile-avatar" onclick="openAvatarUpload()">

            <input type="file"
                   id="avatarUpload"
                   accept="image/*"
                   hidden
                   onchange="uploadAvatar(this)" />

            @if (!string.IsNullOrEmpty(avatar))
            {
                @await Component.InvokeAsync("UserAvatar",
                new { avatarUrl = avatar, size = 80 })
                        }
            else
            {
                <div class="default-avatar">
                    @firstChar
                </div>
            }

            <div class="change-avatar-text">
                Thay đổi avatar
            </div>

        </div>

        <div class="username">
            @username
        </div>

    </div>

    <div class="profile-sidebar">

        <ul class="profile-menu">

            <li class="@(action == "MyProfile" ? "active" : "")">
                <a asp-controller="UserProfiles"
                   asp-action="MyProfile"
                   class="menu-link">
                    Thông tin cá nhân
                </a>
            </li>

            <li class="@(action == "MyOrders" ? "active" : "")">
                <a asp-controller="UserProfiles"
                   asp-action="MyOrders"
                   class="menu-link">
                    Đơn hàng của tôi
                </a>
            </li>

            <li class="@(action == "MyReviews" ? "active" : "")">
                <a asp-controller="UserProfiles"
                   asp-action="MyReviews"
                   class="menu-link">
                    Đánh giá của tôi
                </a>
            </li>

            <li class="@(action == "Notifications" ? "active" : "")">
                <a asp-controller="UserProfiles"
                   asp-action="Notifications"
                   class="menu-link">
                    Thông báo
                </a>
            </li>

            <li class="@(action == "Settings" ? "active" : "")">
                <a asp-controller="UserProfiles"
                   asp-action="Settings"
                   class="menu-link">
                    Cài đặt
                </a>
            </li>

        </ul>

    </div>

</div>