@model COMICZONE.Models.InventoryLog

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm nhật ký kho";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Nhật ký kho</a></li>
                    <li class="breadcrumb-item active">Thêm mới</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold"><i class="ti ti-plus me-2"></i>Thông tin nhật ký mới</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="ProductId" class="form-label fw-bold">Sản phẩm</label>
                            <select asp-for="ProductId" class="form-select select2" asp-items="ViewBag.ProductId">
                                <option value="">-- Chọn sản phẩm --</option>
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChangeAmount" class="form-label fw-bold">Số lượng thay đổi</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-hash"></i></span>
                                <input asp-for="ChangeAmount" class="form-control" placeholder="Nhập số lượng (vd: 10 hoặc -10)" />
                            </div>
                            <span asp-validation-for="ChangeAmount" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Type" class="form-label fw-bold">Loại giao dịch</label>
                            <select asp-for="Type" class="form-select">
                                <option value="Import">Nhập kho (+)</option>
                                <option value="Export">Xuất kho (-)</option>
                            </select>
                            <span asp-validation-for="Type" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CreatedAt" class="form-label fw-bold">Ngày tạo (Tùy chọn)</label>
                            <input asp-for="CreatedAt" class="form-control" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="CreatedAt" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">
                                <i class="ti ti-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="ti ti-device-floppy me-1"></i> Lưu nhật ký
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

