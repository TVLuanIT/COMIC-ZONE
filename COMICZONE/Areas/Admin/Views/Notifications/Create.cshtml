@model COMICZONE.Models.Notification

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tạo thông báo mới";
}

<div class="container-fluid">
    <!-- Breadcrumb & Title -->
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Thông báo</a></li>
                    <li class="breadcrumb-item active">Tạo mới</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="ti ti-plus me-2 text-primary"></i>Nhập thông tin thông báo
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm mb-4" role="alert"></div>
                        
                        <div class="row g-4">
                            <div class="col-md-12">
                                <div class="form-check form-switch p-3 border rounded-3 bg-light-subtle mb-3">
                                    <input class="form-check-input ms-0 me-2" type="checkbox" name="sendToAll" value="true" id="sendToAllCheckBox">
                                    <label class="form-check-label fw-bold" for="sendToAllCheckBox">
                                        <i class="ti ti-users me-1 text-primary"></i> Gửi cho tất cả người dùng
                                    </label>
                                    <p class="text-muted small mb-0 mt-1">Bật tùy chọn này để gửi thông báo này tới toàn bộ thành viên trong hệ thống.</p>
                                </div>
                            </div>

                            <div class="col-md-6" id="userIdContainer">
                                <div class="form-group mb-0">
                                    <label asp-for="UserId" class="form-label fw-bold">Người nhận</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="ti ti-user"></i></span>
                                        <select asp-for="UserId" class="form-select border-start-0" asp-items="ViewBag.UserId"></select>
                                    </div>
                                    <span asp-validation-for="UserId" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group mb-0">
                                    <label asp-for="CreatedBy" class="form-label fw-bold">Người gửi</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="ti ti-user-check"></i></span>
                                        <select asp-for="CreatedBy" class="form-select border-start-0" asp-items="ViewBag.CreatedBy">
                                            <option value="">-- Hệ thống --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="CreatedBy" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group mb-0">
                                    <label asp-for="Title" class="form-label fw-bold">Tiêu đề</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="ti ti-heading"></i></span>
                                        <input asp-for="Title" class="form-control border-start-0" placeholder="Nhập tiêu đề thông báo..." />
                                    </div>
                                    <span asp-validation-for="Title" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group mb-0">
                                    <label asp-for="Message" class="form-label fw-bold">Nội dung</label>
                                    <textarea asp-for="Message" class="form-control" rows="4" placeholder="Nhập nội dung chi tiết..."></textarea>
                                    <span asp-validation-for="Message" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-group mb-0">
                                    <label asp-for="Link" class="form-label fw-bold">Liên kết (Link)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="ti ti-link"></i></span>
                                        <input asp-for="Link" class="form-control border-start-0" placeholder="https://..." />
                                    </div>
                                    <span asp-validation-for="Link" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-top d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-light px-4">
                                <i class="ti ti-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-5 shadow-sm">
                                <i class="ti ti-device-floppy me-1"></i> Lưu thông báo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sendToAllCheckBox = document.getElementById("sendToAllCheckBox");
            const userIdContainer = document.getElementById("userIdContainer");

            if (sendToAllCheckBox && userIdContainer) {
                sendToAllCheckBox.addEventListener("change", function () {
                    if (this.checked) {
                        userIdContainer.style.display = "none";
                    } else {
                        userIdContainer.style.display = "block";
                    }
                });
            }
        });
    </script>
}

