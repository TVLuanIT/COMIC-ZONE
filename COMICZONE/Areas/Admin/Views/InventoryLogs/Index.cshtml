@model IEnumerable<COMICZONE.Models.InventoryLog>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Nhật ký kho hàng";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active">Nhật ký kho</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold"><i class="ti ti-history me-2"></i>Danh sách nhật ký</h5>
            <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="ti ti-plus me-1"></i> Thêm mới
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Sản phẩm</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-center">Loại giao dịch</th>
                            <th class="text-center">Ngày tạo</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="ms-2">
                                            <h6 class="mb-0 fw-bold text-dark">@item.Product.Name</h6>
                                            <small class="text-muted">ID: #@item.Product.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @{
                                        var isPositive = item.ChangeAmount > 0;
                                        var colorClass = isPositive ? "text-success" : "text-danger";
                                        var prefix = isPositive ? "+" : "";
                                    }
                                    <span class="fw-bold @colorClass">@prefix@item.ChangeAmount</span>
                                </td>
                                <td class="text-center">
                                    @if (item.Type?.ToLower() == "import" || item.Type?.Contains("Nhập") == true) {
                                        <span class="badge bg-success-subtle text-success px-2 py-1 rounded">
                                            <i class="ti ti-arrow-up-right me-1"></i>Nhập kho
                                        </span>
                                    } else {
                                        <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded">
                                            <i class="ti ti-arrow-down-left me-1"></i>Xuất kho
                                        </span>
                                    }
                                </td>
                                <td class="text-center text-muted">
                                    @(item.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-sm text-info" title="Chi tiết">
                                            <i class="ti ti-eye fs-5"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm text-primary" title="Chỉnh sửa">
                                            <i class="ti ti-edit fs-5"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm text-danger" title="Xóa">
                                            <i class="ti ti-trash fs-5"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="ti ti-database-off fs-1 text-muted mb-2"></i>
                    <p class="text-muted">Chưa có dữ liệu nhật ký kho.</p>
                </div>
            }
        </div>
    </div>
</div>
