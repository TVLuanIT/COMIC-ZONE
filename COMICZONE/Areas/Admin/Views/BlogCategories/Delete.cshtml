@model COMICZONE.Models.BlogCategory

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa danh mục blog";
}

<div class="container-fluid px-4 py-5">
    <div class="mb-5 text-center">
        <div class="bg-danger-subtle d-inline-flex p-4 rounded-circle mb-4 bounce-in">
            <i class="ti ti-alert-triangle fs-1 text-danger"></i>
        </div>
        <h1 class="h3 fw-bold mb-1 text-dark">Xác nhận xóa danh mục</h1>
        <p class="text-muted">Hành động này không thể hoàn tác. Vui lòng kiểm tra kỹ trước khi xác nhận.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8">
            <div class="card border-0 shadow-lg overflow-hidden mb-4" style="border-radius: 12px;">
                <div class="card-header bg-danger py-3">
                    <h5 class="card-title mb-0 text-white fw-semibold">Cảnh báo quan trọng</h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (Model.Blogs != null && Model.Blogs.Any())
                    {
                        <div class="alert alert-warning border-0 shadow-sm mb-4 d-flex align-items-center gap-3">
                            <i class="ti ti-info-circle fs-3 text-warning"></i>
                            <div>
                                Danh mục <strong>"@Model.Name"</strong> đang chứa <strong>@Model.Blogs.Count bài viết</strong>. 
                                Việc xóa danh mục này có thể ảnh hưởng đến hiển thị của các bài viết liên quan.
                            </div>
                        </div>
                    }

                    <div class="bg-light rounded-4 p-4 border mb-4">
                        <div class="row g-4">
                            <div class="col-sm-4">
                                <span class="small text-muted text-uppercase fw-bold ls-wide">Tên danh mục</span>
                            </div>
                            <div class="col-sm-8">
                                <span class="fw-bold text-dark fs-5">@Model.Name</span>
                            </div>
                            
                            <div class="col-sm-4">
                                <span class="small text-muted text-uppercase fw-bold ls-wide">Slug (URL)</span>
                            </div>
                            <div class="col-sm-8">
                                <span class="text-primary font-monospace bg-white px-2 py-1 rounded border small">@Model.Slug</span>
                            </div>

                            <div class="col-sm-4">
                                <span class="small text-muted text-uppercase fw-bold ls-wide">ID hệ thống</span>
                            </div>
                            <div class="col-sm-8">
                                <span class="text-muted fw-medium">#@Model.Id</span>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-medium rounded-pill transition-all hover:bg-light">
                                <i class="ti ti-arrow-left me-1"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-danger px-5 py-2 fw-bold shadow-sm rounded-pill transition-all transform hover:scale-105">
                                <i class="ti ti-trash me-1"></i> Xác nhận xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="text-center mt-3">
                <p class="small text-muted">
                    <i class="ti ti-info-circle me-1"></i> 
                    Lưu ý: Mọi liên kết URL cũ trỏ đến danh mục này sẽ hiển thị lỗi 404 sau khi xóa.
                </p>
            </div>
        </div>
    </div>
</div>
