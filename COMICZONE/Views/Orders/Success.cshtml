@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height:70vh;">
    <div class="card shadow-lg border-0 text-center" style="max-width:500px; width:100%;">
        <div class="card-body p-5">
            <div class="mb-4">
                <div style="font-size:70px;">✅</div>
            </div>

            <h3 class="text-success mb-3">Đặt hàng thành công!</h3>

            <p class="text-muted">
                Cảm ơn bạn đã mua hàng tại <strong>ComicZone</strong>.<br>
                Đơn hàng của bạn đang được xử lý.
            </p>

            <hr class="my-4" />

            <div class="d-grid gap-2">
                <a asp-controller="UserProfiles"
                   asp-action="MyOrders"
                   class="btn btn-outline-primary">
                    Xem đơn hàng của tôi
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary">
                    Tiếp tục mua sắm
                </a>
            </div>
        </div>
    </div>
</div>