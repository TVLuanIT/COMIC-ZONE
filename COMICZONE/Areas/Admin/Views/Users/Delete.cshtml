@model COMICZONE.Models.User

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa người dùng";
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-danger mb-1"><i class="ti ti-user-x me-2"></i> Xóa người dùng</h4>
            <small class="text-muted">Hành động này không thể hoàn tác</small>
        </div>
        <a asp-action="Index" class="btn btn-light border shadow-sm"><i class="ti ti-arrow-left"></i> Quay lại</a>
    </div>

    <!-- USER CARD -->
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body p-4">
            <div class="row">
                <div class="col-lg-4 border-end text-center">
                    <img src="@Model.Avatar.AvatarOrDefault()" class="rounded-circle shadow mb-3" width="140" height="140" style="object-fit:cover;" />
                    
                    <h5 class="fw-bold">@Model.Username</h5>
                    
                    <div>
                        @if (Model.Isactive)
                        {
                            <span class="badge bg-success-subtle text-success px-3 py-2">Đang hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger px-3 py-2">Bị khóa</span>
                        }

                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <small class="text-muted">Email</small>
                                <div class="fw-semibold">@Model.Email</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <small class="text-muted">Vai trò</small>
                                <span class="badge bg-primary-subtle text-primary px-3 py-2">@Model.Role</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <small class="text-muted">Ngày tạo</small>
                                <div>@Model.Createdat.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>

                        <!-- DELETE BUTTON -->
                        @if (ViewBag.RelatedData == null || !((Dictionary<string, IEnumerable<string>>)ViewBag.RelatedData).Any())
                        {
                            <form asp-action="Delete" method="post" >
                                @Html.AntiForgeryToken()

                                <input type="hidden" asp-for="Id" />

                                <div class="d-flex justify-content-end mt-3">
                                    <button type="submit" class="btn btn-danger px-4 me-2">
                                        <i class="ti ti-trash"></i> Xóa người dùng
                                    </button>
                                    <a asp-action="Index" class="btn btn-light border">
                                        Hủy
                                    </a>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RELATED DATA -->
    @if (ViewBag.RelatedData != null && ((Dictionary<string, IEnumerable<string>>)ViewBag.RelatedData).Any())
    {
        <div class="alert alert-warning">
            <strong>Không thể xóa người dùng này!</strong> Người dùng vẫn còn dữ liệu liên quan:

            <div class="mt-3">
                @foreach (var entry in (Dictionary<string, IEnumerable<string>>)ViewBag.RelatedData)
                {
                    <div class="card mb-2">
                        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                            <span>
                                @switch (entry.Key)
                                {
                                    case "Notifications nhận":
                                        @:🛎️
                                        break;
                                    case "Notifications tạo bởi":
                                        @:📝
                                        break;
                                    case "Orders":
                                        @:📦
                                        break;
                                    case "Carts":
                                        @:🛒
                                        break;
                                }

                                @entry.Key (@entry.Value.Count())
                            </span>

                            @if (entry.Value.Count() > 3)
                            {
                                <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@entry.Key.Replace(" ", "")">Xem thêm</button>
                            }
                        </div>

                        <ul class="list-group list-group-flush collapse @(entry.Value.Count() <= 3 ? "show" : "")" id="collapse-@entry.Key.Replace(" ", "")">
                            @foreach (var detail in entry.Value)
                            {
                                <li class="list-group-item">@detail</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    }
</div>