@model COMICZONE.Areas.Admin.ViewModels.AdminSearchModel

@if (Model.TotalPages > 1)
{
    var startPage = Math.Max(1, Model.PageNumber - 2);
    var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
    var queryParams = $"keyword={Model.Keyword}&statusFilter={Model.StatusFilter}&roleFilter={Model.RoleFilter}&typeFilter={Model.TypeFilter}" +
                       $"&sortColumn={Model.SortColumn}&isAscending={Model.IsAscending.ToString().ToLower()}";

    <div class="d-flex justify-content-between align-items-center mt-4 px-3">
        <div class="text-secondary small">
            Hiển thị trang <strong>@Model.PageNumber</strong> / <strong>@Model.TotalPages</strong> 
            (Tổng <strong>@Model.TotalItems</strong> mục)
        </div>

        <nav aria-label="Admin Page navigation">
            <ul class="pagination pagination-sm mb-0 shadow-sm">
                @* First & Previous *@
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" href="?@queryParams&page=1">
                        <i class="ti ti-chevrons-left"></i>
                    </a>
                </li>
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" href="?@queryParams&page=@(Model.PageNumber - 1)">
                        <i class="ti ti-chevron-left"></i>
                    </a>
                </li>

                @* Numeric Pages *@
                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                        <a class="page-link" href="?@queryParams&page=@i">@i</a>
                    </li>
                }

                @* Next & Last *@
                <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?@queryParams&page=@(Model.PageNumber + 1)">
                        <i class="ti ti-chevron-right"></i>
                    </a>
                </li>
                <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?@queryParams&page=@Model.TotalPages">
                        <i class="ti ti-chevrons-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
