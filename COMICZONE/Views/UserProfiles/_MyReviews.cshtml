@model List<COMICZONE.Models.ProductReview>

@Html.AntiForgeryToken()

@if (Model == null || !Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-chat-dots text-muted display-1 mb-4"></i>
        <p class="text-muted fs-5">Bạn chưa có đánh giá nào.</p>
    </div>
}
else
{
    <div class="reviews-list">
        @foreach (var review in Model)
        {
            <div class="profile-review-card" data-aos="fade-up">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <a asp-controller="Products" asp-action="Detail" asp-route-id="@review.Productid" 
                           class="fw-800 text-dark text-decoration-none hover-primary fs-5 d-block mb-1">
                            @review.Product?.Name
                        </a>
                        <div class="text-warning mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star") me-1"></i>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="text-muted small me-3">
                            <i class="bi bi-calendar3 me-1"></i> @review.Createdat?.ToString("dd/MM/yyyy")
                        </span>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light rounded-circle" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                <li>
                                    <a href="javascript:void(0)" class="dropdown-item text-danger delete-review" data-id="@review.Reviewid">
                                        <i class="bi bi-trash3 me-2"></i>Xóa đánh giá
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="bg-light p-3 rounded-4 position-relative">
                    <i class="bi bi-quote position-absolute top-0 start-0 translate-middle-y ms-3 text-primary opacity-25 fs-1"></i>
                    <p class="mb-0 text-secondary" style="line-height: 1.6;">@review.Reviewcontent</p>
                </div>
            </div>
        }

        <!-- Pagination -->
        @await Html.PartialAsync("_Pagination", new PaginationModel
        {
            CurrentPage = ViewBag.ReviewPage,
            TotalPages = ViewBag.ReviewTotalPages,
            Action = "MyReviews",
            Controller = "UserProfiles",
            PageParam = "reviewPage",
            ExtraParams = new Dictionary<string, string>
            {
                { "replyPage", Convert.ToString(ViewBag.ReplyPage ?? 1) },
                { "tab", "reviews" }
            }
        })
    </div>
}