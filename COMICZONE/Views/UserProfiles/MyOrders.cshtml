@model List<COMICZONE.Models.Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user-profile.css" asp-append-version="true" />
}

<div class="profile-container-premium">

    <!-- SIDEBAR -->
    @await Html.PartialAsync("_MyProfileSidebar.cshtml")

    <div class="profile-glass-content">
        @if (ViewBag.Page == "OrderDetails")
        {
            @await Html.PartialAsync("_OrderDetails.cshtml", (COMICZONE.Models.Order)ViewBag.Order)
        }
        else
        {
            @await Html.PartialAsync("_MyOrders.cshtml", Model)
        }
    </div>

</div>