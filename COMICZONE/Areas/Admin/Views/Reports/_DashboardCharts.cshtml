<div class="row g-3">
    <div class="col-xl-8 col-12">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-header bg-white py-4 d-flex justify-content-between align-items-center border-bottom-0">
                <h4 class="mb-0">Doanh thu</h4>
                <span id="salesChartTitle" class="badge bg-light-primary text-primary">7 ngày qua</span>
            </div>
            <div class="card-body">
                <div class="position-relative w-100" style="height: 420px;">
                    <div id="salesLoading" class="chart-loader">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                    <canvas id="salesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-12">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-header bg-white py-4 border-bottom-0">
                <h4 class="mb-0">Trạng thái đơn hàng</h4>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column justify-content-center position-relative w-100" style="height: 420px;">
                    <div id="statusLoading" class="chart-loader">
                        <div class="spinner-border text-info" role="status"></div>
                    </div>
                    <div id="noDataAlert" class="text-center d-none py-10">
                        <i class="ti ti-database-off fs-1 text-muted mb-2 d-block"></i>
                        <p class="text-muted">Chưa có dữ liệu đơn hàng</p>
                    </div>
                    <canvas id="orderStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
