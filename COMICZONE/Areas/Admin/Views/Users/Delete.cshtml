@model COMICZONE.Models.User

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa người dùng";
}

<div class="container-fluid">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-danger mb-1">
                <i class="ti ti-user-x me-2"></i>
                Xóa người dùng
            </h4>

            <small class="text-muted">
                Hành động này không thể hoàn tác
            </small>
        </div>

        <a asp-action="Index" class="btn btn-light border shadow-sm">
            <i class="ti ti-arrow-left"></i>
            Quay lại
        </a>
    </div>

    <!-- CARD -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="row">
                <!-- AVATAR -->
                <div class="col-lg-4 border-end text-center">
                    <img src="@Model.Avatar.AvatarOrDefault()"
                         class="rounded-circle shadow mb-3"
                         width="140"
                         height="140"
                         style="object-fit:cover;" />

                    <h5 class="fw-bold">
                        @Model.Username
                    </h5>

                    <div>
                        @if (Model.Isactive)
                        {
                            <span class="badge bg-success-subtle text-success px-3 py-2">
                                Đang hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger px-3 py-2">
                                Bị khóa
                            </span>
                        }
                    </div>
                </div>

                <!-- INFO -->
                <div class="col-lg-8">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <small class="text-muted">
                                    Email
                                </small>

                                <div class="fw-semibold">
                                    @Model.Email
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <small class="text-muted">
                                    Vai trò
                                </small>

                                <div>
                                    <span class="badge bg-primary-subtle text-primary px-3 py-2">
                                        @Model.Role
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <small class="text-muted">
                                    Ngày tạo
                                </small>

                                <div>
                                    @Model.Createdat.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- WARNING -->
                    <div class="alert alert-danger mt-4">
                        <i class="ti ti-alert-triangle me-2"></i>

                        Bạn có chắc chắn muốn xóa người dùng này không?
                        Hành động này không thể hoàn tác.
                    </div>

                    <!-- BUTTON -->
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />

                        <button type="submit" class="btn btn-danger px-4">
                            <i class="ti ti-trash"></i>
                            Xóa người dùng
                        </button>

                        <a asp-action="Index" class="btn btn-light border ms-2">
                            Hủy
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>