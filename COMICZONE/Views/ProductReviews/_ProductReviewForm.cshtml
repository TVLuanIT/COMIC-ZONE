@model COMICZONE.Models.ProductReview
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    var userIdStr = Context.Session.GetString("UserId");
    bool isLoggedIn = !string.IsNullOrEmpty(userIdStr);
    bool canReview = ViewBag.CanReview ?? false;
}

@if (isLoggedIn && !canReview)
{
    <div class="review-lock-message text-center p-5 border rounded-4 glass-morphism mb-4 shadow-sm" data-aos="fade-up">
        <div class="lock-icon-wrapper mb-4">
            <div class="lock-circle bg-warning-subtle text-warning mx-auto d-flex align-items-center justify-content-center rounded-circle" style="width: 80px; height: 80px;">
                <i class="bi bi-shield-lock-fill fs-1"></i>
            </div>
        </div>
        <h4 class="fw-bold text-dark mb-3">Tính năng dành cho khách hàng</h4>
        <p class="text-secondary mx-auto mb-4" style="max-width: 500px;">
            Bạn chỉ có thể gửi đánh giá cho sản phẩm này sau khi <strong>đơn hàng đã hoàn thành</strong>. Hãy hoàn tất việc mua sắm để chia sẻ trải nghiệm của bạn nhé!
        </p>
        <div class="divider-short bg-light-gray mx-auto mb-4" style="width: 60px; height: 2px;"></div>
        <a asp-area="Account" asp-action="MyOrders" asp-controller="UserProfiles" class="btn btn-outline-primary rounded-pill px-4 transition-smooth">
            <i class="bi bi-bag-check me-2"></i>Xem đơn hàng của tôi
        </a>
    </div>
}
else
{
    <div class="review-form-premium" data-aos="fade-up" data-loggedin="@isLoggedIn.ToString().ToLower()">
        <div class="summary-top mb-4">
            <h4 class="summary-title m-0 fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Viết đánh giá</h4>
            <p class="text-secondary small mt-1">Hỗ trợ cộng đồng bằng cách chia sẻ trải nghiệm thực tế của bạn.</p>
        </div>

        <form asp-action="AddReview" asp-controller="ProductReviews" method="post" id="add-review-form" class="premium-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Productid" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <!-- RATING SELECTION -->
            <div class="rating-picker-premium mb-4 text-center">
                <span class="rating-label d-block small fw-bold text-secondary text-uppercase mb-3">Sản phẩm này tuyệt vời như thế nào?</span>
                <div class="star-rating-v2">
                    @for (int i = 5; i >= 1; i--)
                    {
                        <input type="radio" asp-for="Rating" value="@i" id="star-@i" class="rating-input-hide d-none" />
                        <label for="star-@i" class="rating-label-icon fs-2 cursor-pointer transition-smooth"><i class="bi bi-star-fill"></i></label>
                    }
                </div>
                <span asp-validation-for="Rating" class="text-danger small d-block mt-2"></span>
            </div>

            <!-- CONTENT AREA -->
            <div class="form-group mb-4">
                <label class="small fw-bold text-secondary text-uppercase mb-2">Cảm nhận chi tiết:</label>
                <textarea asp-for="Reviewcontent" 
                        class="form-control premium-textarea no-resize" 
                        placeholder="Chia sẻ kỷ niệm hoặc điểm yêu thích của bạn về ấn phẩm này..." 
                        rows="4" required></textarea>
                <span asp-validation-for="Reviewcontent" class="text-danger small"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn-premium-submit w-100 py-3 rounded-pill glass-hover-effect">
                    <i class="bi bi-send-check-fill me-2"></i>
                    <span>Gửi đánh giá ngay</span>
                </button>
            </div>
        </form>
    </div>
}