@model COMICZONE.Models.BlogComment

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết bình luận blog";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-7 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-5 align-self-center text-end">
            <ol class="breadcrumb justify-content-end mb-0 px-0 bg-transparent">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="BlogComments" asp-action="Index">Bình luận blog</a></li>
                <li class="breadcrumb-item active">Chi tiết</li>
            </ol>
        </div>
    </div>

    <div class="row">
        <!-- Comment Details -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="ti ti-message me-2"></i>Thông tin bình luận #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th class="text-muted" style="width: 150px;">ID</th>
                            <td class="fw-bold">#@Model.Id</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Bài viết</th>
                            <td>
                                <a asp-area="Admin" asp-controller="Blogs" asp-action="Details" asp-route-id="@Model.Blog?.Id" class="text-decoration-none fw-bold">
                                    @Model.Blog?.Title
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Người dùng</th>
                            <td>
                                <div class="fw-bold">@Model.User?.Username</div>
                                <div class="small text-muted">@Model.User?.Email</div>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Nội dung</th>
                            <td>@Model.Content</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Ngày tạo</th>
                            <td>@Model.Createdat.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Ngày cập nhật</th>
                            <td>@(Model.Updatedat?.ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Trạng thái</th>
                            <td>
                                @if (Model.Isdeleted == true)
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">Đã ẩn</span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">Hiển thị</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Lượt thích</th>
                            <td>
                                @{
                                    var likeCount = Model.BlogCommentLikes?.Count(l => l.Islike == true) ?? 0;
                                    var dislikeCount = Model.BlogCommentLikes?.Count(l => l.Islike == false) ?? 0;
                                }
                                <span class="badge bg-light text-dark"><i class="ti ti-thumb-up me-1"></i>@likeCount</span>
                                <span class="badge bg-light text-dark"><i class="ti ti-thumb-down me-1"></i>@dislikeCount</span>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="card-footer bg-white d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning">
                        <i class="ti ti-edit me-1"></i>Chỉnh sửa
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-danger">
                        <i class="ti ti-trash me-1"></i>Xóa vĩnh viễn
                    </a>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-auto">
                        <i class="ti ti-arrow-left me-1"></i>Quay lại
                    </a>
                </div>
            </div>
        </div>

        <!-- Replies List -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="ti ti-message-dots me-2"></i>Phản hồi (@(Model.BlogCommentReplies?.Count ?? 0))</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.BlogCommentReplies?.Any() == true)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var reply in Model.BlogCommentReplies.OrderByDescending(r => r.Createdat))
                            {
                                <div class="list-group-item @(reply.Isdeleted == true ? "bg-light opacity-75" : "")">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div>
                                            <span class="fw-bold">@reply.User?.Username</span>
                                            @if (reply.Replytouserid.HasValue)
                                            {
                                                <span class="text-info small ms-1">➔ @@reply.Replytouser?.Username</span>
                                            }
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (reply.Isdeleted == true)
                                            {
                                                <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 9px; padding: 2px 8px;">Ẩn</span>
                                            }
                                            <a asp-controller="BlogCommentReplies" asp-action="Details" asp-route-id="@reply.Replyid" 
                                               class="btn btn-xs btn-outline-info d-flex align-items-center justify-content-center" 
                                               style="width: 24px; height: 24px; padding: 0;" title="Xem chi tiết">
                                                <i class="ti ti-eye" style="font-size: 14px;"></i>
                                            </a>
                                        </div>
                                    </div>
                                    <p class="mb-1 small">@reply.Content</p>
                                    <small class="text-muted">@reply.Createdat?.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">Chưa có phản hồi</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
