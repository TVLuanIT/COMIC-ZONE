@model COMICZONE.Models.BlogCommentReply

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa phản hồi bình luận";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-7 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-5 align-self-center text-end">
            <ol class="breadcrumb justify-content-end mb-0 px-0 bg-transparent">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="BlogComments" asp-action="Index">Bình luận blog</a></li>
                <li class="breadcrumb-item active">Chỉnh sửa phản hồi</li>
            </ol>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0"><i class="ti ti-edit me-2"></i>Chỉnh sửa phản hồi #@Model.Replyid</h5>
                </div>
                <div class="card-body">
                    <!-- Info -->
                    <div class="bg-light rounded p-3 mb-4">
                        <div class="row">
                            <div class="col-md-4">
                                <small class="text-muted text-uppercase fw-bold">Bài viết</small>
                                <div class="fw-bold">@Model.Comment?.Blog?.Title</div>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted text-uppercase fw-bold">Bình luận gốc</small>
                                <div class="fw-bold">#@Model.Commentid</div>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted text-uppercase fw-bold">Người gửi</small>
                                <div class="fw-bold">@Model.User?.Username</div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Replyid" />
                        <input type="hidden" asp-for="Commentid" />
                        <input type="hidden" asp-for="Userid" />
                        <input type="hidden" asp-for="Createdat" />
                        <input type="hidden" asp-for="Replytouserid" />
                        <input type="hidden" asp-for="Parentreplyid" />

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-bold">Nội dung phản hồi</label>
                            <textarea asp-for="Content" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Trạng thái</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="Isdeleted" value="true" @(Model.Isdeleted == true ? "checked" : "") id="isDeletedSwitch">
                                <label class="form-check-label" for="isDeletedSwitch">
                                    <span class="text-danger fw-bold">Ẩn phản hồi</span>
                                </label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i>Lưu thay đổi
                            </button>
                            <a asp-area="Admin" asp-controller="BlogComments" asp-action="Index" asp-route-activeTab="Replies" class="btn btn-outline-secondary">
                                <i class="ti ti-arrow-left me-1"></i>Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
