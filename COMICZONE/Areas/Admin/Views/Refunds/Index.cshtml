@model IEnumerable<COMICZONE.Models.Refund>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý hoàn tiền";
    var searchModel = ViewBag.SearchModel as COMICZONE.Areas.Admin.ViewModels.RefundSearchModel ?? new COMICZONE.Areas.Admin.ViewModels.RefundSearchModel();
}

<div class="container-fluid">
    <!-- Breadcrumb & Title -->
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active">Hoàn tiền</li>
                </ol>
            </div>
        </div>
    </div>
    
    @* Reusable search form *@
    <partial name="_RefundSearchForm" model="searchModel" />

    <!-- Main Content Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
            <h5 class="card-title mb-0 fw-bold">
                <i class="ti ti-cash me-2"></i>Danh sách yêu cầu hoàn tiền
            </h5>
            <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="ti ti-plus me-1"></i>Thêm mới
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="align-middle">
                            <th class="ps-4">
                                @Html.SortHeader("Mã đơn gốc", "Payment.Orderid", searchModel.SortColumn ?? "CreatedAt", searchModel.IsAscending, searchModel.Keyword)
                            </th>
                            <th>
                                @Html.SortHeader("Số tiền", "Amount", searchModel.SortColumn ?? "CreatedAt", searchModel.IsAscending, searchModel.Keyword)
                            </th>
                            <th class="text-center">
                                @Html.SortHeader("Trạng thái", "Status", searchModel.SortColumn ?? "CreatedAt", searchModel.IsAscending, searchModel.Keyword)
                            </th>
                            <th class="text-center">
                                @Html.SortHeader("Hiển thị", "Isdeleted", searchModel.SortColumn ?? "CreatedAt", searchModel.IsAscending, searchModel.Keyword)
                            </th>
                            <th>Lý do</th>
                            <th class="text-center">
                                @Html.SortHeader("Ngày tạo", "CreatedAt", searchModel.SortColumn ?? "CreatedAt", searchModel.IsAscending, searchModel.Keyword)
                            </th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr id="row-@item.Id" class="@(item.Isdeleted ? "table-light text-muted" : "")">
                                <td class="ps-4">
                                    <span class="fw-bold text-primary">#@item.Payment?.Paymentid</span>
                                    <div class="small text-muted">ID: @item.Id</div>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@string.Format("{0:N0} VNĐ", item.Amount)</span>
                                </td>
                                <td>
                                    @{
                                        var statusEnum = item.RefundStatusEnum;
                                        var statusClass = statusEnum switch
                                        {
                                            COMICZONE.Models.Enums.RefundStatus.Success or 
                                            COMICZONE.Models.Enums.RefundStatus.Completed => "bg-success text-white",
                                            
                                            COMICZONE.Models.Enums.RefundStatus.Rejected => "bg-danger text-white",
                                            
                                            COMICZONE.Models.Enums.RefundStatus.Processing or 
                                            COMICZONE.Models.Enums.RefundStatus.Pending => "bg-warning text-dark",
                                            
                                            _ => "bg-light text-dark"
                                        };
                                        var statusText = statusEnum switch
                                        {
                                            COMICZONE.Models.Enums.RefundStatus.Success => "Thành công",
                                            COMICZONE.Models.Enums.RefundStatus.Completed => "Hoàn tất",
                                            COMICZONE.Models.Enums.RefundStatus.Rejected => "Thất bại",
                                            COMICZONE.Models.Enums.RefundStatus.Processing => "Đang xử lý",
                                            COMICZONE.Models.Enums.RefundStatus.Pending => "Chờ duyệt",
                                            _ => item.Status
                                        };
                                    }
                                    <span class="badge @statusClass px-3 py-2 rounded-pill fw-bold shadow-sm" style="min-width: 100px;">
                                        @statusText
                                    </span>
                                </td>
                                <td id="visibility-cell-@item.Id">
                                    @if (!item.Isdeleted)
                                    {
                                        <span class="badge bg-info text-white px-3 py-2 rounded-pill fw-bold shadow-sm">
                                            <i class="ti ti-eye me-1"></i> Hiển thị
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white px-3 py-2 rounded-pill fw-bold shadow-sm">
                                            <i class="ti ti-eye-off me-1"></i> Tạm ẩn
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 200px;" title="@item.Reason">
                                        @(string.IsNullOrEmpty(item.Reason) ? "Không có lý do" : item.Reason)
                                    </div>
                                </td>
                                <td class="text-muted small">
                                    @(item.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm rounded">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-sm border-end" title="Chi tiết">
                                            <i class="ti ti-eye fs-5 text-info"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm border-end" title="Chỉnh sửa">
                                            <i class="ti ti-edit fs-5 text-primary"></i>
                                        </a>
                                        <!-- Hard Delete (Permanent) -->
                                        <a asp-action="Delete" asp-route-id="@item.Id" 
                                           class="btn btn-light btn-sm text-danger"
                                           title="Xóa cứng (Vĩnh viễn)">
                                            <i class="ti ti-trash fs-5"></i>
                                        </a>

                                        <!-- Soft Delete (Toggle Visibility) -->
                                        <button type="button"
                                                class="btn btn-light btn-sm border-end ajax-toggle-refund-status"
                                                data-id="@item.Id"
                                                data-url="@Url.Action("ToggleDelete", "Refunds")"
                                                title="@(item.Isdeleted ? "Khôi phục" : "Xóa mềm (Tạm ẩn)")">
                                            <i class="ti @(item.Isdeleted ? "ti-refresh text-success" : "ti-eye-off text-warning") fs-5"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="ti ti-note-off fs-1 text-muted mb-2"></i>
                    <p class="text-muted">Chưa có dữ liệu hoàn tiền.</p>
                </div>
            }
        </div>
    </div>
    
    @if (Model.Any())
    {
        <div class="card-footer bg-white border-top-0 pb-4">
            <partial name="_AdminPagination" model="searchModel" />
        </div>
    }
</div>
