@model COMICZONE.Models.User

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa người dùng";
}

<div class="container-fluid mb-5">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Quản lý người dùng</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa vĩnh viễn</li>
                </ol>
            </nav>

            <h3 class="fw-bold text-danger m-0"><i class="ti ti-trash me-2"></i> Xóa vĩnh viễn người dùng</h3>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 shadow-sm rounded-pill">
            <i class="ti ti-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="row g-4">
        <!-- LEFT: USER PROFILE CARD -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="card-header bg-danger bg-opacity-10 border-0 py-3 text-center">
                    <span class="text-danger fw-bold"><i class="ti ti-user-circle me-1"></i> Thông tin tài khoản</span>
                </div>

                <div class="card-body p-4 text-center">
                    <div class="position-relative d-inline-block mb-3">
                        <img src="@Model.Avatar.AvatarOrDefault()" 
                             class="rounded-circle shadow-sm border border-4 border-white" 
                             width="150" height="150" 
                             style="object-fit:cover;" />

                        @if (Model.Isactive)
                        {
                            <span class="position-absolute bottom-0 end-0 bg-success border border-3 border-white rounded-circle p-2 shadow-sm" title="Đang hoạt động"></span>
                        }
                        else
                        {
                            <span class="position-absolute bottom-0 end-0 bg-danger border border-3 border-white rounded-circle p-2 shadow-sm" title="Bị khóa"></span>
                        }
                    </div>
                    
                    <h4 class="fw-bold mb-1">@Model.Username</h4>
                    <p class="text-muted small mb-3">@Model.Email</p>
                    
                    <div class="d-flex justify-content-center gap-2 mb-4">
                        <span class="badge rounded-pill px-3 py-2 fw-semibold
                            @(Model.UserRoleEnum == UserRole.Admin ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary")">
                            <i class="ti @(Model.UserRoleEnum == UserRole.Admin ? "ti-shield-lock" : "ti-user") me-1"></i>
                            @Model.UserRoleEnum.GetDisplayName()
                        </span>
                        
                        @if(Model.Isactive)
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 fw-semibold">
                                <i class="ti ti-check me-1"></i> Hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2 fw-semibold">
                                <i class="ti ti-lock me-1"></i> Bị khóa
                            </span>
                        }
                    </div>

                    <div class="text-start border-top pt-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">ID hệ thống:</span>
                            <span class="fw-bold small">#@Model.Id</span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Ngày tham gia:</span>
                            <span class="fw-bold small">@Model.Createdat.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: DEPENDENCIES AND ACTIONS -->
        <div class="col-lg-8">
            @{
                var relatedData = ViewBag.RelatedData as Dictionary<string, IEnumerable<string>>;
                bool hasRelatedData = relatedData != null && relatedData.Any();
            }

            @if (hasRelatedData)
            {
                <!-- WARNING BANNER -->
                <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 mb-4">
                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="ti ti-alert-triangle fs-1 text-warning"></i>
                        </div>

                        <div class="ms-3">
                            <h5 class="alert-heading fw-bold mb-1">Không thể xóa người dùng này!</h5>
                            <p class="mb-0">Hệ thống phát hiện tài khoản này đang có dữ liệu liên quan. Bạn cần xử lý hoặc di chuyển các dữ liệu này trước khi có thể thực hiện xóa hoàn toàn.</p>
                        </div>
                    </div>
                </div>

                <!-- STATS GRID -->
                <div class="row g-3 mb-4">
                    @foreach (var entry in relatedData)
                    {
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm rounded-3 h-100 transition-hover">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0 p-2 bg-light rounded-3 text-primary">
                                            @{
                                                string iconClass = entry.Key switch
                                                {
                                                    "Notifications nhận" => "ti-bell",
                                                    "Notifications tạo bởi" => "ti-edit",
                                                    "Orders" => "ti-shopping-cart",
                                                    "Carts" => "ti-basket",
                                                    "Blogs" => "ti-news",
                                                    "Blog Comments" => "ti-message-dots",
                                                    "Product Reviews" => "ti-star",
                                                    "Violation Reports" => "ti-alert-triangle",
                                                    "Replies đã gửi" => "ti-message-share",
                                                    "Replies đã nhận" => "ti-message-forward",
                                                    "Review Likes" => "ti-thumb-up",
                                                    "Reply Likes" => "ti-heart",
                                                    _ => "ti-link"
                                                };
                                            }

                                            <i class="ti @iconClass fs-4"></i>
                                        </div>

                                        <div class="ms-3 overflow-hidden">
                                            <div class="text-muted small text-truncate">@entry.Key</div>
                                            <div class="fw-bold fs-5">@entry.Value.Count()</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- DETAILED LIST -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="m-0 fw-bold"><i class="ti ti-list-details me-1"></i> Chi tiết dữ liệu liên quan</h6>
                    </div>

                    <div class="card-body p-0">
                        <div class="accordion accordion-flush" id="relatedDataAccordion">
                            @foreach (var entry in relatedData)
                            {
                                var collapseId = "collapse-" + Guid.NewGuid().ToString("N");
                                
                                <div class="accordion-item border-bottom">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed py-3" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                            <span class="fw-semibold">@entry.Key</span>
                                            <span class="badge bg-light text-dark ms-2">@entry.Value.Count()</span>
                                        </button>
                                    </h2>

                                    <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#relatedDataAccordion">
                                        <div class="accordion-body bg-light p-0">
                                            <ul class="list-group list-group-flush shadow-none">
                                                @foreach (var detail in entry.Value.Take(5))
                                                {
                                                    <li class="list-group-item bg-transparent border-0 py-2 ps-4">
                                                        <i class="ti ti-point text-primary me-2"></i> @detail
                                                    </li>
                                                }

                                                @if (entry.Value.Count() > 5)
                                                {
                                                    <li class="list-group-item bg-transparent border-0 py-2 ps-4 small text-muted italic">
                                                        ... và @(entry.Value.Count() - 5) mục khác
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- DANGER ZONE: CASCADE DELETE -->
                <div class="card border-danger border-opacity-25 shadow-sm rounded-4 overflow-hidden mb-4 bg-danger bg-opacity-10 animate__animated animate__shakeX">
                    <div class="card-header bg-danger text-white py-3">
                        <h6 class="m-0 fw-bold"><i class="ti ti-skull me-1"></i> Vùng nguy hiểm: Xóa rác (Cascade Delete)</h6>
                    </div>
                    <div class="card-body p-4 text-center">
                        <p class="text-danger fw-bold mb-3">
                            <i class="ti ti-alert-triangle me-1"></i> Hành động này sẽ xóa vĩnh viễn người dùng cùng TOÀN BỘ dữ liệu liên quan (Đơn hàng, Thanh toán, Bài viết...).
                        </p>
                        
                        <form asp-action="ForceDelete" method="post" id="forceDeleteForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            
                            <div class="form-check d-inline-block text-start mb-4 p-3 border rounded bg-white shadow-sm">
                                <input class="form-check-input ms-0" type="checkbox" name="confirmRisk" id="confirmRiskCheck" value="true">
                                <label class="form-check-label ms-2 text-dark small fw-semibold" for="confirmRiskCheck" style="cursor:pointer;">
                                    Tôi xác nhận việc xóa này sẽ gây mất dữ liệu vĩnh viễn và không thể khôi phục.
                                </label>
                            </div>

                            <div>
                                <button type="submit" id="forceDeleteBtn" class="btn btn-danger px-5 rounded-pill fw-bold shadow" disabled>
                                    <i class="ti ti-trash-x me-1"></i> Thực hiện Xóa cưỡng bức
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                @section Scripts {
                    <script>
                        document.getElementById('confirmRiskCheck').addEventListener('change', function() {
                            document.getElementById('forceDeleteBtn').disabled = !this.checked;
                        });
                    </script>
                }
            }
            else
            {
                <!-- NO DEPENDENCIES: FINAL CONFIRMATION -->
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center h-100 d-flex flex-column justify-content-center">
                    <div class="mb-4">
                        <div class="d-inline-flex p-4 bg-danger bg-opacity-10 rounded-circle text-danger mb-3">
                            <i class="ti ti-trash-x fs-1"></i>
                        </div>

                        <h3 class="fw-bold">Xác nhận xóa tài khoản</h3>
                        
                        <p class="text-muted px-lg-5">
                            Người dùng này không còn dữ liệu liên quan. Hành động này sẽ xóa vĩnh viễn tài khoản <strong>@Model.Username</strong> khỏi hệ thống. Thao tác này không thể hoàn tác.
                        </p>
                    </div>

                    <form asp-action="Delete" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-light border px-4 rounded-pill fw-semibold shadow-sm">
                                <i class="ti ti-x me-1"></i> Hủy bỏ
                            </a>

                            <button type="submit" class="btn btn-danger px-5 rounded-pill fw-bold shadow">
                                <i class="ti ti-check me-1"></i> Đồng ý xóa vĩnh viễn
                            </button>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>
</div>