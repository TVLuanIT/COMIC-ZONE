@model List<COMICZONE.Models.ProductReviewReply>

@Html.AntiForgeryToken()

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-reply-all text-muted display-1 mb-4"></i>
        <p class="text-muted fs-5">Bạn chưa có phản hồi nào.</p>
    </div>
}
else
{
    <div class="replies-list">
        @foreach (var reply in Model)
        {
            <div class="profile-review-card" data-aos="fade-up">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <a asp-controller="Products" asp-action="Detail" asp-route-id="@(reply.Review?.Productid ?? 0)" 
                           class="fw-800 text-dark text-decoration-none hover-primary fs-6 d-block mb-1">
                            <span class="text-muted small fw-normal">Phản hồi trên truyện:</span><br>
                            @(reply.Review?.Product?.Name ?? "Sản phẩm")
                        </a>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="text-muted small me-3">
                            <i class="bi bi-calendar3 me-1"></i> @reply.Createdat?.ToString("dd/MM/yyyy")
                        </span>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light rounded-circle" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                <li>
                                    <a href="javascript:void(0)" class="dropdown-item text-danger delete-reply" data-id="@reply.Replyid">
                                        <i class="bi bi-trash3 me-2"></i>Xóa phản hồi
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="bg-indigo-light p-3 rounded-4 position-relative" style="background: rgba(99, 102, 241, 0.05);">
                    <i class="bi bi-chat-quote position-absolute top-0 start-0 translate-middle-y ms-3 text-indigo opacity-25 fs-1"></i>
                    <p class="mb-0 text-secondary" style="line-height: 1.6;">@reply.Replycontent</p>
                </div>
            </div>
        }

        <!-- Pagination -->
        @await Html.PartialAsync("_Pagination", new PaginationModel
        {
            CurrentPage = ViewBag.ReplyPage,
            TotalPages = ViewBag.ReplyTotalPages,
            Action = "MyReviews",
            Controller = "UserProfiles",
            PageParam = "replyPage",
            ExtraParams = new Dictionary<string, string>
            {
                { "reviewPage", Convert.ToString(ViewBag.ReviewPage ?? 1) },
                { "tab", "replies" }
            }
        })
    </div>
}