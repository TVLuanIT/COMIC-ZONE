@using COMICZONE.Models.Enums
@model COMICZONE.Models.MarketplacePost

@{
    ViewData["Title"] = "Đăng bán sản phẩm";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nice-select2@2.1.0/dist/css/nice-select2.css">
    <link rel="stylesheet" href="~/marketplace/css/marketplace.css" asp-append-version="true">
}

<div class="marketplace-area">
    <!-- Mesh Background -->
    <div class="mesh-bg"></div>

    <div class="container pt-5 pb-5">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <!-- Header -->
                <div class="text-center mb-5" data-aos="fade-down">
                    <h1 class="fw-900 letter-spacing-tight mb-2 h1" style="font-size: 3.5rem;">
                        Đăng bán <span class="text-gradient">Sản phẩm</span>
                    </h1>
                    <p class="text-muted fs-5">Chia sẻ món đồ của bạn với cộng đồng yêu truyện tranh</p>
                </div>

                <div class="mp-card border-0 shadow-lg" data-aos="fade-up" data-aos-delay="100">
                    <div class="mp-card-body p-4 p-md-5">
                        <form asp-action="Create" enctype="multipart/form-data">
                            <div class="row g-4">
                                <!-- Title -->
                                <div class="col-12">
                                    <label asp-for="Title" class="form-label fw-800 text-uppercase small text-primary letter-spacing-1">Tiêu đề sản phẩm</label>
                                    <input asp-for="Title" class="form-control mp-form-control" placeholder="Ví dụ: Bộ Dragon Ball 1-42 bản 2014..." required />
                                </div>

                                <!-- Price & Condition -->
                                <div class="col-md-6">
                                    <label asp-for="Price" class="form-label fw-800 text-uppercase small text-primary letter-spacing-1">Giá bán (VNĐ)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-0 px-3 fw-bold">₫</span>
                                        <input asp-for="Price" type="number" class="form-control mp-form-control" placeholder="0" required />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ConditionEnum" class="form-label fw-800 text-uppercase small text-primary letter-spacing-1">Tình trạng phẩm</label>
                                    <select asp-for="ConditionEnum" class="form-select mp-form-control" asp-items="Html.GetEnumSelectList<MarketplacePostCondition>()">
                                    </select>
                                </div>

                                <!-- Category -->
                                <div class="col-12">
                                    <label asp-for="CategoryEnum" class="form-label fw-800 text-uppercase small text-primary letter-spacing-1">Danh mục</label>
                                    <select asp-for="CategoryEnum" class="form-select mp-form-control" asp-items="Html.GetEnumSelectList<MarketplacePostCategory>()">
                                        <option value="" disabled selected>-- Chọn danh mục sản phẩm --</option>
                                    </select>
                                </div>

                                <!-- Description -->
                                <div class="col-12">
                                    <label asp-for="Description" class="form-label fw-800 text-uppercase small text-primary letter-spacing-1">Mô tả chi tiết</label>
                                    <textarea asp-for="Description" class="form-control mp-form-control" rows="6" placeholder="Mô tả kỹ tình trạng: gáy sách, giấy, phụ kiện kèm theo, lỗi (nếu có)..."></textarea>
                                </div>

                                <!-- Images -->
                                <div class="col-12">
                                    <label class="form-label fw-800 text-uppercase small text-primary letter-spacing-1">Hình ảnh minh họa</label>
                                    <div class="mp-upload-zone p-5 border-2 border-dashed rounded-4 text-center bg-light bg-opacity-50 transition-smooth" style="border-color: var(--mp-border) !important;" id="dropZone">
                                        <i class="bi bi-cloud-arrow-up display-3 text-primary mb-3"></i>
                                        <h4 class="fw-800 text-dark mb-1">Chọn hoặc kéo thả ảnh</h4>
                                        <p class="text-secondary small mb-4">Hỗ trợ JPG, PNG (Tối đa 5 ảnh)</p>
                                        <input type="file" name="uploadedImages" id="imageInput" class="form-control d-none" multiple accept="image/*" required />
                                        <button type="button" class="btn btn-white rounded-pill px-5 py-3 fw-800 shadow-sm border" onclick="document.getElementById('imageInput').click()">Tìm kiếm ảnh</button>
                                    </div>
                                    <div class="invalid-feedback d-block">
                                        @Html.ValidationMessage("uploadedImages")
                                    </div>
                                    <div id="imagePreviewContainer" class="d-flex flex-wrap gap-4 mt-4 justify-content-center"></div>
                                </div>
                                
                                <div class="col-12 mt-5">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-4 p-4 bg-white rounded-4 border shadow-sm" style="border-radius: 32px !important;">
                                        <a asp-action="Index" class="btn btn-link text-secondary fw-800 text-decoration-none px-4">
                                            <i class="bi bi-arrow-left me-2"></i>Quay lại
                                        </a>
                                        <button type="submit" class="btn-premium-grad py-3 px-5 shadow-lg">
                                            <i class="bi bi-send-check-fill me-2"></i>Đăng bài ngay
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/nice-select2@2.1.0/dist/js/nice-select2.js"></script>
    <script src="~/marketplace/js/marketplace.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Marketplace.initCreate();
        });
    </script>
}
