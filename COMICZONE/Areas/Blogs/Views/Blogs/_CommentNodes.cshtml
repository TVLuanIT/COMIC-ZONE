@model IEnumerable<COMICZONE.Models.BlogComment>
@using COMICZONE.Models.Enums
@using Microsoft.AspNetCore.Http
@using COMICZONE.Extensions

@{
    var currentUserIdStr = Context.Session.GetString("UserId");
    int? currentUserId = !string.IsNullOrEmpty(currentUserIdStr) ? int.Parse(currentUserIdStr) : null;
}

@foreach (var comment in Model)
{
    var likes = comment.BlogCommentLikes.Count(l => l.Islike == true);
    var dislikes = comment.BlogCommentLikes.Count(l => l.Islike == false);
    var userReaction = currentUserId.HasValue ? comment.BlogCommentLikes.FirstOrDefault(l => l.Userid == currentUserId.Value)?.Islike : null;

    <div class="comment-node mb-4" id="comment-@comment.Id">
        <div class="d-flex gap-3">
            <img src="@(comment.User?.Avatar.AvatarOrDefault())" class="comment-avatar">
            <div class="comment-body w-100">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <h6 class="mb-0 fw-bold">@(comment.User?.Username ?? "Ẩn danh")</h6>
                        <span class="x-small text-muted">@comment.Createdat.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="dropdown comment-dropdown">
                        <button class="btn btn-link dropdown-toggle comment-dropdown-toggle p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-display="static">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end comment-dropdown-menu">
                            @if (comment.Userid == currentUserId)
                            {
                                <li><a class="dropdown-item btn-edit-comment" href="javascript:void(0)" data-comment-id="@comment.Id"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa</a></li>
                                <li><a class="dropdown-item text-danger btn-delete-comment" href="javascript:void(0)" data-comment-id="@comment.Id"><i class="bi bi-trash3-fill me-2"></i>Xóa</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item btn-report-comment" href="javascript:void(0)" data-comment-id="@comment.Id"><i class="bi bi-flag-fill me-2"></i>Báo cáo</a></li>
                            }
                        </ul>
                    </div>
                </div>
                <p class="text-secondary mb-2 comment-content-text">@comment.Content</p>

                <div class="comment-actions d-flex gap-3 align-items-center">
                    <button class="btn-like @(userReaction == true ? "active" : "") d-flex align-items-center gap-1"
                            data-comment-id="@comment.Id" data-is-like="true">
                        <i class="bi @(userReaction == true ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-up")"></i>
                        <span class="like-count count">@likes</span>
                    </button>

                    <button class="btn-dislike @(userReaction == false ? "active" : "") d-flex align-items-center gap-1"
                            data-comment-id="@comment.Id" data-is-like="false">
                        <i class="bi @(userReaction == false ? "bi-hand-thumbs-down-fill" : "bi-hand-thumbs-down")"></i>
                    </button>

                    <button class="btn-toggle-reply d-flex align-items-center gap-1"
                            data-comment-id="@comment.Id"
                            data-form-id="reply-form-c-@comment.Id"
                            data-reply-to-user="@(comment.User?.Username ?? "Ẩn danh")">
                        <i class="bi bi-reply-fill"></i>
                        <span>Phản hồi</span>
                    </button>
                </div>

                <!-- Reply Form (Hidden) -->
                <div class="reply-form-container mt-3 d-none" id="reply-form-c-@comment.Id">
                    <div class="d-flex gap-2 align-items-center">
                        <textarea class="form-control-premium x-small reply-content w-100" rows="2" placeholder="Viết phản hồi..."></textarea>
                        <button class="btn btn-primary btn-sm rounded-pill px-3 btn-submit-reply"
                                data-comment-id="@comment.Id"
                                data-form-id="reply-form-c-@comment.Id">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </div>

                @{
                    var activeReplies = comment.BlogCommentReplies.Where(r => r.Isdeleted != true).OrderBy(r => r.Createdat).ToList();
                }
                <!-- Replies List -->
                <div class="replies-list mt-3 ms-2 ps-3 border-start d-none" id="replies-list-@comment.Id">
                    @foreach (var reply in activeReplies)
                    {
                        var rLikes = reply.BlogCommentReplyLikes.Count(l => l.Islike == true);
                        var rUserReaction = currentUserId.HasValue ? reply.BlogCommentReplyLikes.FirstOrDefault(l => l.Userid == currentUserId.Value)?.Islike : null;

                        <div class="reply-node mb-3 d-none" id="reply-@reply.Replyid">
                            <div class="d-flex gap-2">
                                <img src="@(reply.User?.Avatar.AvatarOrDefault())" class="reply-avatar">
                                <div class="reply-body w-100">
                                    <div class="d-flex justify-content-between align-items-start mb-0">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <h6 class="text-sm fw-bold mb-0">
                                                @(reply.User?.Username ?? "Ẩn danh")
                                                @if (reply.Replytouser != null)
                                                {
                                                    <span class="fw-normal text-muted ms-1"><i class="bi bi-caret-right-fill x-small"></i> @reply.Replytouser.Username</span>
                                                }
                                            </h6>
                                            <span class="xx-small text-muted">@reply.Createdat?.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                        <div class="dropdown reply-dropdown">
                                            <button class="btn btn-link dropdown-toggle comment-dropdown-toggle p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-display="static">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end comment-dropdown-menu">
                                                @if (reply.Userid == currentUserId)
                                                {
                                                    <li><a class="dropdown-item btn-edit-reply" href="javascript:void(0)" data-reply-id="@reply.Replyid"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa</a></li>
                                                    <li><a class="dropdown-item text-danger btn-delete-reply" href="javascript:void(0)" data-reply-id="@reply.Replyid"><i class="bi bi-trash3-fill me-2"></i>Xóa</a></li>
                                                }
                                                else
                                                {
                                                    <li><a class="dropdown-item btn-report-reply" href="javascript:void(0)" data-reply-id="@reply.Replyid"><i class="bi bi-flag-fill me-2"></i>Báo cáo</a></li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                    <p class="small text-secondary mb-1 reply-content-text">@reply.Content</p>

                                    <div class="reply-actions d-flex gap-2 align-items-center">
                                        <button class="btn-reply-like @(rUserReaction == true ? "active" : "") xx-small"
                                                data-reply-id="@reply.Replyid" data-is-like="true">
                                            <i class="bi @(rUserReaction == true ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-up")"></i>
                                            <span class="count">@rLikes</span>
                                        </button>
                                        <button class="btn-reply-dislike @(rUserReaction == false ? "active" : "") xx-small"
                                                data-reply-id="@reply.Replyid" data-is-like="false">
                                            <i class="bi @(rUserReaction == false ? "bi-hand-thumbs-down-fill" : "bi-hand-thumbs-down")"></i>
                                        </button>
                                        <button class="btn-toggle-reply xx-small border-0 bg-transparent text-primary fw-medium"
                                                data-comment-id="@comment.Id"
                                                data-parent-reply-id="@reply.Replyid"
                                                data-reply-to-user="@(reply.User?.Username ?? "Ẩn danh")"
                                                data-form-id="reply-form-r-@reply.Replyid">
                                            Phản hồi
                                        </button>
                                    </div>

                                    <!-- Nested Reply Form (Hidden) -->
                                    <div class="reply-form-container mt-2 d-none" id="reply-form-r-@reply.Replyid">
                                        <div class="d-flex gap-2 align-items-center ps-3 border-start">
                                            <textarea class="form-control-premium xx-small reply-content w-100" rows="1" placeholder="Viết phản hồi..."></textarea>
                                            <button class="btn btn-primary btn-sm rounded-pill px-2 btn-submit-reply"
                                                    data-comment-id="@comment.Id"
                                                    data-parent-reply-id="@reply.Replyid"
                                                    data-form-id="reply-form-r-@reply.Replyid">
                                                <i class="bi bi-send-fill x-small"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (activeReplies.Any())
                {
                    <div class="replies-control mt-2" id="replies-control-@comment.Id">
                        <button class="btn-view-replies btn btn-link btn-sm p-0 text-decoration-none fw-bold small"
                                data-comment-id="@comment.Id"
                                data-total="@activeReplies.Count"
                                data-current="0">
                            <i class="bi bi-chat-dots-fill me-1"></i>
                            @activeReplies.Count phản hồi
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}
