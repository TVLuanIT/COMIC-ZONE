@model COMICZONE.Models.Refund

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa hoàn tiền";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">@ViewData["Title"]</h4>
        </div>
        <div class="col-md-7 align-self-center text-end">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb justify-content-end mb-0">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Hoàn tiền</a></li>
                    <li class="breadcrumb-item active">Chỉnh sửa</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="ti ti-edit me-2 text-primary"></i>Cập nhật thông tin hoàn tiền #@Model.Id
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="PaymentId" class="form-label fw-bold">Thanh toán</label>
                                <select asp-for="PaymentId" class="form-select select2" asp-items="ViewBag.PaymentId"></select>
                                <span asp-validation-for="PaymentId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Amount" class="form-label fw-bold">Số tiền hoàn</label>
                                <div class="input-group">
                                    <input asp-for="Amount" class="form-control" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-bold">Trạng thái</label>
                                <select name="Status" id="refundStatus" class="form-select no-select2">
                                    <option value="PENDING" selected="@(Model.Status == "PENDING" ? "selected" : null)">Chờ duyệt (PENDING)</option>
                                    <option value="PROCESSING" selected="@(Model.Status == "PROCESSING" ? "selected" : null)">Đang xử lý (PROCESSING)</option>
                                    <option value="SUCCESS" selected="@(Model.Status == "SUCCESS" ? "selected" : null)">Thành công (SUCCESS)</option>
                                    <option value="FAILED" selected="@(Model.Status == "FAILED" ? "selected" : null)">Thất bại (FAILED)</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CreatedAt" class="form-label fw-bold">Ngày tạo</label>
                                <input asp-for="CreatedAt" class="form-control" type="datetime-local" value="@(Model.CreatedAt?.ToString("yyyy-MM-ddTHH:mm"))" />
                                <span asp-validation-for="CreatedAt" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Reason" class="form-label fw-bold">Lý do hoàn tiền</label>
                            <textarea asp-for="Reason" class="form-control" rows="4">@Model.Reason</textarea>
                            <span asp-validation-for="Reason" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-4">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">
                                <i class="ti ti-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="ti ti-device-floppy me-1"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if (typeof $.fn.select2 === 'function') {
                // Thanh toán dropdown - có tìm kiếm
                $('.select2').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: 'Chọn mã thanh toán'
                });

                // Trạng thái - không có ô tìm kiếm
                $('#refundStatus').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    minimumResultsForSearch: Infinity
                });
            }
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
