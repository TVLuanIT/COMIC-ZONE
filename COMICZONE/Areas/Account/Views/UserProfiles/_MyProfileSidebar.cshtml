@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var avatar = Context.Session.GetString("Avatar");
    var username = Context.Session.GetString("Username");
    
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    if (string.IsNullOrEmpty(returnUrl))
    {
        returnUrl = ViewData["ReturnUrl"]?.ToString();
    }

    var firstChar = !string.IsNullOrEmpty(username)
        ? username.Substring(0, 1).ToUpper()
        : "U";
}

<div class="profile-glass-sidebar" data-aos="fade-right">

    <!-- USER INFO CARD -->
    <div class="user-card-premium">
        <div class="avatar-wrapper-premium" onclick="openAvatarUpload()" title="Thay đổi ảnh đại diện">
            <input type="file"
                   id="avatarUpload"
                   accept="image/*"
                   hidden
                   onchange="uploadAvatar(this)" />

            @if (!string.IsNullOrEmpty(avatar))
            {
                <img src="@avatar" alt="@username" class="avatar-img" />
            }
            else
            {
                <div class="default-avatar-premium">
                    @firstChar
                </div>
            }
            <div class="avatar-badge-premium">
                <i class="bi bi-camera-fill"></i>
            </div>
        </div>

        <h3 class="profile-username-premium">@username</h3>
        <p class="text-secondary small mt-1">Thành viên mạn bạc</p>
    </div>

    <!-- SIDEBAR MENU -->
    <ul class="sidebar-menu-premium">
        <li>
            <a asp-area="Account" asp-controller="UserProfiles" asp-action="MyProfile" 
               asp-route-returnUrl="@returnUrl"
               class="sidebar-menu-link @(action == "MyProfile" ? "active" : "")">
                <i class="bi bi-person-vcard"></i>
                <span>Thông tin cá nhân</span>
            </a>
        </li>
        <li>
            <a asp-area="Account" asp-controller="UserProfiles" asp-action="MyOrders" 
               asp-route-returnUrl="@returnUrl"
               class="sidebar-menu-link @(action == "MyOrders" ? "active" : "")">
                <i class="bi bi-bag-check"></i>
                <span>Đơn hàng của tôi</span>
                @await Component.InvokeAsync("UnreadOrderCount")
            </a>
        </li>
        <li>
            <a asp-area="Account" asp-controller="UserProfiles" asp-action="MyReviews" 
               asp-route-returnUrl="@returnUrl"
               class="sidebar-menu-link @(action == "MyReviews" ? "active" : "")">
                <i class="bi bi-chat-heart"></i>
                <span>Đánh giá của tôi</span>
            </a>
        </li>
        <li>
            <a asp-area="" asp-controller="Products" asp-action="ViewedHistory" 
               asp-route-returnUrl="@returnUrl"
               class="sidebar-menu-link @(action == "ViewedHistory" ? "active" : "")">
                <i class="bi bi-clock-history"></i>
                <span>Lịch sử xem</span>
            </a>
        </li>
        <li>
            <a asp-area="Account" asp-controller="UserProfiles" asp-action="MyBlogs" 
               asp-route-returnUrl="@returnUrl"
               class="sidebar-menu-link @(action == "MyBlogs" ? "active" : "")">
                <i class="bi bi-journal-text"></i>
                <span>Bài viết của tôi</span>
            </a>
        </li>
        <li>
            <a asp-area="Account" asp-controller="UserProfiles" asp-action="Notifications" 
               asp-route-returnUrl="@returnUrl"
               class="sidebar-menu-link @(action == "Notifications" ? "active" : "")">
                <i class="bi bi-bell"></i>
                <span>Thông báo</span>
                @await Component.InvokeAsync("UnreadNotificationCount")
            </a>
        </li>
        <li>
            <a asp-area="Account" asp-controller="UserProfiles" asp-action="Settings" 
               asp-route-returnUrl="@returnUrl"
               class="sidebar-menu-link @(action == "Settings" ? "active" : "")">
                <i class="bi bi-gear"></i>
                <span>Cài đặt</span>
            </a>
        </li>
    </ul>

</div>