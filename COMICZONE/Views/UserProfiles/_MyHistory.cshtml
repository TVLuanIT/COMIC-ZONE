@using COMICZONE.Extensions;
@using System.Globalization;
@model IEnumerable<COMICZONE.Models.Product>

@{
    ViewBag.Title = "Truyện đã xem gần đây";
}

<section class="py-5">
    <div class="container">
        <div class="d-flex align-items-center mb-4 border-bottom pb-3">
            <h2 class="fw-bold mb-0 me-3">Lịch sử xem truyện của bạn</h2>

            <span class="badge bg-secondary">Truyện từng click</span>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-4">
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 product-card">
                            <a asp-controller="Products" asp-action="Detail" asp-route-id="@item.Id" class="product-img overflow-hidden position-relative" style="height: 250px; display: block; border-radius: 5px;">
                                <img src="@item.GetImagePath()" class="card-img-top w-100 h-100" style="object-fit: cover; transition: transform 0.3s;" alt="@item.Name" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
                            </a>

                            <div class="card-body p-2 d-flex flex-column">
                                <a asp-controller="Products" asp-action="Detail" asp-route-id="@item.Id" class="text-decoration-none text-dark fw-bold mb-1" style="font-size: 0.9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @item.Name
                                </a>
                            
                                <p class="card-text text-danger fw-bold mt-auto mb-0" style="font-size: 0.85rem;">
                                    @string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0}", item.Price) ₫
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- THÊM PAGINATION Ở ĐÂY -->
            <div class="d-flex justify-content-center mt-4">
                @await Html.PartialAsync("_Pagination", (PaginationModel)ViewBag.Pagination)
            </div>
        }
    </div>
</section>
